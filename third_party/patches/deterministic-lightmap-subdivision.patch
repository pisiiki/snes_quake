+                if (allowed_width < 2 || widths[axis] <= allowed_width) {
+                    continue;
+                }
+                const double ratio =
+                    static_cast<double>(widths[axis]) / allowed_width;
+                if (ratio > worst_ratio) {
+                    worst_ratio = ratio;
+                    split_axis = axis;
+                    split_width = allowed_width;
+                }
