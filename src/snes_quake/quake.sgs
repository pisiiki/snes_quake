; SuperFX flat-span renderer for the E1M3 BSP scene.

.include "libSFX.i"
.include "GSU_Cache.i"
.include "GSU_Primitives.i"
.include "MemoryMap.i"
.ifdef E1M1_FLY_LARGE_PACKET
PLAYABLE_RECTANGULAR_POT_SAMPLER = 1
PLAYABLE_SIGNED_LIGHTMAP_INTERPOLATION = 1
PLAYABLE_LIGHTMAP_ZERO_T = 1
.endif
.include "quake/Viewport.i"
.include "Data/Fly3x/WorldLightmapProof.i"
.include "Data/QuakeBSPWeaponSpritesMask.i"

; Prefer the GSU's shorter equivalent encoding whenever a direct word access
; resolves to an even low-RAM address. Forward or high addresses retain LM/SM.
.macro QuakeLoadWord reg, address
  .if .const(.loword(address))
    .if (.loword(address) <= $01FE) && ((.loword(address) & 1) = 0)
        mlms    reg, address
        .exitmacro
    .endif
  .endif
        mlm     reg, address
.endmacro

.macro QuakeStoreWord address, reg
  .if .const(.loword(address))
    .if (.loword(address) <= $01FE) && ((.loword(address) & 1) = 0)
        msms    address, reg
        .exitmacro
    .endif
  .endif
        msm     address, reg
.endmacro

.undefine lm
.undefine sm
.define lm QuakeLoadWord
.define sm QuakeStoreWord

.macro TEXTURE_DIVIDE_UNSIGNED_STEP
        .local Next
        with    R0
        add     R0
        from    R3
        to      R3
        rol
        with    R2
        add     R2
        to      R4
        from    R3
        sub     R1
        bcc     Next
        nop
        move    R3, R4
        inc     R2
Next:
.endmacro

.macro QuakeNextQ12Bank select_bank, packed_tail
        with    R1
        sub     R4
  .ifdef PLAYABLE_COMPACT_Q12_RECIPROCALS
        GSU_ABSOLUTE_GOTO packed_tail
  .else
        inc     R0
        bra     select_bank
        nop
  .endif
.endmacro

.macro QuakeDecodeWorldLightmap unpack
        lm      R4, (LIGHTMAP_ROM_ADDRESS)
        GSU_SET_ROM_BUFFER_ADDRESS R4
        lm      R0, (LIGHTMAP_WIDTH)
        lm      R6, (LIGHTMAP_HEIGHT)
        with    R0
        umult   R6
        move    R12, R0
        iwt     R10, #GSU_LIGHTMAP_CACHE_OFFSET
        sm      (LIGHTMAP_ROM_ADDRESS), R10
        jal     unpack
        nop
.endmacro

.macro QuakeRouteWorldLightmap missing, resident
  .ifdef PLAYABLE_RESIDENT_WORLD_LIGHTMAPS
        ; A negative bank is resident. $FF is still the missing sentinel.
        inc     R7
        beq     missing
        dec     R7
        bpl     :+
        nop
        GSU_ABSOLUTE_GOTO resident
:
  .else
        move    R0, R7
        inc     R0
        bne     :+
        nop
        GSU_ABSOLUTE_GOTO missing
:
  .endif
.endmacro

.if .defined(QUAKE_MSU_WORLD_KEEP) || .defined(PLAYABLE_LAZY_WORLD_LIGHTMAP)
QUAKE_CACHED_LIGHTMAP_BLOCK8 = 1
.endif

.ifdef PLAYABLE_LAZY_WORLD_LIGHTMAP
  .if BSP_RENDER_SCALE = 2
    .assert .defined(PLAYABLE_EMPTY_COMPOSED), error, "Deferred world lightmaps require an empty composed cache"
    .assert !.defined(QUAKE_MSU_CACHE), error, "Deferred world lightmap code must run from GSU AUX RAM"
  .endif
.endif

.macro TexturePrepareWorldLightmap
  .if (!.defined(PLAYABLE_LAZY_WORLD_LIGHTMAP)) || (BSP_RENDER_SCALE <> 2)
        jal     TextureLoadFaceLightmap
  .endif
.endmacro

.macro TextureWorldLightmapDispatchPadding
  .if .defined(PLAYABLE_LAZY_WORLD_LIGHTMAP) && (BSP_RENDER_SCALE = 2)
        ; Keep the pinned T4 patch boundaries without executing the filler.
        .res 5, $01
  .endif
.endmacro

