; Exact current-projection alias visibility from world and brush polygons.
; Fly and unsupported projection/state rows use this mask. One bit per
; screen pixel is reused only while its recorded occluders stay in front.

FLY_VIS_VISIBILITY_RETURN = CLIP_V0_RIGHT
FLY_VIS_RASTER_RETURN     = CLIP_V0_UP
FLY_VIS_SAVED_R2          = CLIP_V1_UP
FLY_VIS_SAVED_R3          = CLIP_V1_DEPTH
FLY_VIS_SAVED_R4          = CLIP_V2_RIGHT
FLY_VIS_SAVED_R5          = CLIP_V2_UP
FLY_VIS_SAVED_R6          = CLIP_V2_DEPTH
FLY_VIS_SAVED_R7          = CLIP_A_RIGHT
FLY_VIS_SAVED_R9          = CLIP_A_UP
FLY_VIS_SAVED_R12         = CLIP_A_DEPTH
FLY_VIS_SAVED_R13         = CLIP_B_RIGHT
FLY_VIS_RESULT            = CLIP_RATIO

; FX3 signed branches are $06=BGE and $07=BLT. libSFX reverses their
; mnemonic encodings, so emit the documented instruction bytes explicitly.
.macro FLY_SIGNED_BRANCH opcode, target
        .byte opcode
        .assert target - (* + 1) >= -128 && target - (* + 1) <= 127, error, "Fly signed branch exceeds its displacement"
        .byte <(target - (* + 1))
.endmacro

.segment "GSU_ALIAS_FLY_CODE"

; Called from the alias pixel loop after a non-transparent texel is decoded.
; Preserve every register retained by that loop, restore the sprite ROM bank,
; and return nonzero only when the current pixel has no opaque occluder.
FlyAliasTestVisibility:
        sm      (FLY_VIS_SAVED_R2), R2
        sm      (FLY_VIS_SAVED_R3), R3
        lm      R0, (BRUSH_CURRENT_TOKEN)
        lm      R1, (FLY_MASK_TOKEN)
        with    R0
        cmp     R1
        bne     FlyAliasBuildVisibility
        nop
        ; Later texels of this alias only read its immutable mask. Keep this
        ; path in RAM without a ROM-bank switch or saving untouched registers.
        lm      R0, (ALIAS_DEST_Y)
        move    R2, R12
        FLY_MASK_BIT
        move    R0, #0
        moveb   R0, (R10)
        with    R0
        and     R1
        beq     FlyAliasMaskVisible
        nop
        move    R0, #0
        bra     FlyAliasMaskReturn
        nop
FlyAliasMaskVisible:
        move    R0, #1
FlyAliasMaskReturn:
        lm      R2, (FLY_VIS_SAVED_R2)
        lm      R3, (FLY_VIS_SAVED_R3)
        ret
        nop
FlyAliasBuildVisibility:
        sm      (FLY_VIS_VISIBILITY_RETURN), R11
        sm      (FLY_VIS_SAVED_R4), R4
        sm      (FLY_VIS_SAVED_R5), R5
        sm      (FLY_VIS_SAVED_R6), R6
        sm      (FLY_VIS_SAVED_R7), R7
        sm      (FLY_VIS_SAVED_R9), R9
        sm      (FLY_VIS_SAVED_R12), R12
        sm      (FLY_VIS_SAVED_R13), R13

        move    R9, #$02
        iwt     R8, #.loword(FlyBrushTestMaskROM)
        from    R8
        ljmp    R9
        nop
FlyAliasBrushMaskDone:
        sm      (FLY_VIS_RESULT), R0

        lm      R0, (ALIAS_PIXEL_BANK)
        romb
        lm      R2, (FLY_VIS_SAVED_R2)
        lm      R3, (FLY_VIS_SAVED_R3)
        lm      R4, (FLY_VIS_SAVED_R4)
        lm      R5, (FLY_VIS_SAVED_R5)
        lm      R6, (FLY_VIS_SAVED_R6)
        lm      R7, (FLY_VIS_SAVED_R7)
        lm      R9, (FLY_VIS_SAVED_R9)
        lm      R12, (FLY_VIS_SAVED_R12)
        lm      R13, (FLY_VIS_SAVED_R13)
        lm      R0, (FLY_VIS_RESULT)
        lm      R11, (FLY_VIS_VISIBILITY_RETURN)
        ret
        nop

; Build one selected world's exact cached Q6 polygon, with unused S/T zero.
; FLY_MASK_LINK's high bit distinguishes this phase from dynamic brush links.
FlyWorldBuildDepthView:
        sm      (BRUSH_VERTEX_RETURN), R11
        lm      R0, (FLY_MASK_LINK)
        iwt     R1, #$7FFF
        with    R0
        and     R1
        move    R1, R0
  .repeat 2
        with    R0
        add     R0
  .endrepeat
        with    R0
        add     R1
        iwt     R10, #FACES
        with    R10
        add     R0
        jal     LoadPacketFaceFirstIndex
        move    R1, #0
        moveb   R1, (R10)
        sm      (CONVEX_EDGE_COUNT), R1
        with    R0
        add     R0
        iwt     R10, #INDICES
        with    R10
        add     R0
        sm      (CONVEX_INDEX_PTR), R10
        iwt     R0, #TEXTURE_VIEW_A
        sm      (CONVEX_OUTPUT_CURSOR), R0
        move    R0, #0
        sm      (CONVEX_OUTPUT_COUNT), R0
        sm      (TEXTURE_CLIP_OUTCODE), R0
        sm      (TEXTURE_CUR_S), R0
        sm      (TEXTURE_CUR_T), R0
        move    R0, #15
        sm      (TEXTURE_CLIP_AND_OUTCODE), R0
        iwt     R7, #32767
FlyWorldDepthVertex:
        lm      R10, (CONVEX_INDEX_PTR)
        movew   R0, (R10)
        inc     R10
        inc     R10
        sm      (CONVEX_INDEX_PTR), R10
        sm      (CLIP_VERTEX_INDEX), R0
        jal     LoadPacketViewVertex
        nop
        with    R10
        sub     #2
        movew   R3, (R10)
        with    R3
        cmp     R7
        FLY_SIGNED_BRANCH $06, FlyWorldDepthMinimumReady
        nop
        move    R7, R3
FlyWorldDepthMinimumReady:
        lm      R0, (TEXTURE_CLIP_OUTCODE)
        with    R0
        or      R2
        sm      (TEXTURE_CLIP_OUTCODE), R0
        lm      R0, (TEXTURE_CLIP_AND_OUTCODE)
        with    R0
        and     R2
        sm      (TEXTURE_CLIP_AND_OUTCODE), R0
        lm      R0, (CONVEX_EDGE_COUNT)
        dec     R0
        sm      (CONVEX_EDGE_COUNT), R0
        bne     FlyWorldDepthVertex
        nop
        lm      R0, (FLY_MASK_LINK)
        iwt     R1, #$7FFF
        with    R0
        and     R1
        move    R1, R0
        with    R0
        add     R0
        with    R0
        add     R1
        with    R0
        add     R0
        iwt     R10, #FLY_MASK_BOUNDS+4
        with    R10
        add     R0
        movew   (R10), R7
        lm      R11, (BRUSH_VERTEX_RETURN)
        ret
        nop
.assert BSP_FACE_RECORD_BYTES = 5, error, "World mask packet addressing changed"

.include "fly_full/WorldMaskBounds.sgs"
.include "fly_full/WorldMaskCoarseBounds.sgs"

; ROM mask setup invokes the existing projected-span kernels in bank $70.
FlyBrushMaskCallRAM:
        link    #2
        jmp     R8
        nop
        lm      R8, (FLY_MASK_ROM_RETURN)
        move    R9, #$02
        from    R8
        ljmp    R9
        nop

.include "fly_full/BrushMaskDepth.sgs"
.include "FlyBrushVisibility.sgs"
.pushseg
.segment "GSU_ALIAS_FLY_CODE"
.assert * - FlyAliasTestVisibility <= GSU_ALIAS_FLY_CODE_CAPACITY, error, "Fly alias visibility code exceeds the deferred overlay"
.popseg
