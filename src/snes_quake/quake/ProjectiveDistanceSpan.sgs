; Dedicated projective block-8 span for textured Distance (technique 3).
; Techniques 2 and 4 retain their independent branch-free hot loops. Q6 view
; depth is sampled at each exact block endpoint, mapped through Quake's compact
; depth LUT, and interpolated only inside that at-most-eight-pixel block.

TextureDrawSpanDistance:
        sm      (TEXTURE_SPAN_RETURN), R11
        sm      (TEXTURE_SPAN_X), R1
        sm      (TEXTURE_SPAN_END_X), R3

        iwt     R10, #GSU_TEXTURE_COORD_MAP_OFFSET
        with    R10
        add     R2
        move    R2, #0
        moveb   R2, (R10)
        sm      (TEXTURE_PLOT_Y), R2

        lm      R0, (TEXTURE_LEFT_S)
        sm      (TEXTURE_BASE_S), R0
        lm      R1, (TEXTURE_RIGHT_S)
        with    R1
        sub     R0
        sm      (TEXTURE_DELTA_S), R1
        lm      R0, (TEXTURE_LEFT_T)
        sm      (TEXTURE_BASE_T), R0
        lm      R1, (TEXTURE_RIGHT_T)
        with    R1
        sub     R0
        sm      (TEXTURE_DELTA_T), R1
        lm      R0, (TEXTURE_LEFT_SHADE)
        sm      (TEXTURE_BASE_DEPTH), R0
        lm      R1, (TEXTURE_RIGHT_SHADE)
        with    R1
        sub     R0
        sm      (TEXTURE_DELTA_DEPTH), R1

        lm      R2, (CONVEX_MAX_X)
        lm      R1, (CONVEX_MIN_X)
        with    R2
        sub     R1
        moves   R2, R2
        beq     TextureDistanceReciprocalReady
        nop
        jal     TexturePrepareDivideQ12
        nop
TextureDistanceReciprocalReady:
        lm      R0, (TEXTURE_SPAN_X)
        jal     TexturePerspectiveSampleSpan
        nop
        sm      (TEXTURE_SPAN_S), R5
        sm      (TEXTURE_SPAN_T), R6

        ; TexturePerspectiveSampleSpan leaves its perspective world factor in
        ; R3. Evaluate Q6 projection depth with that same factor.
        lm      R7, (TEXTURE_BASE_DEPTH)
        lm      R1, (TEXTURE_DELTA_DEPTH)
        BSP_SIGNED_MUL_SHIFT_TRUNC12 R0, R1, R3
        with    R7
        add     R0
        with    R7
        hib
        iwt     R10, #GSU_TEXTURE_DEPTH_SHADE_OFFSET
        with    R10
        add     R7
        move    R0, #0
        moveb   R0, (R10)
        with    R0
        swap
        sm      (TEXTURE_SPAN_SHADE_Q8), R0

        lm      R0, (TEXTURE_ROM_BANK)
        romb
        lm      R0, (TEXTURE_SPAN_X)
        lm      R1, (TEXTURE_SPAN_END_X)
        with    R0
        cmp     R1
        bne     TextureDistanceBlockSetup
        nop
        move    R0, #0
        sm      (TEXTURE_STEP_SHADE_Q8), R0
        GSU_ABSOLUTE_GOTO TextureDistanceSpanLoopPrepare

TextureDistanceBlockSetup:
        lm      R0, (TEXTURE_SPAN_X)
        move    R4, R0
        with    R4
        add     #8
        lm      R1, (TEXTURE_SPAN_END_X)
        move    R2, R4
        with    R2
        sub     R1
        bmi     TextureDistanceBlockEndReady
        nop
        move    R4, R1
TextureDistanceBlockEndReady:
        sm      (TEXTURE_BLOCK_END_X), R4
        move    R0, R4
        jal     TexturePerspectiveSampleSpan
        nop
        sm      (TEXTURE_BLOCK_END_S), R5
        sm      (TEXTURE_BLOCK_END_T), R6

        lm      R7, (TEXTURE_BASE_DEPTH)
        lm      R1, (TEXTURE_DELTA_DEPTH)
        BSP_SIGNED_MUL_SHIFT_TRUNC12 R0, R1, R3
        with    R7
        add     R0
        with    R7
        hib
        iwt     R4, #GSU_TEXTURE_DEPTH_SHADE_OFFSET
        with    R4
        add     R7
        move    R0, #0
        moveb   R0, (R4)
        sm      (TEXTURE_BLOCK_END_SHADE), R0

        lm      R0, (TEXTURE_BLOCK_END_X)
        lm      R1, (TEXTURE_SPAN_X)
        with    R0
        sub     R1
        sm      (TEXTURE_SPAN_DEN), R0

        ; Finish shade interpolation before building the coordinate buffer.
        ; The builder can then hand off to the sampler with the exact same live
        ; state as the parity-clean projective albedo path.
        lm      R0, (TEXTURE_BLOCK_END_SHADE)
        lm      R1, (TEXTURE_SPAN_SHADE_Q8)
        with    R1
        hib
        with    R0
        sub     R1
        move    R4, #1
        moves   R0, R0
        bpl     TextureDistanceShadePositive
        nop
        iwt     R4, #-1
        move    R1, #0
        with    R1
        sub     R0
        move    R0, R1
TextureDistanceShadePositive:
        sm      (TEXTURE_SIGN_SHADE), R4
        with    R0
        swap
        lm      R1, (TEXTURE_SPAN_DEN)
        move    R2, R1
        with    R2
        sub     #8
        bne     TextureDistanceShadeShortBlock
        nop
  .repeat 3
        with    R0
        lsr
  .endrepeat
        move    R2, R0
        bra     TextureDistanceShadeStepReady
        nop
TextureDistanceShadeShortBlock:
        jal     TextureDivideBlockUnsigned
        nop
TextureDistanceShadeStepReady:
        sm      (TEXTURE_STEP_SHADE_Q8), R2

        lm      R0, (TEXTURE_BLOCK_END_S)
        lm      R1, (TEXTURE_SPAN_S)
        with    R0
        sub     R1
        move    R4, #1
        moves   R0, R0
        bpl     TextureDistanceBlockSPositive
        nop
        iwt     R4, #-1
        move    R1, #0
        with    R1
        sub     R0
        move    R0, R1
TextureDistanceBlockSPositive:
        move    R8, R4
        lm      R1, (TEXTURE_SPAN_DEN)
        jal     TextureDivideBlockUnsigned
        nop
        move    R7, R2
        move    R9, R3

        lm      R0, (TEXTURE_BLOCK_END_T)
        lm      R1, (TEXTURE_SPAN_T)
        with    R0
        sub     R1
        move    R4, #1
        moves   R0, R0
        bpl     TextureDistanceBlockTPositive
        nop
        iwt     R4, #-1
        move    R1, #0
        with    R1
        sub     R0
        move    R0, R1
TextureDistanceBlockTPositive:
        move    R10, R8
        move    R8, R4
        lm      R1, (TEXTURE_SPAN_DEN)
        jal     TextureDivideBlockUnsigned
        nop
        move    R11, R8
        move    R8, R2
        move    R13, R3
        move    R4, R10
        GSU_ABSOLUTE_GOTO TextureBuildCoordinateBlockDistanceRegisters

TextureDistanceCoordinateBlockReady:
        lm      R0, (TEXTURE_ROM_BANK)
        romb

TextureDistanceSpanLoopPrepare:
        lm      R8, (TEXTURE_SPAN_X)
        lm      R9, (TEXTURE_SPAN_END_X)
        lm      R12, (TEXTURE_PLOT_Y)
        lm      R13, (TEXTURE_SAMPLE_ROUTINE)
        lm      R10, (TEXTURE_COORD_PTR)
        lm      R5, (TEXTURE_SPAN_S)
        lm      R6, (TEXTURE_SPAN_T)
        iwt     R3, #GSU_TEXTURE_COORD_MAP_OFFSET
        with    R3
        add     R8

TextureDistanceSpanLoop:
        link    #2
        jmp     R13
        nop
        move    R7, R0
        lm      R4, (TEXTURE_SPAN_SHADE_Q8)
        with    R4
        hib
        with    R4
        swap
        with    R4
        add     R7
        iwt     R1, #GSU_TEXTURE_COLORMAP_OFFSET
        with    R4
        add     R1
        move    R0, #0
        moveb   R0, (R4)
        color
        move    R1, #0
        moveb   R1, (R3)
        inc     R3
        move    R2, R12
        plot

        with    R8
        cmp     R9
        bne     TextureDistanceSpanContinue
        nop
        GSU_ABSOLUTE_GOTO TextureDistanceSpanDone
TextureDistanceSpanContinue:
        inc     R8
        movew   R5, (R10)
        inc     R10
        inc     R10
        movew   R6, (R10)
        inc     R10
        inc     R10

        lm      R0, (TEXTURE_SPAN_SHADE_Q8)
        lm      R1, (TEXTURE_STEP_SHADE_Q8)
        lm      R2, (TEXTURE_SIGN_SHADE)
        moves   R2, R2
        bmi     TextureDistanceShadeSubtract
        nop
        with    R0
        add     R1
        bra     TextureDistanceShadeAdvanced
        nop
TextureDistanceShadeSubtract:
        with    R0
        sub     R1
TextureDistanceShadeAdvanced:
        sm      (TEXTURE_SPAN_SHADE_Q8), R0

        lm      R1, (TEXTURE_BLOCK_END_X)
        with    R8
        cmp     R1
        bne     TextureDistanceSpanLoop
        nop
        ; Anchor every shared/final endpoint to its exact projective shade.
        lm      R0, (TEXTURE_BLOCK_END_SHADE)
        with    R0
        swap
        sm      (TEXTURE_SPAN_SHADE_Q8), R0
        with    R8
        cmp     R9
        beq     TextureDistanceSpanLoop
        nop
        sm      (TEXTURE_SPAN_S), R5
        sm      (TEXTURE_SPAN_T), R6
        sm      (TEXTURE_SPAN_X), R8
        GSU_ABSOLUTE_GOTO TextureDistanceBlockSetup

TextureDistanceSpanDone:
        lm      R11, (TEXTURE_SPAN_RETURN)
        ret
        nop

; Append the technique-3 entry after every pre-existing GSUCODE kernel, keeping
; their linked addresses and cache layout stable.
GSU_CACHE_KERNEL_BEGIN GSU_TextureDistanceCode
        move    R0, #1
        ramb
        move    R0, #$11
        cmode
        move    R0, #3
        sm      (TEXTURE_RENDER_MODE), R0
        jal     LoadProjectedPacketState
        nop
        jal     TextureRenderFacesDistance
        nop
        GSU_FLUSH_PLOT 0, 0
        iwt     R10, #TELEMETRY
        iwt     R0, #$B529
        movew   (R10), R0
        stop
        nop
GSU_CACHE_KERNEL_END GSU_TextureDistanceCode
