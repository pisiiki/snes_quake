; Lightmap sample kernel extracted to keep each authored source below the
; repository's 2,048-line hard limit. It is included at its original address.

; Bilinearly sample the current face's precombined 6-bit light grid. Absolute
; Q4 texture coordinates provide a signed block byte plus a four-bit fraction.
; Return the compact cartridge-RAM colormap row in R0. A negative fast mode
; proves the complete projective block stays inside the lightmap bounds.
LightmapSample:
        ; R7 is not needed until the lower sample address is formed. Preserve
        ; the call return there instead of spilling it to cartridge RAM.
        move    R7, R11
        lm      R0, (LIGHTMAP_BLOCK_FAST)
        moves   R0, R0
        beq     LightmapSampleGenericChecked
        nop
        bmi     LightmapSampleGenericInterior
        nop
        dec     R0
        beq     LightmapSampleBlockBilinear
        nop
        GSU_ABSOLUTE_GOTO LightmapSampleCachedDegenerate
LightmapSampleGenericChecked:
        lm      R0, (LIGHTMAP_ROM_BANK)
        moves   R0, R0
        bpl     LightmapSampleGenericClamped
        nop
        GSU_ABSOLUTE_GOTO LightmapSampleMissing
LightmapSampleGenericInterior:
        GSU_ABSOLUTE_GOTO LightmapSampleInteriorDirect, shared_delay
        with    R8
        nop
LightmapSampleBlockBilinear:
        move    R3, R8
        iwt     R1, #$00F0
        GSU_ABSOLUTE_GOTO LightmapSampleBlockBilinearCached
  .repeat $11 - (* - LightmapSampleBlockBilinear)
        nop
  .endrepeat
LightmapSampleGenericClamped:
        move    R6, #0
LightmapSampleGenericDecode:
        move    R5, R8
        move    R0, R5
        hib
        sex
        lm      R1, (LIGHTMAP_MIN_BLOCK_S)
        sub     R1
        move    R8, R0
        moves   R6, R6
        bne     LightmapSampleSInterior
        nop
        moves   R0, R0
        bmi     LightmapSampleSLow
        nop
        lm      R1, (LIGHTMAP_WIDTH)
        dec     R1
        move    R2, R0
        with    R2
        sub     R1
        bmi     LightmapSampleSInterior
        nop
        move    R8, R1
        move    R3, #0
        bra     LightmapSampleT
        nop
LightmapSampleSLow:
        move    R8, #0
        move    R3, #0
        bra     LightmapSampleT
        nop
LightmapSampleSInterior:
        move    R3, R5
        iwt     R1, #$00F0
        with    R3
        and     R1
LightmapSampleT:
        move    R5, R9
        move    R0, R5
        hib
        sex
        ; Preserve the S-fraction mask in R1 for the proven-interior route.
        ; Checked coordinates reload R1 below before their clamp comparison.
        lm      R4, (LIGHTMAP_MIN_BLOCK_T)
        sub     R4
        moves   R6, R6
        bne     LightmapSampleTFastInterior
        with    R5
        moves   R0, R0
        bmi     LightmapSampleTLow
        nop
        lm      R1, (LIGHTMAP_HEIGHT)
        dec     R1
        move    R2, R0
        with    R2
        sub     R1
        bmi     LightmapSampleTInterior
        nop
        move    R0, R1
        move    R5, #0
        bra     LightmapSampleOffsets
        nop
LightmapSampleTLow:
        move    R0, #0
        move    R5, #0
        bra     LightmapSampleOffsets
        nop
LightmapSampleTInterior:
        iwt     R1, #$00F0
        with    R5
LightmapSampleTFastInterior:
        and     R1
LightmapSampleOffsets:
        lm      R1, (LIGHTMAP_WIDTH)
        umult   R1
        add     R8
        move    R6, R0                  ; upper-left byte offset
LightmapSampleHorizontalReady:
        cache
        lm      R4, (LIGHTMAP_ROM_ADDRESS)
        bra     LightmapSampleBaseReady
        nop
TexturePrimeLightmapCache:
        ; Share the sampler's CBR. Priming an earlier 16-byte anchor makes
        ; the horizontal entry invalidate that warmed cache on every block.
        cache
        ret
        nop
LightmapSampleAdjustedHorizontalReady:
        ; CACHE uses the PC after fetching its opcode, including at $xF.
        .assert ((TexturePrimeLightmapCache + 1) & $FFFFF0) = ((LightmapSampleHorizontalReady + 1) & $FFFFF0), lderror, "Lightmap prime must share the sampler cache anchor"
        lm      R4, (LIGHTMAP_ADJUSTED_ADDRESS)
LightmapSampleBaseReady:
        ; LDB replaces the full register with an unsigned byte (Nintendo Book II,
        ; 9.45/page2-9-64); it never needs a prior high-byte clear.

        with    R4
        add     R6
        moveb   R8, (R4)
        moves   R3, R3
        beq     LightmapSampleUpperRightSame
        inc     R4
        moveb   R9, (R4)
        bra     LightmapSampleUpperReady
        dec     R4
LightmapSampleUpperRightSame:
        dec     R4
        move    R9, R8
LightmapSampleUpperReady:
        ; R6 can become the lower-row offset once both upper samples are
        ; consumed. This leaves R7 untouched as the register-held return.
        moves   R5, R5
        beq     LightmapSampleLowerSame
        with    R4
        add     R1
        moveb   R6, (R4)
        moves   R3, R3
        beq     LightmapSampleLowerRightSame
        inc     R4
        moveb   R11, (R4)
        bra     LightmapSampleLowerReady
        nop
LightmapSampleLowerRightSame:
        move    R11, R6
        bra     LightmapSampleLowerReady
        nop
.if .defined(PLAYABLE_LIGHTMAP_ZERO_T) && (BSP_RENDER_SCALE = 2)
LightmapSampleLowerSame = *
        GSU_ABSOLUTE_GOTO LightmapSampleHorizontalOnly
.else
LightmapSampleLowerSame:
        move    R6, R8
        move    R11, R9
.endif
LightmapSampleLowerReady:
.if (.defined(QUAKE_MSU_WORLD_KEEP) || .defined(PLAYABLE_SIGNED_LIGHTMAP_INTERPOLATION)) && (BSP_RENDER_SCALE = 2)
.include "quake/MsuLightmapSixBit.sgs"
.else
        ; Exact rounded difference interpolation. SUB supplies the signed
        ; difference; ALT1 survives BPL and makes its one-byte MULT delay
        ; unsigned. HIB's negative quotient wraps by 256, removed by LOB.
        ; The old S=0 shortcut is unnecessary: the difference form is exact
        ; at zero and keeps both horizontal kernels in their pinned slot.
        iwt     R2, #128
LightmapDifferenceUpperEntry:
        from    R9
        sub     R8
        alt1
        bpl     LightmapDifferenceUpperPositive
        mult    R3
        add     R2
        hib
        sub     R3
        bra     LightmapDifferenceUpperReady
        add     R8
LightmapDifferenceUpperPositive:
        add     R2
        hib
        add     R8
LightmapDifferenceUpperReady:
        to      R4
        lob
LightmapDifferenceLowerEntry:
        from    R11
        sub     R6
        alt1
        bpl     LightmapDifferenceLowerPositive
        mult    R3
        add     R2
        hib
        sub     R3
        bra     LightmapDifferenceLowerReady
        add     R6
LightmapDifferenceLowerPositive:
        add     R2
        hib
        add     R6
LightmapDifferenceLowerReady:
        to      R6
        lob
LightmapDifferenceHorizontalDone:
        bra     LightmapSampleHorizontalInterpolated
        with    R5
LightmapSampleHorizontalZero:
        move    R4, R8
        with    R5
LightmapSampleHorizontalInterpolated:
        from    R5
        beq     LightmapSampleMap
        nop
LightmapDifferenceVerticalEntry:
        from    R6
        sub     R4
        alt1
        bpl     LightmapDifferenceVerticalPositive
        mult    R5
        add     R2
        hib
        sub     R5
        bra     LightmapDifferenceVerticalReady
        add     R4
LightmapDifferenceVerticalPositive:
        add     R2
        hib
        add     R4
LightmapDifferenceVerticalReady:
        to      R4
        lob
.endif
LightmapSampleMap:
        bra     LightmapSampleDone
        with    R7
LightmapSampleMissing:
        lm      R4, (LIGHTMAP_ROM_ADDRESS)
        with    R7
LightmapSampleDone:
        to      R11
        ret
        nop
        nop

.if .defined(PLAYABLE_LIGHTMAP_ZERO_T) && (BSP_RENDER_SCALE = 2)
.assert .defined(PLAYABLE_SIGNED_LIGHTMAP_INTERPOLATION), error, "Horizontal-only interpolation needs the signed sampler window"
; A zero T fraction consumes only the upper row. The shared one-axis
; entry installs UL and halves the still-unscaled S fraction in R5.
LightmapSampleHorizontalOnly:
        move    R6, R9
        move    R5, R3
        iwt     R2, #128
        bra     LightmapSampleHorizontalZero
        nop
.endif

; Keep the independently reachable technique-7 mapper at its established PC.
        .res $81 - (* - LightmapSampleBaseReady), $01

TextureUntexturedLightmapSampleReady:
.ifdef PLAYABLE_TEXTURELESS_WHITE
        ; The general mapper is patched for the same protected ramp.
        bra     TextureLightmapSampleReady
        nop
.else
        ; Encoded page $C0..$FF maps to standalone neutral index $3F..$00.
        from    R4
        not
        bra     TextureLightmapSkyPlotReady
        nop
.endif

; Keep the following shader/cache entries pinned. All sampler exits return.
.assert * - LightmapSampleBaseReady <= $89, error, "Lightmap sample tail exceeds its pinned slot"
        .res $89 - (* - LightmapSampleBaseReady), $01
