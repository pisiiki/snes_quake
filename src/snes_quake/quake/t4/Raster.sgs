; Fixed-lightmap raster and edge dispatch for technique 4. These routines are
; copied over shared-code windows; the S-CPU restores the
; original GSUCODE bytes before the legacy path or another technique runs.

.segment "GSU_T4_RASTER_CODE"

DEFINE_TEXTURE_SHADED_RASTER T4TextureRasterPolygonShaded, 1, TextureCacheActiveEdgeShaded, TextureIntersectActiveEdgeShaded, T4TextureStageLightmapEdge, 1

; The face-level route points here only when its 16-byte rows cannot fit the
; bounded staging arena. Publish the register-return edge exactly as the old
; shared scratch path did, then return to the unchanged direct-span loop.
T4TextureStageLightmapFallback:
        moves   R2, R2
        bne     T4TextureStageLightmapFallbackRight
        nop
        sm      (CONVEX_MIN_X), R0
        sm      (TEXTURE_LEFT_S), R8
        sm      (TEXTURE_LEFT_T), R9
        sm      (TEXTURE_LEFT_SHADE), R12
        ret
        nop
T4TextureStageLightmapFallbackRight:
        sm      (CONVEX_MAX_X), R0
        sm      (TEXTURE_RIGHT_S), R8
        sm      (TEXTURE_RIGHT_T), R9
        sm      (TEXTURE_RIGHT_SHADE), R12
        ret
        nop

.assert T4TextureRasterPolygonShaded = TextureRasterPolygonShaded, error, "Technique-4 raster overlay moved away from the general raster entry"
.assert * - T4TextureRasterPolygonShaded <= GSU_T4_RASTER_CODE_CAPACITY, error, "Technique-4 raster overlay exceeds its general-code window"

.segment "GSU_T4_EDGE_PATCH"

T4TextureShadeIntersectModeDispatch:
        iwt     R13, #TextureEdgePerspectiveLookup
        jal     TexturePerspectiveFactorQ12Products
        move    R6, R3
        bra     TextureShadeIntersectScaleFactor
        nop

.assert T4TextureShadeIntersectModeDispatch = TextureShadeIntersectModeDispatch, error, "Technique-4 edge patch moved away from the general mode dispatch"
.assert * - T4TextureShadeIntersectModeDispatch <= GSU_T4_EDGE_PATCH_CAPACITY, error, "Technique-4 edge patch exceeds the general mode-dispatch window"
.assert * <= TextureShadeIntersectScaleFactor, error, "Technique-4 edge patch overlaps the shared scale path"

.segment "GSU_T4_EDGE_DEPTH_CODE"

T4TextureShadeIntersectScaledDepth:
        BSP_SIGNED_MUL_SCALED8_SHIFT_TRUNC12 R7
        to      R12
        add     R5
        bra     TextureShadeIntersectScaledAttributes
        nop

.assert T4TextureShadeIntersectScaledDepth = TextureShadeIntersectScaledDepth, error, "Technique-4 edge depth output moved away from the general depth path"
.assert * - T4TextureShadeIntersectScaledDepth <= GSU_T4_EDGE_DEPTH_CAPACITY, error, "Technique-4 edge depth output exceeds the general depth window"
.assert * <= TextureShadeIntersectDepthEnd, error, "Technique-4 edge depth output overlaps the general continuation"

; The common T4 row path writes each edge straight into its compact stage
; record and returns left edges while the shaded-edge cache is resident.
; Right-edge completion uses the hidden code tail. Oversized faces retain the
; unchanged direct-span fallback and never enter this helper.
.segment "GSU_T4_STAGE_CODE"

T4TextureStageLightmapEdge:
        lm      R10, (TEXTURE_COORD_PTR)
        with    R10
        add     R2
        movew   (R10), R0
        with    R10
        add     #4
        movew   (R10), R8
        with    R10
        add     #4
        movew   (R10), R9
        with    R10
        add     #4
        movew   (R10), R12
        ; Left edges return directly; only right edges finish the row.
        dec     R2
        bpl     T4TextureStageLightmapFinishRight
        nop
        ret
        nop
T4TextureStageLightmapFinishRight:
        GSU_ABSOLUTE_GOTO T4TextureStageLightmapRight
        .res 32 - (* - T4TextureStageLightmapEdge)
DEFINE_TEXTURE_EDGE_PERSPECTIVE_LOOKUP T4TextureEdgePerspectiveLookup
        .res GSU_T4_STAGE_CODE_CAPACITY - (* - T4TextureStageLightmapEdge)
.assert T4TextureEdgePerspectiveLookup = TextureEdgePerspectiveLookup, error, "T4 perspective lookup moved away from the shared edge cache"

.assert T4TextureStageLightmapEdge = TextureStageLightmapRow, error, "Technique-4 stage helper moved away from the resident edge-cache window"
.assert * - T4TextureStageLightmapEdge <= GSU_T4_STAGE_CODE_CAPACITY, error, "Technique-4 stage helper exceeds the shared row-writer window"
.assert * <= TextureShadeIntersectScaledAttributes, error, "Technique-4 stage helper overlaps the shared attribute path"

; The specialized shaded edge returns S, T, and depth in R8, R9, and R12.
; World rows stage those values directly, and the T4 brush patches publish
; them without the general EDGE -> LEFT/RIGHT scratch round trip.
.segment "GSU_T4_EDGE_OUTPUT_CODE"

T4TextureShadeIntersectOutputs:
        lm      R5, (TEXTURE_BASE_S)
        lm      R7, (TEXTURE_DELTA_S)
        BSP_SIGNED_MUL_SCALED8_SHIFT_TRUNC12 R7
        to      R8
        add     R5

        lm      R5, (TEXTURE_BASE_T)
        lm      R7, (TEXTURE_DELTA_T)
        BSP_SIGNED_MUL_SCALED8_SHIFT_TRUNC12 R7
        to      R9
        add     R5
        bra     TextureShadeIntersectScreenX
        nop

  .repeat $47 - (* - T4TextureShadeIntersectOutputs)
        nop
  .endrepeat
T4TextureShadeIntersectUnityOutputs:
        GSU_ABSOLUTE_GOTO T4TextureShadeIntersectUnityOutputsCold

.assert T4TextureShadeIntersectOutputs = TextureShadeIntersectScaledAttributes, error, "Technique-4 edge outputs moved away from the general attribute window"
.assert T4TextureShadeIntersectUnityOutputs = TextureShadeIntersectUnityAttributes, error, "Technique-4 unity outputs moved away from the general unity path"
.assert * - T4TextureShadeIntersectOutputs <= GSU_T4_EDGE_OUTPUT_CAPACITY, error, "Technique-4 edge outputs exceed the general attribute window"
.assert * <= TextureShadeIntersectScreenX, error, "Technique-4 edge outputs overlap the shared screen-X continuation"
