; Technique-4 sampling keeps every square power-of-two miptex on one direct
; hot path. The cold selector may install the material-owned mixed sampler
; while executing from ROM, then publishes its private routes.
;
; Wrap backedges retain their entry checks: ADD supplies the negative-loop
; sign, and a successful SUB leaves R0 equal to the stored coordinate. Reuse
; those results without repeating MOVES or MOVE on later corrections.

.macro T4_PUBLISH_LIGHTMAP_ROUTES
        iwt     R1, #T4TextureLightmapBilinearSpanLoop
        sm      (TEXTURE_STEP_T), R1
        iwt     R1, #TextureLightmapConstantSpanLoop
        sm      (TEXTURE_REM_S), R1
        iwt     R1, #TextureLightmapVerticalSpanLoop
        sm      (TEXTURE_REM_T), R1
        iwt     R1, #TextureLightmapHorizontalSpanLoop
        sm      (TEXTURE_ERR_S), R1
        iwt     R1, #TextureLightmapInteriorSpanLoop
        sm      (TEXTURE_ERR_T), R1
.endmacro

.segment "GSU_T4_BLOCK_SELECT_CODE"

T4TextureLightmapSelectBlockRoutine:
        lm      R0, (TEXTURE_ROM_BANK)
        romb
        lm      R0, (LIGHTMAP_BLOCK_FAST)
        moves   R0, R0
        bpl     T4TextureLightmapRouteIndexReady
        nop
        ; Four out of five prepared blocks are proven interior. Publish their
        ; direct route without indexing the six-entry general dispatch table.
        ; Mixed-axis and square power-of-two faces publish their respective
        ; interior continuations in this slot. Load the face-specific route
        ; without rebuilding its table address per block.
        lm      R13, (TEXTURE_ERR_T)
        bra     T4TextureLightmapBlockRoutineReady
        nop
        ; The direct route never consumes the old table index in R0.
        .res 2, $01                    ; Keep all following overlay entries.
T4TextureLightmapRouteIndexReady:
        GSU_ABSOLUTE_GOTO T4TextureLightmapRouteIndexReadyCold
  .repeat $1C - (* - T4TextureLightmapSelectBlockRoutine)
        nop
  .endrepeat
T4LightmapSampleCachedDegenerate:
        dec     R0
        bne     T4LightmapSampleCachedVertical
        nop
        lm      R4, (LIGHTMAP_BLOCK_UL)
        GSU_ABSOLUTE_GOTO LightmapSampleMap
T4LightmapSampleCachedVertical:
        move    R5, R9
        lm      R6, (LIGHTMAP_BLOCK_LL)
        GSU_ABSOLUTE_GOTO TextureLightmapOneAxisSample
T4TextureLightmapBlockRoutineReady:
        iwt     R7, #TextureLightmapSampleReady
        lm      R5, (TEXTURE_SPAN_S)
        lm      R6, (TEXTURE_SPAN_T)
        iwt     R10, #GSU_TEXTURE_BLOCK_COORDS_OFFSET+4
        jmp     R13
        nop
  .repeat GSU_T4_BLOCK_SELECT_CAPACITY - (* - T4TextureLightmapSelectBlockRoutine)
        nop
  .endrepeat

.assert T4TextureLightmapSelectBlockRoutine = TextureLightmapSelectBlockRoutine, error, "Technique-4 block selector moved away from the general selector entry"
.assert T4LightmapSampleCachedDegenerate = LightmapSampleCachedDegenerate, error, "Technique-4 degenerate decoder moved away from the general route"
.assert T4TextureLightmapBlockRoutineReady = TextureLightmapBlockRoutineReady, error, "Technique-4 block continuation moved away from the general continuation"
.assert * = TextureLightmapBilinearSpanLoop, error, "Technique-4 block selector changed the downstream pixel-loop address"

.segment "GSU_T4_SAMPLE_WRAP_CODE"

T4TextureSampleAbsoluteRegisters:
        lm      R0, (TEXTURE_WRAP_FLAGS)
        move    R7, R0
        with    R0
        and     #BSP_WORLD_TEXTURE_FLAG_POWER_OF_TWO_AXES
        moves   R0, R0
        beq     T4TextureSampleMixedAxes
        nop
        lm      R1, (TEXTURE_WRAP_MASK_S)
        with    R5
        and     R1
        lm      R1, (TEXTURE_WRAP_MASK_T)
        with    R6
        and     R1
        bra     TextureSampleCoordinatesReady
        nop
T4TextureSampleMixedAxes:
        ; The general path only records whether both axes are powers of two.
        ; Detect a power-of-two S axis independently so mixed 128x192 miptex
        ; do one mask instead of repeatedly adding 128 pixels to negative S.
        lm      R1, (TEXTURE_WIDTH_Q4)
        move    R2, R1
        dec     R2
        with    R2
        and     R1
        moves   R2, R2
        beq     T4TextureSamplePowerOfTwoS
        nop
        GSU_ABSOLUTE_GOTO T4TextureSampleWrapSGeneric
T4TextureSamplePowerOfTwoS:
        lm      R1, (TEXTURE_WRAP_MASK_S)
        with    R5
        and     R1
        GSU_ABSOLUTE_GOTO T4TextureSampleAbsoluteSDone

  .repeat $36 - (* - T4TextureSampleAbsoluteRegisters)
        nop
  .endrepeat
T4TextureSampleAbsoluteSDone:
        ; The extent is invariant throughout the signed correction loops.
        lm      R1, (TEXTURE_HEIGHT_Q4)
T4TextureSampleAbsoluteTNegative:
        moves   R6, R6
        bpl     T4TextureSampleAbsoluteTHigh
        nop
T4TextureSampleAbsoluteTAdd:
        with    R6
        add     R1
        bmi     T4TextureSampleAbsoluteTAdd
        nop
T4TextureSampleAbsoluteTHigh:
        move    R0, R6
T4TextureSampleAbsoluteTSubtract:
        with    R0
        sub     R1
        bmi     T4TextureSampleAbsoluteTDone
        nop
        move    R6, R0
        bra     T4TextureSampleAbsoluteTSubtract
        nop
        ; Neither branch falls through; retain the established done entry.
  .repeat 3
        nop
  .endrepeat
T4TextureSampleAbsoluteTDone:
        bra     TextureSampleAbsoluteCoordinatesReady
        nop
T4TextureSample:
        lm      R5, (TEXTURE_SPAN_S)
        lm      R6, (TEXTURE_SPAN_T)
        move    R7, #0

.assert T4TextureSampleAbsoluteRegisters = TextureSampleAbsoluteRegisters, error, "Technique-4 wrap sampler moved away from the general sampler entry"
.assert T4TextureSampleAbsoluteSDone = TextureSampleAbsoluteSDone, error, "Technique-4 T-wrap loop moved away from the general sampler window"
.assert T4TextureSample = TextureSample, error, "Technique-4 state-loading sampler moved away from the general sampler entry"
.assert * = TextureSampleAbsoluteCoordinatesReady, error, "Technique-4 wrap sampler changed the downstream sampler address"
.assert * - T4TextureSampleAbsoluteRegisters <= GSU_T4_SAMPLE_WRAP_CAPACITY, error, "Technique-4 wrap sampler exceeds the general coordinate-wrap window"

.segment "GSU_T4_SAMPLE_CODE"

; The textured mode does not enter the retired state-loading T2 sampler or
; the T7 interior continuation. Keep its unchanged bilinear pixel loop here
; in the already resident lightmap window. Restoring the full overlay returns
; both legacy entries before either other mode can run.
T4TextureLightmapBilinearSpanLoop:
        move    R8, R5
        move    R9, R6
        jal     TextureSampleAbsolutePowerOfTwoSingleBankRegisters
        move    R12, R0
        move    R3, R8
        iwt     R1, #$00F0
        GSU_ABSOLUTE_GOTO LightmapSampleBlockBilinearCached
.assert * - T4TextureLightmapBilinearSpanLoop <= $15, error, "Cached T4 bilinear loop exceeds retired sampler entries"
        .res $15 - (* - T4TextureLightmapBilinearSpanLoop), $01

T4TextureSampleAbsolutePowerOfTwoSingleBankRegisters:
        ; Keep the established general row router byte-for-byte: moving the
        ; uncommon-width continuation out of this cache window costs more on
        ; those faces than fixing the dominant width saves.
.if .defined(PLAYABLE_RECTANGULAR_POT_SAMPLER) && (BSP_RENDER_SCALE = 2)
        lm      R1, (TEXTURE_WRAP_MASK_S)
.else
        lm      R1, (TEXTURE_SPAN_SHADE_Q8)
.endif
        from    R5
        and     R1
        ; Match the ordinary sampler's implicit scratch shifts and anchors.
  .repeat 3
        lsr
  .endrepeat
        to      R5
        lsr
.if .defined(PLAYABLE_RECTANGULAR_POT_SAMPLER) && (BSP_RENDER_SCALE = 2)
        lm      R1, (TEXTURE_SPAN_SHADE_Q8)
.endif
        with    R6
        and     R1
        lm      R12, (TEXTURE_STEP_SHADE_Q8)
        jmp     R12
        with    R6
.if .defined(PLAYABLE_RECTANGULAR_POT_SAMPLER) && (BSP_RENDER_SCALE = 2)
        ; The second mask load occupies the old three-byte padding.
.else
  .repeat 3
        nop
  .endrepeat
.endif
T4TextureSamplePowerOfTwoRowShift3:
        add     R6
        with    R6
T4TextureSamplePowerOfTwoRowShift2:
        add     R6
        with    R6
T4TextureSamplePowerOfTwoRowShift1:
        add     R6
        with    R6
T4TextureSamplePowerOfTwoRowReady:
        add     R5
        lm      R4, (TEXTURE_ROM_ADDRESS)
        with    R4
        add     R6
        GSU_SET_ROM_BUFFER_ADDRESS R4
        jmp     R11
        getb
        .res 3, $01
        nop

.assert T4TextureSampleAbsolutePowerOfTwoSingleBankRegisters = TextureSampleAbsolutePowerOfTwoSingleBankRegisters, error, "Technique-4 sampler moved away from the general sampler entry"
.assert T4TextureSamplePowerOfTwoRowShift3 = TextureSamplePowerOfTwoRowShift3, error, "Technique-4 width-128 row route moved away from the general route"
.assert T4TextureSamplePowerOfTwoRowShift2 = TextureSamplePowerOfTwoRowShift2, error, "Technique-4 width-64 row route moved away from the general route"
.assert T4TextureSamplePowerOfTwoRowShift1 = TextureSamplePowerOfTwoRowShift1, error, "Technique-4 width-32 row route moved away from the general route"
.assert T4TextureSamplePowerOfTwoRowReady = TextureSamplePowerOfTwoRowReady, error, "Technique-4 width-16 row route moved away from the general route"
.assert * - T4TextureSampleAbsolutePowerOfTwoSingleBankRegisters <= GSU_T4_SAMPLE_CODE_CAPACITY, error, "Technique-4 sampler exceeds the general power-of-two sampler window"
.assert * <= TextureLightmapInteriorSpanLoop, error, "Technique-4 sampler overlaps the lightmap interior loop"

T4TextureLightmapInteriorSpanLoop:
        move    R8, R5
        move    R9, R6
        jal     TextureSampleAbsolutePowerOfTwoSingleBankRegisters
        move    R12, R0
        GSU_ABSOLUTE_GOTO LightmapSampleInteriorDirect, shared_delay
        with    R8
.assert T4TextureLightmapInteriorSpanLoop = TextureLightmapInteriorSpanLoop, error, "T4 interior continuation moved"
.assert * - T4TextureLightmapBilinearSpanLoop = GSU_T4_SAMPLE_CODE_CAPACITY, error, "T4 material payload changed"
.assert * = TextureBuildCoordinateLoop - 1, error, "T4 material payload overlaps DDA prefix"

.segment "GSU_T4_SAMPLE_SELECT_PATCH"

T4TextureSelectPowerOfTwoStatePatch:
        GSU_ABSOLUTE_GOTO T4TextureSelectPowerOfTwoStateReady

.assert T4TextureSelectPowerOfTwoStatePatch = TextureSelectPowerOfTwoStateReady, error, "Technique-4 sampler selector patch moved away from the general selector suffix"
.assert * - T4TextureSelectPowerOfTwoStatePatch <= GSU_T4_SAMPLE_SELECT_CAPACITY, error, "Technique-4 sampler selector patch exceeds the general selector suffix"
.assert * <= TexturePreparePowerOfTwoSamplerState, error, "Technique-4 sampler selector patch overlaps sampler-state preparation"

.segment "GSU_T4_SAMPLE_AUX_CODE"

T4TextureSelectPowerOfTwoStateReady:
        GSU_ABSOLUTE_GOTO T4RestorePower2SamplerThunk
        .res 2, $01
T4PublishPowerOfTwoStateReady:
        T4_PUBLISH_LIGHTMAP_ROUTES
        ret
        nop

T4TextureSampleWrapSGeneric:
        lm      R1, (TEXTURE_WIDTH_Q4)
        ; Unsigned S below the positive extent is already wrapped. This
        ; subtraction also produces the ordinary failed trial in R0.
        from    R5
        sub     R1
        bcc     T4TextureSampleWrapSDone
        nop
        ; Eight periods fit in a signed trial for extents below 4096.
        ; Leave other widths to the original one-period correction.
        iwt     R4, #4096
        from    R1
        cmp     R4
        bcs     T4TextureSampleWrapSFine
        nop
        from    R1
        add     R1
        add     R0
        to      R4
        add     R0
        moves   R5, R5
        bpl     T4TextureSampleWrapSCoarseSubtract
        nop
T4TextureSampleWrapSCoarseAdd:
        with    R5
        add     R4
        bmi     T4TextureSampleWrapSCoarseAdd
        nop
        with    R5
        sub     R4
T4TextureSampleWrapSFine:
        moves   R5, R5
        bpl     T4TextureSampleWrapSHigh
        nop
T4TextureSampleWrapSAdd:
        with    R5
        add     R1
        bmi     T4TextureSampleWrapSAdd
        nop
T4TextureSampleWrapSHigh:
        move    R0, R5
T4TextureSampleWrapSSubtract:
        sub     R1
        bmi     T4TextureSampleWrapSDone
        nop
        move    R5, R0
        bra     T4TextureSampleWrapSSubtract
        nop
T4TextureSampleWrapSDone:
        GSU_ABSOLUTE_GOTO T4TextureSampleAbsoluteSDone
T4TextureSampleWrapSCoarseSubtract:
        with    R5
        sub     R4
        bpl     T4TextureSampleWrapSCoarseSubtract
        nop
        with    R5
        add     R4
        bra     T4TextureSampleWrapSHigh
        nop
        .res $46 - (* - T4TextureSampleWrapSGeneric), $01
T4TextureSampleWrapSEnd:

; Face admission proves S is power-of-two and the ordinary texture fits
; one ROM bank. Keep exact signed T correction while retaining the caller's
; lightmap cache; R8/R9 coordinates and R7/R10/R11/R13 stay live across sampling.
T4TextureSampleMixedPowerOfTwoSingleBank:
        lm      R1, (TEXTURE_WRAP_MASK_S)
        with    R5
        and     R1
        ; T correction never changes R1. One height load covers both loops,
        ; including signed coordinates that require repeated wrapping.
        lm      R1, (TEXTURE_HEIGHT_Q4)
T4TextureSampleMixedTNegative:
        moves   R6, R6
        bpl     T4TextureSampleMixedTHigh
        nop
T4TextureSampleMixedTAdd:
        with    R6
        add     R1
        bmi     T4TextureSampleMixedTAdd
        nop
T4TextureSampleMixedTHigh:
        move    R0, R6
T4TextureSampleMixedTSubtract:
        with    R0
        sub     R1
        bmi     T4TextureSampleMixedTDone
        nop
        move    R6, R0
        bra     T4TextureSampleMixedTSubtract
        nop
T4TextureSampleMixedTDone:
        ; Only the final shift writes the caller's coordinate register.
        ; Each ordinary LSR resets its prefixes and continues through R0.
        from    R5
        lsr
        lsr
        lsr
        to      R5
        lsr
        from    R6
        lsr
        lsr
        lsr
        to      R6
        lsr
        lm      R1, (TEXTURE_WIDTH)
        from    R6
        umult   R1
        add     R5
        lm      R4, (TEXTURE_ROM_ADDRESS)
        add     R4
        GSU_SET_ROM_BUFFER_ADDRESS R0
        jmp     R11
        getb
        .res 4, $01
  .repeat 3
        nop
  .endrepeat
T4TextureSampleMixedEnd:
.assert .loword(T4TextureSampleMixedPowerOfTwoSingleBank) = $F93B, lderror, "Mixed sampler moved away from the auxiliary prefix"
.assert T4TextureSampleMixedEnd - T4TextureSampleMixedPowerOfTwoSingleBank = 64, error, "Mixed sampler changed its bounded footprint"

; Face admission published this route only for mixed ordinary axes. Negative
; FAST already proves the full world block stays within the lightmap bounds;
; T4 block setup initialized R7 to the existing texel-to-plot continuation.
T4MixedInteriorSpanLoop:
.assert .loword(T4MixedInteriorSpanLoop) = $F97B, lderror, "Mixed interior continuation moved away from the auxiliary sampler"
        move    R8, R5
        move    R9, R6
        jal     T4TextureSampleMixedPowerOfTwoSingleBank
        move    R12, R0
        GSU_ABSOLUTE_GOTO LightmapSampleInteriorDirect, shared_delay
        with    R8

; Only T4 faces too tall for the existing 92-row arena enter this lifecycle.
; Replaying a chunk consumes the endpoint stream before the next is staged,
; so the existing fixed arenas and exact per-row interpolation stay intact.
T4LightmapChunkBegin:
        lm      R1, (CONVEX_TOP_PTR)
        sm      (T4_LIGHTMAP_CHUNK_FINAL_Y), R1
        move    R0, #1
        sm      (T4_LIGHTMAP_CHUNK_ACTIVE), R0
        GSU_ABSOLUTE_GOTO T4LightmapChunkSetTop
T4LightmapChunkSetTop:
        lm      R0, (CONVEX_RASTER_Y)
        iwt     R1, #GSU_LIGHTMAP_TALL_CHUNK_ROWS-1
        with    R0
        add     R1
        lm      R1, (T4_LIGHTMAP_CHUNK_FINAL_Y)
        cmp     R1
        bcc     T4LightmapChunkTopReady
        nop
        move    R0, R1
T4LightmapChunkTopReady:
        sm      (CONVEX_TOP_PTR), R0
        GSU_ABSOLUTE_GOTO T4LightmapStageBegin
T4LightmapChunkResume:
        lm      R0, (T4_LIGHTMAP_CHUNK_ACTIVE)
        moves   R0, R0
        bne     T4LightmapChunkActive
        nop
        GSU_ABSOLUTE_GOTO T4LightmapRasterReturn
T4LightmapChunkActive:
        ; ReplayNext advanced Y exactly once beyond the last staged row.
        lm      R0, (CONVEX_RASTER_Y)
        lm      R1, (T4_LIGHTMAP_CHUNK_FINAL_Y)
        cmp     R1
        bcc     T4LightmapChunkMore
        nop
        beq     T4LightmapChunkMore
        nop
        sm      (CONVEX_TOP_PTR), R1
        move    R0, #0
        sm      (T4_LIGHTMAP_CHUNK_ACTIVE), R0
        GSU_ABSOLUTE_GOTO T4LightmapRasterReturn
T4LightmapChunkMore:
        lm      R0, (T4_LIGHTMAP_CHUNK_FORWARD_PTR)
        sm      (CONVEX_FORWARD_PTR), R0
        lm      R0, (T4_LIGHTMAP_CHUNK_REVERSE_PTR)
        sm      (CONVEX_REVERSE_PTR), R0
        GSU_ABSOLUTE_GOTO T4LightmapChunkSetTop
T4LightmapChunkAbort:
        ; A zero raw-row count or invalid handler already terminated the old
        ; whole-face path. Restore temporary bounds without retrying a chunk.
        lm      R0, (T4_LIGHTMAP_CHUNK_ACTIVE)
        moves   R0, R0
        beq     T4LightmapChunkAbortReturn
        nop
        lm      R1, (T4_LIGHTMAP_CHUNK_FINAL_Y)
        sm      (CONVEX_TOP_PTR), R1
        move    R0, #0
        sm      (T4_LIGHTMAP_CHUNK_ACTIVE), R0
T4LightmapChunkAbortReturn:
        GSU_ABSOLUTE_GOTO T4LightmapRasterReturn

.assert .loword(T4TextureSelectPowerOfTwoStateReady) = GSU_T4_SAMPLE_AUX_OFFSET, error, "Technique-4 sampler auxiliaries moved away from their overlay window"
.assert * - T4TextureSelectPowerOfTwoStateReady <= GSU_T4_SAMPLE_AUX_CAPACITY, error, "Technique-4 sampler auxiliaries exceed the projective-albedo span window"
.assert * <= TextureDivideQ12EdgeCached, error, "Technique-4 sampler auxiliaries overlap shared divide code"

; This code pointer names the currently owned 76-byte sampler and interior slot.
T4TextureSampleMixedResident = T4TextureLightmapBilinearSpanLoop
T4MixedResidentInteriorSpanLoop = TextureLightmapInteriorSpanLoop
