; Prepare one dynamic-brush arbitration row exactly once, then replay its
; immutable span endpoints. This auxiliary helper is used only by technique 4;
; other render modes and oversized arbitrary fly-camera rows retain the
; original metadata scan and depth arbiter.

.segment "GSU_LIGHTMAP_UNPACK_ROM_CODE"

; World and brush loaders share this ROM36-tail cache kernel. R7 carries the
; group-aligned physical bank; R12, R10, and R14 carry logical count,
; destination, and packed source. Once CACHE fills, ROMB may safely select the
; sample bank without competing with program fetches.
GSU_CACHE_KERNEL_BEGIN TextureUnpackLightmapSamplesROM
  .ifdef PLAYABLE_SWITCHED_LIGHTS
        move    R0, R7
        add     #2                   ; Signed $FE marks a switchable grid.
        bne     SwitchedGridResident
        nop
        iwt     R0, #$4000
        sm      (LIGHTMAP_ROM_BANK), R0
        stop                         ; R14=source, R10=destination, R12=count.
        nop
        .export SwitchedGridResume:far, SwitchedGridRequest:far, SwitchedGridResident:far
SwitchedGridRequest = $710000 + LIGHTMAP_ROM_BANK
SwitchedGridResume:
        move    R0, #0
        sm      (LIGHTMAP_ROM_BANK), R0
        move    R12, #0
        GSU_ABSOLUTE_GOTO TextureUnpackLightmapDone
SwitchedGridResident:
  .endif
.ifdef PLAYABLE_RESIDENT_NIBBLE_LIGHTMAPS
        from    R7
        hib
        beq     @SixBit
        nop
        GSU_ABSOLUTE_GOTO TextureUnpackNibbleLightmapROM
@SixBit:
.endif
        move    R0, R7
        sm      (LIGHTMAP_ROM_BANK), R0
        romb
        ; R14 was armed while ROMB still selected the directory bank. Re-arm
        ; the same address after selecting the sample bank so the first GETB
        ; cannot consume that stale buffer byte.
        GSU_SET_ROM_BUFFER_ADDRESS R14
        BSP_UNPACK_LIGHTMAP_SAMPLES
TextureUnpackLightmapDone:
.if .defined(PLAYABLE_PAIRED_WORLD_CODE) && (BSP_RENDER_SCALE = 2)
        ; A freshly decoded grid invalidates its paired suffix. R12 is zero.
        sm      (TEXTURE_SIGN_SHADE), R12
.endif
        move    R11, #$70
        from    R13
        ljmp    R11
        nop
GSU_CACHE_KERNEL_END TextureUnpackLightmapSamplesROM

.ifdef PLAYABLE_RESIDENT_NIBBLE_LIGHTMAPS
GSU_CACHE_KERNEL_BEGIN TextureUnpackNibbleLightmapROM
        from    R7
        lob
        sm      (LIGHTMAP_ROM_BANK), R0
        romb
        GSU_SET_ROM_BUFFER_ADDRESS R14
        BSP_ROM_LOAD_BYTE R5
        from    R5
        swap
        or      R5
        move    R5, R0
        ibt     R1, #$0F
        iwt     R2, #$FF00
        ibt     R3, #16
        from    R12
        to      R4
        and     #1
        with    R12
        lsr
        beq     @Tail
        nop
@Pair:
        BSP_ROM_LOAD_BYTE R6
        from    R6
        and     R1
        move    R11, R0
        from    R6
        umult   R3
        and     R2
        or      R11
        add     R5
        movew   (R10), R0
        inc     R10
        inc     R10
        dec     R12
        bne     @Pair
        nop
@Tail:
        moves   R4, R4
        beq     @Return
        nop
        BSP_ROM_LOAD_BYTE R0
        and     R1
        add     R5
        moveb   (R10), R0
@Return:
  .if .defined(PLAYABLE_PAIRED_WORLD_CODE) && (BSP_RENDER_SCALE = 2)
        sm      (TEXTURE_SIGN_SHADE), R12
  .endif
        move    R11, #$70
        from    R13
        ljmp    R11
        nop
GSU_CACHE_KERNEL_END TextureUnpackNibbleLightmapROM
.endif

.segment "GSU_AUX_CODE"

BRUSH_ARB_STAGE_RETURN        = BRUSH_ARB_ROW_STAGE_MODE
BRUSH_ARB_STAGE_CURSOR        = BRUSH_ARB_PREPASS_CURSOR
BRUSH_ARB_STAGE_REMAINING     = BRUSH_ARB_PREPASS_REMAINING
BRUSH_ARB_STAGE_WRITE_PTR     = BRUSH_ARB_POOL_CURSOR
BRUSH_ARB_STAGE_CONTESTED     = BRUSH_ARB_LIGHTMAP_REF
BRUSH_DIRECT_RETURN           = BRUSH_STATIC_RETURN

BRUSH_ARB_STAGE_META          = 0
BRUSH_ARB_STAGE_PACKED_X      = 2
BRUSH_ARB_STAGE_MIN_X         = 4
BRUSH_ARB_STAGE_MAX_X         = 6
BRUSH_ARB_STAGE_LEFT_S        = 8
BRUSH_ARB_STAGE_RIGHT_S       = 10
BRUSH_ARB_STAGE_LEFT_T        = 12
BRUSH_ARB_STAGE_RIGHT_T       = 14
BRUSH_ARB_STAGE_LEFT_DEPTH    = 16
BRUSH_ARB_STAGE_RIGHT_DEPTH   = 18
BRUSH_ARB_STAGE_VALID         = $8000

.assert BRUSH_ARB_STAGE_RIGHT_DEPTH + 2 = GSU_BRUSH_ROW_STAGE_RECORD_BYTES, error, "Brush row stage layout changed"

; Publish a lit, non-missing lightmap base adjusted by its signed minimum block
; coordinates. The dominant sampler can then use absolute block S/T directly.
; Cold material loaders call this once; it preserves no registers except R7.
LightmapPublishAdjustedAddress:
        lm      R0, (LIGHTMAP_MIN_BLOCK_T)
        lm      R6, (LIGHTMAP_WIDTH)
        with    R0
        mult    R6
        lm      R1, (LIGHTMAP_MIN_BLOCK_S)
        with    R0
        add     R1
        lm      R1, (LIGHTMAP_ROM_ADDRESS)
        with    R1
        sub     R0
        sm      (LIGHTMAP_ADJUSTED_ADDRESS), R1
        ret
        nop

; Resolve the current ordered row's generated byte-exact direct-render proof
; in cold ROM. The caller stays two instructions in the saturated brush code.
; Cold direct-proof helpers live in DynamicBrushCachedSpan.sgs.

.segment "GSU_AUX_CODE"

BrushCallExternalROM:
        sm      (BRUSH_LOAD_RETURN), R11
        move    R9, #BSP_GSU_ROM2_BANK
        from    R8
        ljmp    R9
        nop

BrushArbiterDirectGroup:
        lm      R0, (BRUSH_TOKEN_CURSOR)
        inc     R0
        sm      (BRUSH_TOKEN_CURSOR), R0
BrushArbiterDirectLoop:
        lm      R0, (BRUSH_TOKEN_CURSOR)
        lm      R1, (BRUSH_TOKEN_COUNT)
        with    R0
        cmp     R1
        beq     BrushArbiterDirectDone
        nop
        move    R1, R0
        with    R1
        add     R1
        iwt     R10, #BRUSH_TOKENS
        with    R10
        add     R1
        movew   R0, (R10)
        moves   R0, R0
        bpl     BrushArbiterDirectDone
        nop
        iwt     R1, #$03FF
        with    R0
        and     R1
        sm      (BRUSH_CURRENT_LINK), R0
        jal     BrushRenderFragment
        nop
        lm      R0, (BRUSH_TOKEN_CURSOR)
        inc     R0
        sm      (BRUSH_TOKEN_CURSOR), R0
        GSU_ABSOLUTE_GOTO BrushArbiterDirectLoop
BrushArbiterDirectDone:
        GSU_ABSOLUTE_GOTO BrushArbiterDone

; Rare exact depth fallback for singleton spans and clipped edge clamps.
BrushArbiterDepthLegacy:
        lm      R0, (TEXTURE_SPAN_X)
        BSP_SCALE_LOGICAL_TO_Q7 R0
        iwt     R1, #64
        with    R0
        add     R1
        lm      R1, (CONVEX_MIN_X)
        with    R0
        sub     R1
        bpl     BrushArbiterDepthNumeratorPositive
        nop
        move    R0, #0
BrushArbiterDepthNumeratorPositive:
        lm      R2, (BRUSH_ARBITER_SCREEN_DEN)
        moves   R2, R2
        bne     BrushArbiterDepthDenominatorReady
        nop
        move    R3, #0
        bra     BrushArbiterDepthScreenFactorReady
        nop
BrushArbiterDepthDenominatorReady:
        move    R4, R0
        with    R4
        sub     R2
        bmi     BrushArbiterDepthScreenDivide
        nop
        iwt     R3, #4096
        bra     BrushArbiterDepthScreenFactorReady
        nop
BrushArbiterDepthScreenDivide:
        jal     TextureDivideQ12Prepared
BrushArbiterDepthScreenFactorReady:
        jal     TexturePerspectiveFactorQ12
        BSP_SIGNED_MUL_UNIT_FACTOR_TRUNC12 R7, R3
        with    R5
        add     R0
        GSU_ABSOLUTE_GOTO BrushArbiterSpanDepthReady

; Return mode one for a contested row or two when every inclusive logical span
; is disjoint. The stage covers the complete generated 72-fragment bound.
BrushArbiterStageCurrentRow:
        sm      (BRUSH_ARB_STAGE_RETURN), R11

        iwt     R0, #GSU_BRUSH_ROW_STAGE_OFFSET
        sm      (BRUSH_ARB_STAGE_WRITE_PTR), R0
        move    R0, #0
        sm      (BRUSH_ARB_STAGE_COUNT), R0
        sm      (BRUSH_ARB_STAGE_CONTESTED), R0
        ; The ROM filter completes all immutable Y tests before this pass
        ; performs any edge math. R10/R12 return its list cursor/count.
        move    R11, #BSP_LIGHTMAP_UNPACK_ROM_BANK
        iwt     R0, #.loword(BrushArbiterFilterRowROM)
        from    R0
        ljmp    R11
        nop

BrushArbiterStageCandidateLoop:
        moves   R12, R12
        bne     BrushArbiterStageCandidatePresent
        nop
        GSU_ABSOLUTE_GOTO BrushArbiterStageComplete
BrushArbiterStageCandidatePresent:
        movew   R0, (R10)
        sm      (BRUSH_ARB_STAGE_CURSOR), R10
        sm      (BRUSH_ARB_STAGE_REMAINING), R12
        sm      (BRUSH_ARB_CANDIDATE_CURSOR), R0
        jal     BrushArbiterPrepareCandidateSpan
        nop
        moves   R0, R0
        bne     BrushArbiterStageSpanPresent
        nop
        ; Do not publish empty horizontal clips. Besides shrinking contested
        ; sorts, this removes their otherwise-useless staged replay in every
        ; technique-4 row.
        GSU_ABSOLUTE_GOTO BrushArbiterStageCandidateAdvance

BrushArbiterStageSpanPresent:
        lm      R10, (BRUSH_ARB_STAGE_WRITE_PTR)
        lm      R1, (BRUSH_ARB_CANDIDATE_CURSOR)
        movew   (R10), R1
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_SPAN_END_X)
        with    R0
        swap
        lm      R1, (TEXTURE_SPAN_X)
        with    R0
        or      R1
        iwt     R1, #BRUSH_ARB_STAGE_VALID
        with    R0
        or      R1
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (CONVEX_MIN_X)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (CONVEX_MAX_X)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_LEFT_S)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_RIGHT_S)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_LEFT_T)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_RIGHT_T)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_LEFT_SHADE)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_RIGHT_SHADE)
        movew   (R10), R0

        ; Once one overlap is known the row remains contested. Otherwise scan
        ; the prior staged inclusive intervals; equality is an overlap.
        lm      R0, (BRUSH_ARB_STAGE_CONTESTED)
        moves   R0, R0
        bne     BrushArbiterStageRecordReady
        nop
        lm      R12, (BRUSH_ARB_STAGE_COUNT)
        moves   R12, R12
        beq     BrushArbiterStageRecordReady
        nop
        iwt     R9, #GSU_BRUSH_ROW_STAGE_OFFSET
BrushArbiterStageOverlapLoop:
        inc     R9
        inc     R9
        movew   R0, (R9)
        moves   R0, R0
        bpl     BrushArbiterStageOverlapAdvance
        nop
        move    R3, R0
        with    R3
        lob
        with    R0
        hib
        iwt     R1, #$007F
        with    R0
        and     R1
        lm      R1, (TEXTURE_SPAN_END_X)
        with    R1
        cmp     R3
        bcc     BrushArbiterStageOverlapAdvance
        nop
        lm      R1, (TEXTURE_SPAN_X)
        with    R0
        cmp     R1
        bcc     BrushArbiterStageOverlapAdvance
        nop
        move    R0, #1
        sm      (BRUSH_ARB_STAGE_CONTESTED), R0
        bra     BrushArbiterStageRecordReady
        nop
BrushArbiterStageOverlapAdvance:
        with    R9
        add     #8
        with    R9
        add     #8
        with    R9
        add     #2
        dec     R12
        bne     BrushArbiterStageOverlapLoop
        nop

BrushArbiterStageRecordReady:
        ; The last record word leaves R10 at +18; overlap scans preserve it.
        inc     R10
        inc     R10
        sm      (BRUSH_ARB_STAGE_WRITE_PTR), R10
        lm      R0, (BRUSH_ARB_STAGE_COUNT)
        inc     R0
        sm      (BRUSH_ARB_STAGE_COUNT), R0

BrushArbiterStageCandidateAdvance:
        lm      R10, (BRUSH_ARB_STAGE_CURSOR)
        lm      R12, (BRUSH_ARB_STAGE_REMAINING)
BrushArbiterStageMetadataAdvance:
        inc     R10
        inc     R10
        dec     R12
        GSU_ABSOLUTE_GOTO BrushArbiterStageCandidateLoop

BrushArbiterStageComplete:
        iwt     R0, #GSU_BRUSH_ROW_STAGE_OFFSET
        sm      (BRUSH_ARB_STAGE_CURSOR), R0
        lm      R0, (BRUSH_ARB_STAGE_COUNT)
        sm      (BRUSH_ARB_STAGE_REMAINING), R0
        lm      R0, (BRUSH_ARB_STAGE_CONTESTED)
        moves   R0, R0
        bne     BrushArbiterStageContested
        nop
        move    R0, #2
        bra     BrushArbiterStageReturn
        nop
BrushArbiterStageContested:
        jal     BrushArbiterSortStagedRow
        nop
        move    R0, #1
BrushArbiterStageReturn:
        lm      R11, (BRUSH_ARB_STAGE_RETURN)
        ret
        nop
        ; Retain every later auxiliary helper and overlay address. Padding is
        ; beyond RET's mandatory delay slot and never executes.
.ifdef PLAYABLE_COMPACT_Q12_RECIPROCALS
; R1 is the index in the low-word-only tail. Its doubled high bit
; selects the second tail bank. Continue through the caller's R10.
TextureDivideQ12PackedTail:
        inc     R0
        with    R1
        add     R1
        bpl     @BankReady
        nop
        inc     R0
@BankReady:
        romb
        iwt     R4, #GSU_DIVIDE_Q12_RECIPROCAL_ROM_ADDRESS
        with    R4
        or      R1
        GSU_SET_ROM_BUFFER_ADDRESS R4
        move    R12, #0
        BSP_ROM_LOAD_WORD R13
        jmp     R10
        nop
.endif
.assert * - BrushArbiterStageCurrentRow <= $166, error, "Brush row staging exceeds its pinned slot"
        .res $166 - (* - BrushArbiterStageCurrentRow), $01

; Publish one immutable prepared record into the standard span globals, then
; join the retained material and composition path in the selected replay order.
BrushArbiterLoadStagedCandidate:
        lm      R0, (BRUSH_ARB_STAGE_REMAINING)
        moves   R0, R0
        bne     BrushArbiterStagedCandidatePresent
        nop
        GSU_ABSOLUTE_GOTO BrushArbiterRowDone
BrushArbiterStagedCandidatePresent:
        lm      R10, (BRUSH_ARB_STAGE_CURSOR)
        movew   R0, (R10)
        sm      (BRUSH_ARB_CANDIDATE_CURSOR), R0
        inc     R10
        inc     R10
        movew   R0, (R10)
        moves   R0, R0
        bpl     BrushArbiterAdvanceStagedCandidate
        nop
        move    R1, R0
        with    R1
        lob
        sm      (TEXTURE_SPAN_X), R1
        with    R0
        hib
        iwt     R1, #$007F
        with    R0
        and     R1
        sm      (TEXTURE_SPAN_END_X), R0
        inc     R10
        inc     R10
        movew   R0, (R10)
        sm      (CONVEX_MIN_X), R0
        inc     R10
        inc     R10
        movew   R0, (R10)
        sm      (CONVEX_MAX_X), R0
        inc     R10
        inc     R10
        movew   R0, (R10)
        sm      (TEXTURE_LEFT_S), R0
        inc     R10
        inc     R10
        movew   R0, (R10)
        sm      (TEXTURE_RIGHT_S), R0
        inc     R10
        inc     R10
        movew   R0, (R10)
        sm      (TEXTURE_LEFT_T), R0
        inc     R10
        inc     R10
        movew   R0, (R10)
        sm      (TEXTURE_RIGHT_T), R0
        inc     R10
        inc     R10
        movew   R0, (R10)
        sm      (TEXTURE_LEFT_SHADE), R0
        inc     R10
        inc     R10
        movew   R0, (R10)
        sm      (TEXTURE_RIGHT_SHADE), R0
        GSU_ABSOLUTE_GOTO BrushArbiterCandidateSpanPresent

BrushArbiterAdvanceStagedCandidate:
        lm      R0, (BRUSH_ARB_STAGE_CURSOR)
        with    R0
        add     #10
        with    R0
        add     #10
        sm      (BRUSH_ARB_STAGE_CURSOR), R0
        lm      R0, (BRUSH_ARB_STAGE_REMAINING)
        dec     R0
        sm      (BRUSH_ARB_STAGE_REMAINING), R0
        GSU_ABSOLUTE_GOTO BrushArbiterLoadStagedCandidate

; Stable near-to-far bubble sort for the rare contested technique-4 row.
; The farther endpoint is a conservative cheap key; equal keys retain the
; generator's exact authority order. The complete 20-byte prepared records are
; swapped in place, leaving disjoint-row loading and iteration untouched.
BrushArbiterSortStagedRow:
        cache
        lm      R7, (BRUSH_ARB_STAGE_COUNT)
        dec     R7
        beq     BrushArbiterSortStagedDone
        nop
BrushArbiterSortStagedPass:
        iwt     R10, #GSU_BRUSH_ROW_STAGE_OFFSET
        iwt     R9, #GSU_BRUSH_ROW_STAGE_OFFSET+GSU_BRUSH_ROW_STAGE_RECORD_BYTES
        move    R8, R7
        move    R6, R10
        with    R6
        add     #8
        with    R6
        add     #8
        movew   R4, (R6)
        inc     R6
        inc     R6
        movew   R5, (R6)
        with    R4
        cmp     R5
        bcs     BrushArbiterSortStagedLeftKeyReady
        nop
        move    R4, R5
BrushArbiterSortStagedLeftKeyReady:
BrushArbiterSortStagedInner:
        move    R6, R9
        with    R6
        add     #8
        with    R6
        add     #8
        movew   R5, (R6)
        inc     R6
        inc     R6
        movew   R0, (R6)
        with    R5
        cmp     R0
        bcs     BrushArbiterSortStagedRightKeyReady
        nop
        move    R5, R0
BrushArbiterSortStagedRightKeyReady:
        with    R4
        cmp     R5
        bcc     BrushArbiterSortStagedOrdered
        nop
        beq     BrushArbiterSortStagedOrdered
        nop
        move    R12, #10
        iwt     R13, #BrushArbiterSortStagedSwapLoop
BrushArbiterSortStagedSwapLoop:
        movew   R0, (R10)
        movew   R1, (R9)
        movew   (R10), R1
        movew   (R9), R0
        inc     R10
        inc     R10
        inc     R9
        inc     R9
        loop
        nop
        bra     BrushArbiterSortStagedPairReady
        nop
BrushArbiterSortStagedOrdered:
        move    R4, R5
        move    R10, R9
        with    R9
        add     #10
        with    R9
        add     #10
BrushArbiterSortStagedPairReady:
        dec     R8
        bne     BrushArbiterSortStagedInner
        nop
        dec     R7
        bne     BrushArbiterSortStagedPass
        nop
BrushArbiterSortStagedDone:
        ret
        nop
BrushArbiterSortStagedEnd:
.assert .loword(BrushArbiterSortStagedEnd) <= (.loword(BrushArbiterSortStagedRow) & $FFF0) + GSU_CACHE_BYTES, lderror, "Staged brush sort leaves its entry cache window"
.assert .bankbyte(BrushArbiterSortStagedEnd-1) = .bankbyte(BrushArbiterSortStagedRow), lderror, "Staged brush sort crosses its code bank"

.if .defined(GSU_PLATFORM_HEIGHTS) && !.defined(QC_SECRET_DOOR_COUNT)
.include "BrushResolveMoverVertex.sgs"
.endif
.assert * - BrushArbiterSortStagedRow <= $B7, error, "Brush sort exceeds its pinned slot"
.res $B7 - (* - BrushArbiterSortStagedRow), $01

.assert * - TexturePrepareFaceEndpointBatch <= GSU_AUX_CODE_CAPACITY, error, "Auxiliary GSU helpers exceed their staged overlay"

.segment "GSU_SKY_ROM_CODE"

BrushLoadDirectSafetyROM:
        move    R0, #0
        sm      (BRUSH_DIRECT_SAFE), R0
.if BSP_RENDER_SCALE = 2
        ; This camera-bound painter/depth equality proof was generated for
        ; the X2 raster. X3 rounding can make adjacent faces share a pixel
        ; with another depth/tie winner, even at unity focal. Keep X3 on its
        ; exact arbiter until a proof binds the actual viewport and focal.
        lm      R0, (BRUSH_OVERLAY_FLAGS)
        move    R1, #BSP_OVERLAY_EXTERNAL_BSP
        with    R0
        and     R1
        beq     BrushLoadDirectSafetyDone
        nop
        lm      R0, (BRUSH_OVERLAY_FLAGS)
        with    R0
        and     #BSP_OVERLAY_FLY_STATICS
        bne     BrushLoadDirectSafetyDone
        nop
        lm      R0, (ALIAS_VISIBILITY_SOURCE_ROW)
        iwt     R1, #BSP_BRUSH_REPLAY_ROW_COUNT
        with    R0
        cmp     R1
        bcs     BrushLoadDirectSafetyDone
        nop
        move    R1, R0
        with    R1
        and     #7
  .repeat 3
        with    R0
        lsr
  .endrepeat
        iwt     R4, #BSP_BRUSH_DIRECT_ADDRESS
        with    R4
        add     R0
        move    R0, #BSP_BRUSH_DIRECT_BANK
        romb
        GSU_SET_ROM_BUFFER_ADDRESS R4
        BSP_ROM_LOAD_BYTE R0
        move    R2, #1
BrushLoadDirectSafetyBitLoop:
        moves   R1, R1
        beq     BrushLoadDirectSafetyBitReady
        nop
        with    R2
        add     R2
        dec     R1
        bra     BrushLoadDirectSafetyBitLoop
        nop
BrushLoadDirectSafetyBitReady:
        with    R0
        and     R2
        beq     BrushLoadDirectSafetyDone
        nop
        move    R0, #1
        sm      (BRUSH_DIRECT_SAFE), R0
.endif
BrushLoadDirectSafetyDone:
        lm      R8, (BRUSH_DIRECT_RETURN)
        move    R9, #$70
        from    R8
        ljmp    R9
        nop

BrushLoadExternalActiveROM:
        lm      R0, (COMMAND+14)
.if BSP_QUAKEC_GAMEPLAY
        sm      (BRUSH_EXTERNAL_ACTIVE_LO), R0
.ifdef QC_MEGA_COUNT
        lm      R0, (GSU_PICKUP_MASK_HIGH)
.else
        move    R0, #0
.endif
        sm      (BRUSH_EXTERNAL_ACTIVE_HI), R0
        move    R0, #1
.else
        iwt     R1, #BSP_BRUSH_REPLAY_ROW_COUNT
        with    R0
        cmp     R1
        bcs     BrushLoadExternalActiveMissing
        nop
        move    R1, R0
        with    R0
        add     R0
        with    R0
        add     R1
        iwt     R4, #BSP_BRUSH_XACTIVE_ADDRESS
        with    R4
        add     R0
        move    R0, #BSP_BRUSH_XACTIVE_BANK
        romb
        GSU_SET_ROM_BUFFER_ADDRESS R4
        BSP_ROM_LOAD_WORD R0
        sm      (BRUSH_EXTERNAL_ACTIVE_LO), R0
        BSP_ROM_LOAD_BYTE R0
        sm      (BRUSH_EXTERNAL_ACTIVE_HI), R0
        move    R0, #1
        bra     BrushLoadExternalActiveDone
        nop
BrushLoadExternalActiveMissing:
        move    R0, #0
.endif
BrushLoadExternalActiveDone:
        lm      R8, (BRUSH_LOAD_RETURN)
        move    R9, #$70
        from    R8
        ljmp    R9
        nop

BrushFindExternalStaticROM:
        lm      R0, (BRUSH_TRANSFORM_CURSOR)
        iwt     R1, #BSP_BRUSH_XSTATIC_COUNT
        with    R0
        cmp     R1
        beq     BrushFindExternalStaticMissing
        nop
        lm      R0, (BRUSH_EXTERNAL_ACTIVE_LO)
        with    R0
        and     #1
        beq     BrushFindExternalStaticAdvance
        nop
        lm      R1, (BRUSH_TRANSFORM_CURSOR)
        move    R2, R1
  .repeat 2
        with    R1
        add     R1
  .endrepeat
        with    R1
        add     R2
        iwt     R4, #BSP_BRUSH_XSTATIC_ADDRESS
        with    R4
        add     R1
        move    R0, #BSP_BRUSH_XSTATIC_BANK
        romb
        GSU_SET_ROM_BUFFER_ADDRESS R4
        BSP_ROM_LOAD_WORD R0
        sm      (BRUSH_CURRENT_ENTITY), R0
        BSP_ROM_LOAD_WORD R0
        sm      (BRUSH_CURRENT_GEOMETRY_VARIANT), R0
        BSP_ROM_LOAD_BYTE R0
        sm      (BRUSH_CURRENT_SLOT), R0
        move    R3, #1
        bra     BrushFindExternalStaticShift
        nop
BrushFindExternalStaticAdvance:
        move    R3, #0
BrushFindExternalStaticShift:
        lm      R0, (BRUSH_EXTERNAL_ACTIVE_HI)
        with    R0
        lsr
        sm      (BRUSH_EXTERNAL_ACTIVE_HI), R0
        lm      R0, (BRUSH_EXTERNAL_ACTIVE_LO)
        with    R0
        ror
        sm      (BRUSH_EXTERNAL_ACTIVE_LO), R0
        lm      R0, (BRUSH_TRANSFORM_CURSOR)
        inc     R0
        sm      (BRUSH_TRANSFORM_CURSOR), R0
        moves   R3, R3
        beq     BrushFindExternalStaticROM
        nop
        move    R0, #1
        GSU_ABSOLUTE_GOTO BrushLoadExternalActiveDone
BrushFindExternalStaticMissing:
        move    R0, #0
        GSU_ABSOLUTE_GOTO BrushLoadExternalActiveDone
