; Cold alias-billboard helpers stored in the two hidden 8bpp tile rows.
;
; Flat expansion overwrites this tail and the S-CPU restores it together with
; the textured Q12 phase overlay. Opaque renderers intentionally do not clear
; the preceding visible framebuffer: closed world coverage is a hard contract.

.segment "GSU_TEXTURE_TAIL_CODE"

; R1=projected half-Q7 edge, R2=source extent, R3=projected half-Q7 span.
; Return the first pixel-center source index in R4 and its residual in R0.
; Halving the former even numerator and denominator leaves every DDA decision
; unchanged while making the largest generated sprite span fit unsigned-16.
AliasInitializeAxis:
        move    R0, #32
        with    R0
        sub     R1
        move    R5, #$3F
        with    R0
        and     R5
        with    R0
        umult   R2
        move    R4, #0
AliasInitializeAxisReduce:
        with    R0
        cmp     R3
        bcc     AliasInitializeAxisClamp
        nop
        with    R0
        sub     R3
        inc     R4
        bra     AliasInitializeAxisReduce
        nop
AliasInitializeAxisClamp:
        GSU_ABSOLUTE_GOTO AliasInitializeAxisClampCold

; Convert the signed quotient left by ConvexProjectComponent to a full raw
; pixel bound. R2=+31 for a first bound or -32 for a last bound and R10 names
; the X/Y axis record. Decompose q=64*a+r before multiplying, so neither the
; individual 3*q half-Q7 edge nor its rounding addition can overflow signed16:
; floor((3*q+round)/64) = 3*a + floor((3*r+round)/64).
AliasEndpointCoordinate:
        move    R0, R3
        move    R4, #$3F
        with    R0
        and     R4
        move    R4, R0
        with    R0
        add     R0
.if BSP_RENDER_SCALE = 2
        with    R0
        add     R4
.endif
        with    R0
        add     R2
  .repeat 6
        asr
  .endrepeat
        move    R4, R0
        move    R0, R3
  .repeat 6
        asr
  .endrepeat
        move    R3, R0
        with    R0
        add     R0
.if BSP_RENDER_SCALE = 2
        with    R0
        add     R3
.endif
        with    R0
        add     R4
.if BSP_RENDER_SCALE = 2
        iwt     R1, #(ALIAS_X_AXIS + 64)
        with    R1
        sub     R10
.else
        iwt     R1, #ALIAS_X_AXIS
        with    R1
        cmp     R10
        beq     @XAxis
        nop
        move    R1, #BSP_VIEW_CENTER_Y
        move    R2, #BSP_VIEW_HEIGHT
        bra     @CenterReady
        nop
@XAxis:
        move    R1, #BSP_VIEW_CENTER_X
        move    R2, #BSP_VIEW_WIDTH
@CenterReady:
.endif
        with    R0
        add     R1
        ret
        nop

; Large denominators miss the RAM reciprocal mirror infrequently. Keep their
; exact bank selection and ROM load cold so the repeated endpoint advance can
; remain resident in the private math window. These additions follow the
; existing tail helpers so their instruction-fetch layout remains stable.
TextureEndpointDivideHotMirrorMissCold:
        dec     R2
        move    R0, #GSU_DIVIDE_Q12_RECIPROCAL_FIRST_ROM_BANK
        move    R1, R2
        iwt     R4, #GSU_DIVIDE_Q12_RECIPROCAL_ENTRIES_PER_BANK
TextureEndpointDivideSelectBank:
        with    R1
        cmp     R4
        bcc     TextureEndpointDivideBankReady
        nop
        with    R1
        sub     R4
        inc     R0
        bra     TextureEndpointDivideSelectBank
        nop
TextureEndpointDivideBankReady:
        romb
        move    R2, R1
        with    R2
        add     R2
        with    R2
        add     R2
        iwt     R4, #GSU_DIVIDE_Q12_RECIPROCAL_ROM_ADDRESS
        with    R4
        add     R2
        GSU_SET_ROM_BUFFER_ADDRESS R4
        BSP_ROM_LOAD_WORD R12
        BSP_ROM_LOAD_WORD R13
        jmp     R10
        nop

; Cold exits reclaimed from the shared shaded-edge cache. Ordinary fly and
; specialized playback both enter the same cache-local quotient multiply;
; only their distinct unity-output ABIs remain separate here.
TextureDivideQ12EdgeCachedWindowMissCold:
        iwt     R10, #TextureDivideQ12EdgeLocalCacheFill
        lm      R13, (TEXTURE_Q12_LOOKUP_ROUTINE)
        jmp     R13
        nop
TextureDivideQ12EdgeLocalCacheFill:
        movew   (R7), R9
        inc     R7
        inc     R7
        movew   (R7), R12
        inc     R7
        inc     R7
        movew   (R7), R13
        move    R6, R12
        GSU_ABSOLUTE_GOTO TextureDivideQ12EdgeLoadedCached

TexturePerspectiveFactorUnityProductsCold:
        move    R12, R5
        lm      R7, (TEXTURE_DELTA_DEPTH)
        move    R1, R7
        GSU_ABSOLUTE_GOTO TexturePerspectiveFactorProductsReady

TextureShadeIntersectUnityAttributesCold:
        with    R5
        add     R7
        sm      (TEXTURE_EDGE_SHADE), R5
        lm      R5, (TEXTURE_BASE_S)
        lm      R0, (TEXTURE_DELTA_S)
        with    R5
        add     R0
        sm      (TEXTURE_EDGE_S), R5
        lm      R5, (TEXTURE_BASE_T)
        lm      R0, (TEXTURE_DELTA_T)
        with    R5
        add     R0
        sm      (TEXTURE_EDGE_T), R5
        GSU_ABSOLUTE_GOTO TextureShadeIntersectScreenX

T4TextureShadeIntersectUnityOutputsCold:
        with    R5
        add     R7
        move    R12, R5
        lm      R8, (TEXTURE_BASE_S)
        lm      R0, (TEXTURE_DELTA_S)
        with    R8
        add     R0
        lm      R9, (TEXTURE_BASE_T)
        lm      R0, (TEXTURE_DELTA_T)
        with    R9
        add     R0
        GSU_ABSOLUTE_GOTO TextureShadeIntersectScreenX

TextureStageLightmapRowCold:
        ; One record per logical row: raw min/max X followed by exact left and
        ; right S/T/depth. Convex rows are contiguous, so Y is reconstructed
        ; from the final raster row and the record count during replay.
        lm      R10, (TEXTURE_COORD_PTR)
        lm      R1, (CONVEX_MIN_X)
        lm      R3, (CONVEX_MAX_X)
        movew   (R10), R1
        inc     R10
        inc     R10
        movew   (R10), R3
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_LEFT_S)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_RIGHT_S)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_LEFT_T)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_RIGHT_T)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_LEFT_SHADE)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_RIGHT_SHADE)
        movew   (R10), R0
        inc     R10
        inc     R10
        sm      (TEXTURE_COORD_PTR), R10
        lm      R0, (TEXTURE_LIGHTMAP_FAST_ROUTINE)
        inc     R0
        sm      (TEXTURE_LIGHTMAP_FAST_ROUTINE), R0
        ret
        nop

T4TextureStageLightmapRight:
        ; R10 is base+14. The right X is already staged and no longer needs
        ; to survive the overwhelmingly common orientation comparison.
        with    R10
        sub     #14
        movew   R1, (R10)
        inc     R10
        inc     R10
        movew   R0, (R10)
        with    R0
        sub     R1
        bpl     T4TextureStageLightmapOrdered
        nop
        GSU_ABSOLUTE_GOTO T4TextureStageLightmapReverseCold
T4TextureStageLightmapOrdered:
        with    R10
        add     #14
T4TextureStageLightmapAdvance:
        sm      (TEXTURE_COORD_PTR), R10
        GSU_ABSOLUTE_GOTO T4TextureRasterNextRow


TextureDivideQ12EdgePerspectiveLoaded:
        move    R6, R12
        GSU_ABSOLUTE_GOTO TextureDivideQ12EdgeLoadedCached

TextureEdgePerspectiveMirrorMissCold:
        iwt     R10, #TextureDivideQ12EdgePerspectiveLoaded
        GSU_ABSOLUTE_GOTO TextureEndpointDivideHotMirrorMissCold

; Width-one blocks need only the endpoint. Width-two blocks additionally need
; base+trunc(delta/2), exactly the signed quotient/remainder DDA's first step.
; R0=width, R5/R6=endpoint. Preserve those endpoints while writing the midpoint.
TextureLightmapBlockOneOrTwo:
        iwt     R10, #GSU_TEXTURE_BLOCK_COORDS_OFFSET+4
        dec     R0
        beq     TextureLightmapStoreShortEndpoints
        nop
        lm      R1, (TEXTURE_SPAN_S)
        from    R5
        sub     R1
        asr
        bpl     TextureLightmapHalfSReady
        nop
        adc     #0
TextureLightmapHalfSReady:
        add     R1
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R1, (TEXTURE_SPAN_T)
        from    R6
        sub     R1
        asr
        bpl     TextureLightmapHalfTReady
        nop
        adc     #0
TextureLightmapHalfTReady:
        add     R1
        movew   (R10), R0
        inc     R10
        inc     R10
TextureLightmapStoreShortEndpoints:
        movew   (R10), R5
        inc     R10
        inc     R10
        movew   (R10), R6
        GSU_ABSOLUTE_GOTO TextureLightmapCoordinateBlockReady

.assert * - AliasInitializeAxis <= GSU_TEXTURE_TAIL_CODE_CAPACITY, error, "Texture-tail GSU helpers exceed hidden scanlines"
