.if .defined(PLAYABLE_SAME_T_LIGHTMAP_BLOCK) && (BSP_RENDER_SCALE = 2)
.assert .defined(QUAKE_CACHED_LIGHTMAP_BLOCK8), error, "Same-T sampling requires the cached X2 lightmap setup"
; R5 contains the original Q4 S. Schedule the ROM fetch before decoding
; S's light-grid block and loading the already qualified T row and fraction.
TextureLightmapSameTPixel:
        lm      R1, (TEXTURE_SPAN_SHADE_Q8)
        from    R5
        and     R1
  .repeat 4
        lsr
  .endrepeat
        lm      R4, (TEXTURE_CUR_S)
        with    R4
        add     R0
        GSU_SET_ROM_BUFFER_ADDRESS R4
        iwt     R1, #$00F0
        to      R3
        from    R5
        and     R1
        from    R5
        hib
        to      R6
        sex
        lm      R5, (TEXTURE_COORD_RETURN)
        lm      R4, (TEXTURE_CUR_T)
        lm      R1, (LIGHTMAP_WIDTH)
        to      R12
        getb
        GSU_ABSOLUTE_GOTO LightmapSampleBaseReady, shared_delay
        cache
        .res $2B - (* - TextureLightmapSameTPixel), $01
.else
.include "quake/TextureCachedDivideEntries.sgs"
.endif
; Strict nonfinal projective blocks are always eight pixels wide. Reuse the
; otherwise-unreachable cached-divide tail to prepare their endpoint without
; reloading or comparing the block bounds in cold code. Final blocks retain
; the cold sentinel path because their width may be shorter or exactly eight.
TextureLightmapBlock8CachedSetup:
        sm      (TEXTURE_SIGN_S), R4
        move    R0, R4
        jal     TexturePerspectiveSampleSpanBuffered
        sm      (TEXTURE_BLOCK_END_S), R5
        sm      (TEXTURE_BLOCK_END_T), R6
        move    R10, R6
        move    R0, #8
        sm      (TEXTURE_SPAN_DEN), R0
        ; TextureLightmapSpanDone's first LM is the jump delay slot and remains
        ; its normal entry instruction when a span finishes directly.
        GSU_ABSOLUTE_GOTO TextureLightmapBlock8SetupOrdinary, shared_delay
.if .defined(PLAYABLE_SAME_T_LIGHTMAP_BLOCK) && (BSP_RENDER_SCALE = 2)
        .res $1F - (* - TextureLightmapBlock8CachedSetup), $01
.else
  .repeat 64 - (* - TextureDivideQ12LoadedCached)
        nop
  .endrepeat
        .assert * - TextureDivideQ12LoadedCached = 64, error, "Cached Q12 divide and correction no longer fill their pinned gap"
.endif
