; Bank-$70 liquid sampler is emitted late in DynamicBrushCachedSpan.sgs.

.segment "GSU_SKY_ROM_CODE"

SkyRomCodeStart:

; Four reserved tokens preserve painter owner-row boundaries without a face
; palette identity: BODY, START, END and SINGLE. Opaque pixels split runs.
BSP_SKY_SCAN_MARKER_MINIMUM = .min(BSP_SKY_TOKEN_BODY, .min(BSP_SKY_TOKEN_START, .min(BSP_SKY_TOKEN_END, BSP_SKY_TOKEN_SINGLE)))
.if BSP_SKY_TOKEN_BODY < $100
BSP_SKY_BLOCK_COMMON_ONE = BSP_SKY_TOKEN_BODY & BSP_SKY_TOKEN_START & BSP_SKY_TOKEN_END & BSP_SKY_TOKEN_SINGLE
BSP_SKY_BLOCK_ANY_ONE = BSP_SKY_TOKEN_BODY | BSP_SKY_TOKEN_START | BSP_SKY_TOKEN_END | BSP_SKY_TOKEN_SINGLE
BSP_SKY_BLOCK_COMMON_ZERO = BSP_SKY_BLOCK_ANY_ONE ^ $FF
.else
BSP_SKY_BLOCK_COMMON_ONE = 0
BSP_SKY_BLOCK_COMMON_ZERO = 0
.endif
BSP_SKY_BLOCK_CONSTRAINTS = BSP_SKY_BLOCK_COMMON_ONE | BSP_SKY_BLOCK_COMMON_ZERO

; R1/R3 are the complete covered row, R2 its logical Y, and R11 the caller.
; Prepare before falling into the sampler on its existing bank-$02 visit.
SkyFastSpanPrepareROM:
        sm      (TEXTURE_SPAN_RETURN), R11
        sm      (TEXTURE_SPAN_X), R1
        sm      (TEXTURE_SPAN_END_X), R3
        iwt     R10, #GSU_TEXTURE_COORD_MAP_OFFSET
        with    R10
        add     R2
        move    R2, #0
        moveb   R2, (R10)
        sm      (TEXTURE_PLOT_Y), R2
        ; Dead until SkyProcessRun installs its independent return.
        iwt     R0, #SkyMarkerSpanPlotBegin
        sm      (SKY_RUN_RETURN), R0

; The face/row cache identifies only the first emitted sample, not a color.
SkyMarkerSamplerROM:
        lm      R0, (PACKET_SOURCE_INDEX)
        lm      R1, (TEXTURE_SKY_MARKER_FACE)
        with    R0
        cmp     R1
        beq     @CachedFace
        nop
        sm      (TEXTURE_SKY_MARKER_FACE), R0
        bra     @NewRow
        nop

@CachedFace:
        lm      R7, (TEXTURE_SKY_MARKER_ROW)
        move    R0, R7
        hib
        lm      R2, (TEXTURE_PLOT_Y)
        with    R0
        cmp     R2
        bne     @NewRow
        nop
        iwt     R7, #BSP_SKY_TOKEN_BODY

        ; The common face/row hit falls straight into the original dispatch.
        ; Only a refreshed row pays the absolute return from the cold bounds.
@Dispatch:
        ; Keep the original MOVE+LMS five-byte prefix and every later ROM
        ; cache/math anchor fixed; expanded dispatch lives at the cold tail.
        GSU_ABSOLUTE_GOTO SkyMarkerDispatchROM
        .res 5 - (* - @Dispatch), $01
:
        dec     R1
        bne     @CheckAlbedo
        nop
        ; Every fallback pixel needs its exact whole-row token. Normal
        ; lightmaps retain their own unchanged constant-color plot entry.
        iwt     R13, #SkyMarkerSampler
@Lightmapped:
        iwt     R4, #TextureLightmapSkyPlotReady
:
@ReturnToBank70:
        move    R12, #$70
        from    R4
        ljmp    R12
        nop
@CheckAlbedo:
        dec     R1
        bne     @Lightmapped
        nop
@Albedo:
        move    R12, #$70
        from    R11
        ljmp    R12
        nop

@NewRow:
        ; One entry per actual face/row publishes its first-pixel token.
        ; Material selection can be skipped between equal-texture faces, so
        ; the source-face key is checked here instead of only by the selector.
        iwt     R7, #BSP_SKY_TOKEN_START
        lm      R2, (TEXTURE_PLOT_Y)
        move    R0, R2
        swap
        with    R0
        or      R7
        sm      (TEXTURE_SKY_MARKER_ROW), R0

        ; Invert this renderer's PLOT permutation before bounding the logical
        ; sky rows. X3 uses 3*y mod 8, whose inverse is also 3*y mod 8.
        move    R0, R2
        with    R0
        and     #7
        move    R1, R0
.if BSP_RENDER_SCALE = 2
        with    R1
        and     #1
        beq     @MappedRowEven
        nop
        move    R1, #15
        with    R1
        sub     R0
        move    R0, R1
@MappedRowEven:
        with    R0
        lsr
.else
        with    R0
        add     R0
        with    R0
        add     R1
        with    R0
        and     #7
.endif
        iwt     R1, #$FFF8
        with    R2
        and     R1
        with    R2
        add     R0

        ; Same four-byte call site preserves every existing ROM/cache anchor.
        GSU_ABSOLUTE_GOTO SkyMarkerInitializeBounds
@BoundsPrepared:
        moves   R0, R0
        bne     @UpdateBounds
        nop
        move    R0, #1
        sm      (GSU_SKY_PRESENT_OFFSET), R0
        iwt     R4, #GSU_SKY_MIN_Y_OFFSET
        moveb   (R4), R2
        iwt     R4, #GSU_SKY_MAX_Y_OFFSET
        moveb   (R4), R2

        ; Hook only the owning walker's outer return. The mixed-world path
        ; invokes per-face texture helpers before BRUSH_RASTER_RETURN; hooking
        ; TEXTURE_RETURN there would composite after the first visible sky
        ; face and skip the remainder of the painter-ordered token stream.
        lm      R0, (BRUSH_RASTER_RETURN)
        moves   R0, R0
        bne     @InstallBrushReturn
        nop
        lm      R0, (TEXTURE_RETURN)
        sm      (GSU_SKY_TEXTURE_RETURN_OFFSET), R0
        iwt     R0, #SkyOwnerReturn
        sm      (TEXTURE_RETURN), R0
        bra     @ReturnInstalled
        nop
@InstallBrushReturn:
        lm      R0, (BRUSH_RASTER_RETURN)
        sm      (GSU_SKY_BRUSH_RETURN_OFFSET), R0
        iwt     R0, #SkyOwnerReturn
        sm      (BRUSH_RASTER_RETURN), R0
@ReturnInstalled:
        lm      R0, (BRUSH_OVERLAY_FLAGS)
        move    R1, #BSP_OVERLAY_SKY_DEFER
        with    R0
        or      R1
        sm      (BRUSH_OVERLAY_FLAGS), R0
        bra     @RowReady
        nop

@UpdateBounds:
        iwt     R4, #GSU_SKY_MIN_Y_OFFSET
        move    R0, #0
        moveb   R0, (R4)
        with    R2
        cmp     R0
        bcs     @CheckMaximum
        nop
        moveb   (R4), R2
@CheckMaximum:
        iwt     R4, #GSU_SKY_MAX_Y_OFFSET
        move    R0, #0
        moveb   R0, (R4)
        with    R0
        cmp     R2
        bcs     @RowReady
        nop
        moveb   (R4), R2

@RowReady:
        GSU_ABSOLUTE_GOTO @Dispatch

; Publish cold-dispatch destinations after every cheap-local reference.
; Defining these at their use sites would reset ca65's cheap-local scope.
SkyMarkerBoundsPrepared = @BoundsPrepared
SkyMarkerOrdinaryDispatchReady = :--
SkyMarkerReturnToBank70 = :-

SKY_STATE                    = GSU_SKY_COMPOSITOR_SCRATCH_OFFSET
SKY_PROJECT_RETURN           = SKY_STATE + $00
SKY_RAY_RETURN               = SKY_STATE + $02
SKY_ACCUM_SIGNED_RETURN      = SKY_STATE + $04
SKY_ACCUM_RETURN             = SKY_STATE + $06
SKY_SQUARE_RETURN            = SKY_STATE + $08
SKY_ISQRT_RETURN             = SKY_STATE + $0A
SKY_QUOTIENT_RETURN          = SKY_STATE + $0C
SKY_DIVIDE_RETURN            = SKY_STATE + $0E
SKY_DDA_RETURN               = SKY_STATE + $10
SKY_SCAN_Y                   = SKY_STATE + $12
SKY_MAPPED_Y                 = SKY_STATE + $14
SKY_SCAN_X                   = SKY_STATE + $16
SKY_RUN_START                = SKY_STATE + $18
SKY_RUN_END                  = SKY_STATE + $1A
SKY_RUN_MARKER               = SKY_STATE + $1C
SKY_CHUNK_X                  = SKY_STATE + $1E
SKY_CHUNK_ENDPOINT_X         = SKY_STATE + $20
SKY_CHUNK_COUNT              = SKY_STATE + $22
SKY_CHUNK_REMAIN             = SKY_STATE + $24
SKY_CHUNK_FULL               = SKY_STATE + $26
SKY_DU                       = SKY_STATE + $28
SKY_DV                       = SKY_STATE + $2A
SKY_NX_LO                    = SKY_STATE + $2C
SKY_NX_HI                    = SKY_STATE + $2E
SKY_NY_LO                    = SKY_STATE + $30
SKY_NY_HI                    = SKY_STATE + $32
SKY_NZ_LO                    = SKY_STATE + $34
SKY_NZ_HI                    = SKY_STATE + $36
SKY_SUM_LO                   = SKY_STATE + $38
SKY_SUM_MID                  = SKY_STATE + $3A
SKY_SUM_HI                   = SKY_STATE + $3C
SKY_WORK_LO                  = SKY_STATE + $3E
SKY_WORK_HI                  = SKY_STATE + $40
SKY_SQUARE_LO                = SKY_STATE + $42
SKY_SQUARE_MID               = SKY_STATE + $44
SKY_SQUARE_HI                = SKY_STATE + $46
SKY_ROOT_LO                  = SKY_STATE + $48
SKY_ROOT_HI                  = SKY_STATE + $4A
SKY_MASK_LO                  = SKY_STATE + $4C
SKY_MASK_HI                  = SKY_STATE + $4E
SKY_NUMERATOR_LO             = SKY_STATE + $50
SKY_NUMERATOR_MID            = SKY_STATE + $52
SKY_NUMERATOR_HI             = SKY_STATE + $54
SKY_DENOMINATOR_LO           = SKY_STATE + $56
SKY_DENOMINATOR_HI           = SKY_STATE + $58
SKY_QUOTIENT_LO              = SKY_STATE + $5A
SKY_QUOTIENT_HI              = SKY_STATE + $5C
SKY_SIGN                     = SKY_STATE + $5E
SKY_PHASE_LO                 = SKY_STATE + $60
SKY_PHASE_HI                 = SKY_STATE + $62
SKY_ENDPOINT_S_LO            = SKY_STATE + $64
SKY_ENDPOINT_S_HI            = SKY_STATE + $66
SKY_ENDPOINT_T_LO            = SKY_STATE + $68
SKY_ENDPOINT_T_HI            = SKY_STATE + $6A
SKY_LEFT_S_LO                = SKY_STATE + $6C
SKY_LEFT_S_HI                = SKY_STATE + $6E
SKY_LEFT_T_LO                = SKY_STATE + $70
SKY_LEFT_T_HI                = SKY_STATE + $72
SKY_RIGHT_S_LO               = SKY_STATE + $74
SKY_RIGHT_S_HI               = SKY_STATE + $76
SKY_RIGHT_T_LO               = SKY_STATE + $78
SKY_RIGHT_T_HI               = SKY_STATE + $7A
SKY_DDA_S_LO                 = SKY_STATE + $7C
SKY_DDA_S_HI                 = SKY_STATE + $7E
SKY_DDA_T_LO                 = SKY_STATE + $80
SKY_DDA_T_HI                 = SKY_STATE + $82
SKY_STEP_S_LO                = SKY_STATE + $84
SKY_STEP_S_HI                = SKY_STATE + $86
SKY_STEP_T_LO                = SKY_STATE + $88
SKY_STEP_T_HI                = SKY_STATE + $8A
SKY_TEXTURE_BANK             = SKY_STATE + $8C
SKY_TEXTURE_ADDRESS          = SKY_STATE + $8E
SKY_RUN_RETURN               = SKY_STATE + $90
SKY_STEP_RETURN              = SKY_STATE + $92
SKY_FOCAL_PITCH_COS          = SKY_STATE + $94
SKY_FOCAL_PITCH_SIN          = SKY_STATE + $96
SKY_ROW_SCAN_END             = SKY_STATE + $98
SKY_STATE_END                = SKY_STATE + $9A
.if BSP_RENDER_SCALE = 2
.include "quake/SkyExactState.i"
.endif

.assert SKY_STATE_END <= GSU_SIN_OFFSET, error, "Sky compositor scratch reaches live trigonometry tables"
.assert BSP_VIEW_HEIGHT <= GSU_SKY_ROW_BOUNDS_ROWS, error, "Sky row bounds do not cover this viewport"
.assert BSP_SKY_RAY_PRESERVE_EXACT_NUMERATORS = 1, error, "Sky projection may not truncate Q6 ray numerators"
.assert BSP_SKY_RAY_SUMSQ_BITS <= 42, error, "Sky magnitude exceeds the proven 48-bit accumulator"
.assert BSP_SKY_MAGNITUDE_BITS <= 21, error, "Sky root exceeds the restoring-square-root envelope"
.assert BSP_SKY_MAGNITUDE_ROUND_NUMERATOR = 3, error, "Sky magnitude must retain the accepted three-quarter rounding threshold"
.assert BSP_SKY_MAGNITUDE_ROUND_DENOMINATOR = 4, error, "Sky magnitude must retain the accepted three-quarter rounding threshold"
.assert BSP_SKY_MAGNITUDE_ROUND_TIE_UP = 1, error, "Sky magnitude threshold equality must round upward"
.assert BSP_SKY_MAGNITUDE_REMAINDER_BITS <= 22, error, "Sky square-root remainder exceeds its two-word state"
.assert BSP_SKY_MAGNITUDE_ROUND_THRESHOLD_BITS <= 21, error, "Sky square-root threshold exceeds its two-word state"
.assert BSP_SKY_SOURCE_WIDTH = 256, error, "Sky sampler requires a 256-byte source row"
.assert BSP_SKY_SOURCE_HEIGHT = 128, error, "Sky sampler requires 128 source rows"
.assert BSP_SKY_LAYER_SIZE = 128, error, "Sky sampler requires paired 128-square layers"
.assert BSP_WORLD_TEXTURE_DIRECTORY_RECORD_BYTES = 8, error, "Sky directory resolver requires eight-byte records"
.assert BSP_SKY_ENABLED >= 0, error, "Sky enable flag must be boolean"
.assert BSP_SKY_ENABLED <= 1, error, "Sky enable flag must be boolean"
.if BSP_SKY_ENABLED
  .assert BSP_WORLD_SKY_TEXTURE_ID < BSP_WORLD_TEXTURE_COUNT, error, "Sky texture ID escapes the world directory"
.endif

; Non-square and special materials reach this cold selector. Technique 7 shares
; lightmap render mode one with technique 4. Its collapsed colormap must consume
; the ordinary static lightmap sample even on fullbright materials. The admission
; word distinguishes those two modes without taxing the hot span loop.
SkySelectSampleRoutineROM:
        lm      R0, (TEXTURE_RENDER_MODE)
        dec     R0
        bne     @TexturedSpecials
        nop
        lm      R0, (GSU_TEXTURE_COMPOSED_ALLOWED_OFFSET)
        moves   R0, R0
        beq     @UntexturedLightmap
        nop
@TexturedSpecials:
.if BSP_TURBULENCE_ENABLED
        lm      R0, (TEXTURE_WRAP_FLAGS)
        with    R0
        and     #BSP_WORLD_TEXTURE_FLAG_TURBULENT
        beq     @CheckSky
        nop
        lm      R0, (TEXTURE_RENDER_MODE)
        dec     R0
        beq     @TurbulenceLightmap
        nop
        dec     R0
        beq     @TurbulenceAlbedo
        nop
        bra     @TurbulenceLightmap
        nop
@TurbulenceLightmap:
        iwt     R1, #TurbulenceLightmapPlot
        bra     @TurbulenceExitReady
        nop
@TurbulenceAlbedo:
        iwt     R1, #TurbulenceAlbedoReturnHot
@TurbulenceExitReady:
        sm      (TEXTURE_TURBULENCE_EXIT), R1
        iwt     R1, #TurbulenceSamplerHot
        sm      (TEXTURE_SAMPLE_ROUTINE), R1
        ; Every technique-4 block class must enter the fullbright turbulent
        ; sampler.  The ordinary specialized loops call the static sampler
        ; directly, so leaving even one in this table produces a mixed static
        ; for both scales. Point all routes at the bank-$70 sampler;
        ; its RAM body and fullbright plot tail share one cache window without
        ; paying the generic sampler/lightmap dispatch.
        sm      (TEXTURE_STEP_S), R1
        sm      (TEXTURE_STEP_T), R1
        sm      (TEXTURE_REM_S), R1
        sm      (TEXTURE_REM_T), R1
        sm      (TEXTURE_ERR_S), R1
        sm      (TEXTURE_ERR_T), R1
        bra     @Return
        nop
@CheckSky:
.endif
.if BSP_SKY_ENABLED
        lm      R0, (TEXTURE_ID)
        move    R1, #BSP_WORLD_SKY_TEXTURE_ID
        with    R0
        cmp     R1
        bne     @Return
        nop
        lm      R0, (GSU_SKY_FLAGS_OFFSET)
        with    R0
        and     #BSP_SKY_FLAG_ENABLED
        beq     @Return
        nop
        lm      R0, (TEXTURE_RENDER_MODE)
        move    R1, #4
        with    R0
        cmp     R1
        beq     @Return
        nop
        ; New commands always reselect the first material. The standalone
        ; walker selects every face; the mixed walker clears its active ID at
        ; command entry and after fragments/aliases. No cache survives an
        ; owner's compositor return or a material change back to sky.
        .assert BSP_WORLD_FACE_COUNT < $FFFF, error, "Sky cache sentinel aliases a source face"
        iwt     R1, #$FFFF
        sm      (TEXTURE_SKY_MARKER_FACE), R1
        iwt     R1, #SkyMarkerSampler
        sm      (TEXTURE_SAMPLE_ROUTINE), R1
.endif
        bra     @Return
        nop
@UntexturedLightmap:
        ; Every entry in a collapsed technique-7 colormap row is identical.
        ; Keep the ordinary lightmap sampler but replace the irrelevant texture
        ; fetch with the existing local return stub on special materials.
        iwt     R1, #TexturePrimeLightmapCache
        sm      (TEXTURE_SAMPLE_ROUTINE), R1
@Return:
        ; Mixed ordinary axes retain the generic block routes. Resolve their
        ; invariant S-wrap/width/bank checks once per face, after sky and water
        ; have selected their samplers. Both-power-of-two axes keep two masks.
        lm      R0, (TEXTURE_RENDER_MODE)
        dec     R0
        bne     @SamplerReady
        nop
        lm      R0, (GSU_TEXTURE_COMPOSED_ALLOWED_OFFSET)
        moves   R0, R0
        beq     @SamplerReady
        nop
        lm      R0, (TEXTURE_SAMPLE_ROUTINE)
        iwt     R1, #TextureSampleAbsoluteRegisters
        with    R0
        cmp     R1
        bne     @SamplerReady
        nop
        lm      R0, (TEXTURE_WRAP_FLAGS)
        move    R1, #BSP_WORLD_TEXTURE_FLAG_SINGLE_BANK
        with    R0
        cmp     R1
        bne     @SamplerReady
        nop
        lm      R0, (TEXTURE_WIDTH)
        moves   R0, R0
        beq     @SamplerReady
        nop
        iwt     R1, #256
        with    R0
        cmp     R1
        bcs     @SamplerReady
        nop
        move    R1, R0
        dec     R1
        with    R0
        and     R1
        bne     @SamplerReady
        nop
        iwt     R1, #T4TextureSampleMixedPowerOfTwoSingleBank
        sm      (TEXTURE_SAMPLE_ROUTINE), R1
        ; Only the proven-interior world block uses this direct lightmap
        ; continuation. Checked and cached-cell classes keep generic routes.
        GSU_ABSOLUTE_GOTO T4InstallMixedSamplerROM
        .res 2, $01
@SamplerReady:
        iwt     R8, #TextureSelectSampleRoutineDone
        move    R9, #$70
        from    R8
        ljmp    R9
        nop
T4SelectSampleRoutineDoneROM = @SamplerReady

; Stable bank-$70 thunks enter these handlers only after the complete opaque
; owner has returned. Restore that owner's walker, composite in ROM, then
; continue through a ROM-local postlude before crossing back to RAM.
SkyOwnerReturnROM:
        lm      R0, (BRUSH_RASTER_RETURN)
        moves   R0, R0
        bne     @RestoreBrushReturn
        nop
        lm      R0, (GSU_SKY_TEXTURE_RETURN_OFFSET)
        sm      (TEXTURE_RETURN), R0
        bra     SkyTextureReturnROM
        nop
@RestoreBrushReturn:
        lm      R0, (GSU_SKY_BRUSH_RETURN_OFFSET)
        sm      (BRUSH_RASTER_RETURN), R0
        bra     SkyBrushReturnROM
        nop

SkyTextureReturnROM:
        lm      R0, (BRUSH_OVERLAY_FLAGS)
        iwt     R1, #$FFEF
        with    R0
        and     R1
        sm      (BRUSH_OVERLAY_FLAGS), R0
        iwt     R0, #SkyTextureCompositorReturnedROM
        sm      (GSU_SKY_ROM_RETURN_OFFSET), R0
        GSU_ABSOLUTE_GOTO SkyCompositor
SkyTextureCompositorReturnedROM:
        move    R0, #0
        sm      (GSU_SKY_PRESENT_OFFSET), R0
        lm      R8, (GSU_SKY_TEXTURE_RETURN_OFFSET)
        bra     SkyReturnToBank70
        nop

SkyBrushReturnROM:
        iwt     R0, #SkyBrushCompositorReturnedROM
        sm      (GSU_SKY_ROM_RETURN_OFFSET), R0
        GSU_ABSOLUTE_GOTO SkyCompositor
SkyBrushCompositorReturnedROM:
        move    R0, #0
        sm      (GSU_SKY_PRESENT_OFFSET), R0
        lm      R0, (BRUSH_OVERLAY_FLAGS)
        iwt     R1, #$FFEF
        with    R0
        and     R1
        sm      (BRUSH_OVERLAY_FLAGS), R0
        ; The mixed stream's aliases are a globally sorted suffix. Restart at
        ; that suffix after sky composition so aliases remain the final layer.
        lm      R0, (BRUSH_TOKEN_COUNT)
        lm      R1, (ALIAS_TOKEN_COUNT)
        with    R0
        sub     R1
        sm      (BRUSH_TOKEN_CURSOR), R0
        iwt     R8, #BrushMixedTokenLoop
        bra     SkyReturnToBank70
        nop
SkyReturnToBank70:
        move    R9, #$70
        from    R8
        ljmp    R9
        nop

SkyCompositor:
        GSU_ABSOLUTE_GOTO SkyScanFlushBeforeBlocks
        .assert * - SkyCompositor = 4, error, "Sky initial drain hook moved compositor setup"
.if BSP_RENDER_SCALE = 3
        ; Focal products are assembled for every possible quantized pitch.
        ; Select once, then use the same two forward terms for every sky ray.
        iwt     R8, #.loword(SkyFocalNormal)
        move    R0, #BSP_GSU_ROM2_BANK
        romb
        .repeat 2, axis
          .if axis = 0
            lm  R0, (PITCH_COS)
          .else
            lm  R0, (PITCH_SIN)
          .endif
          iwt   R1, #64
          with  R0
          add   R1
          add   R0
          move  R4, R8
          with  R4
          add   R0
          GSU_SET_ROM_BUFFER_ADDRESS R4
          getb
          inc   R4
          GSU_SET_ROM_BUFFER_ADDRESS R4
          getbh
          sm    (SKY_FOCAL_PITCH_COS+axis*2), R0
        .endrepeat
.endif

.if BSP_RENDER_SCALE = 2
        ; Preserve full binary32 magnitude for the independent exact fallback.
        jal     SkyFloatPreparePhase
        nop
.else
        ; Stage the immutable low23 phase into aligned scratch words.
        lm      R0, (GSU_SKY_PHASE_OFFSET)
        sm      (SKY_PHASE_LO), R0
        iwt     R10, #GSU_SKY_PHASE_OFFSET+2
        move    R0, #0
        moveb   R0, (R10)
        sm      (SKY_PHASE_HI), R0
.endif

        ; Resolve sky1 through the generated byte-identical texture directory.
        ; This remains the single placement authority even if a future pack
        ; moves the existing 32-KiB source payload.
        move    R0, #BSP_WORLD_TEXTURE_DIRECTORY_GSU_ROM_BANK
        romb
        iwt     R4, #BSP_WORLD_TEXTURE_DIRECTORY_GSU_ROM_ADDRESS + BSP_WORLD_SKY_TEXTURE_ID * BSP_WORLD_TEXTURE_DIRECTORY_RECORD_BYTES
        GSU_SET_ROM_BUFFER_ADDRESS R4
        BSP_ROM_LOAD_BYTE R0
        sm      (SKY_TEXTURE_BANK), R0
        BSP_ROM_LOAD_WORD R0
        sm      (SKY_TEXTURE_ADDRESS), R0
        lm      R0, (SKY_TEXTURE_BANK)
        romb

        iwt     R10, #GSU_SKY_MIN_Y_OFFSET
        move    R0, #0
        moveb   R0, (R10)
        sm      (SKY_SCAN_Y), R0

@RowLoop:
        lm      R0, (SKY_SCAN_Y)
        iwt     R10, #GSU_TEXTURE_COORD_MAP_OFFSET
        with    R10
        add     R0
        moveb   R0, (R10)
        sm      (SKY_MAPPED_Y), R0
        ; R8 is idle after focal setup. Keep X live until a marker run needs
        ; the memory-backed ABI; the opaque reject loop makes no calls.
@RowBoundsDispatch:
        GSU_ABSOLUTE_GOTO SkyScanRowBounds

@ScanPixel:
  .if BSP_SKY_BLOCK_CONSTRAINTS
        ; Keep admission resident: ordinary scalar pixels never enter cold
        ; code. X+7 must be below the conservative exclusive end, including
        ; the final partial X3 tile and any unaligned run continuation.
        move    R0, R8
        and     #7
        bne     @ScanScalar
        nop
        move    R0, R8
        add     #7
        cmp     R9
        bcs     @ScanScalar
        nop
        GSU_ABSOLUTE_GOTO SkyScanBlockReject
  .endif
@ScanScalar:
:
        move    R0, R8
        ; R9 is this row's conservative exclusive end, restored after a run.
        move    R1, R9
        nop
        with    R0
        cmp     R1
        bne     @ScanPixelPresent
        nop
        GSU_ABSOLUTE_GOTO @RowDone
@ScanPixelPresent:
        move    R1, R0
        iwt     R10, #GSU_TEXTURE_COORD_MAP_OFFSET
        with    R10
        add     R1
        moveb   R1, (R10)
        lm      R2, (SKY_MAPPED_Y)
        rpix
        move    R7, R0
        ; Most opaque samples are below every reserved marker. Reject them
        ; before the exact identity chain while retaining R7 for sky runs.
        iwt     R1, #BSP_SKY_SCAN_MARKER_MINIMUM
        cmp     R1
        bcc     @ScanNextPixel
        nop
        iwt     R1, #BSP_SKY_TOKEN_BODY
        with    R7
        cmp     R1
        beq     @MarkerFound
        nop
        iwt     R1, #BSP_SKY_TOKEN_START
        with    R7
        cmp     R1
        beq     @MarkerFound
        nop
        iwt     R1, #BSP_SKY_TOKEN_END
        with    R7
        cmp     R1
        beq     @MarkerFound
        nop
        iwt     R1, #BSP_SKY_TOKEN_SINGLE
        with    R7
        cmp     R1
        beq     @MarkerFound
        nop
@ScanNextPixel:
        inc     R8
        ; The taken absolute jump has already put ScanPixel in R15, so CACHE
        ; anchors the whole no-call scan without changing the compare flags.
        GSU_ABSOLUTE_GOTO @ScanPixel, shared_delay
        cache
@ScanResume:
        ; SkyProcessRun may clobber R8. Only run completion enters here; its
        ; memory X is the first pixel not included in the completed run.
        GSU_ABSOLUTE_GOTO SkyScanResumeBounds
.assert * - @ScanNextPixel = 9, error, "Sky scan continuation moved its marker entry"

@MarkerFound:
        lm      R0, (GSU_SKY_FLAGS_OFFSET)
        with    R0
        or      #BSP_SKY_FLAG_PRESENTED
        sm      (GSU_SKY_FLAGS_OFFSET), R0
        sm      (SKY_RUN_MARKER), R7
@MarkerScanX:
        move    R0, R8
        .res 4 - (* - @MarkerScanX), $01
        sm      (SKY_RUN_START), R0
        inc     R0
        sm      (SKY_SCAN_X), R0
        iwt     R1, #BSP_SKY_TOKEN_END
        with    R7
        cmp     R1
        beq     @RunComplete
        nop
        iwt     R1, #BSP_SKY_TOKEN_SINGLE
        with    R7
        cmp     R1
        beq     @RunComplete
        nop

@ExtendRun:
        lm      R0, (SKY_SCAN_X)
        iwt     R1, #BSP_VIEW_WIDTH
        with    R0
        cmp     R1
        beq     @RunAtRightEdge
        nop
        move    R1, R0
        iwt     R10, #GSU_TEXTURE_COORD_MAP_OFFSET
        with    R10
        add     R1
        moveb   R1, (R10)
        lm      R2, (SKY_MAPPED_Y)
        rpix
        iwt     R1, #BSP_SKY_TOKEN_BODY
        with    R0
        cmp     R1
        beq     @RunBody
        nop
        iwt     R1, #BSP_SKY_TOKEN_END
        with    R0
        cmp     R1
        bne     @RunComplete
        nop
        lm      R0, (SKY_SCAN_X)
        inc     R0
        sm      (SKY_SCAN_X), R0
        GSU_ABSOLUTE_GOTO @RunComplete
@RunBody:
        lm      R0, (SKY_SCAN_X)
        inc     R0
        sm      (SKY_SCAN_X), R0
        GSU_ABSOLUTE_GOTO @ExtendRun

@RunAtRightEdge:
        move    R0, #BSP_VIEW_WIDTH-1
        sm      (SKY_RUN_END), R0
        jal     SkyProcessRun
        nop
        bra     @RowDone
        nop

@RunComplete:
        lm      R0, (SKY_SCAN_X)
        dec     R0
        sm      (SKY_RUN_END), R0
        jal     SkyProcessRun
        nop
        GSU_ABSOLUTE_GOTO @ScanResume

@RowDone:
:
        lm      R0, (SKY_SCAN_Y)
        inc     R0
        sm      (SKY_SCAN_Y), R0
        iwt     R10, #GSU_SKY_MAX_Y_OFFSET
        moveb   R1, (R10)
        with    R0
        cmp     R1
        bcc     @MoreRows
        nop
        beq     @MoreRows
        nop
        bra     @AllRowsDone
        nop
@MoreRows:
        GSU_ABSOLUTE_GOTO @RowLoop
@AllRowsDone:

        ; Drain the final deferred sky PLOT before returning to alias work or
        ; the renderer's normal telemetry/STOP tail.
        move    R1, #0
        move    R2, #0
        rpix
; Cold helpers return to these exact old scan continuations.
SkyScanPixelEntry = @ScanPixel
SkyScanScalarEntry = :--
SkyScanRowDone = :-
SkyCompositorDone:
        lm      R8, (GSU_SKY_ROM_RETURN_OFFSET)
        jmp     R8
        nop

; The resident admission gate supplies only complete aligned tiles.
; R8/R9 retain logical X/exclusive end. Both coordinate maps permute within
; each eight-pixel tile, never across tiles. Scalar returns bypass the gate.
SkyScanBlockReject:
  .if BSP_SKY_BLOCK_CONSTRAINTS
        ; All sky owners set CMODE=$11: OBJ tiles are row-major even though
        ; SCMR selects a128-high screen. SCBR=0,8bpp: tileY*128+tileX*8,
        ; then the mapped within-tile row*2.
        ; R3 is this row's physical byte base, restored after every run.
        move    R4, R8
        .repeat 3
          with  R4
          add   R4
        .endrepeat
        with    R4
        add     R3
        iwt     R2, #$00FF
        move    R0, #0
        ramb
        .repeat 8, plane
          .if BSP_SKY_BLOCK_CONSTRAINTS & (1 << plane)
            move    R10, R4
            iwt     R1, #((plane / 2) * 16 + (plane & 1))
            with    R10
            add     R1
            moveb   R0, (R10)
            .if BSP_SKY_BLOCK_COMMON_ZERO & (1 << plane)
              not
            .endif
            to      R2
            from    R0
            and     R2
          .endif
        .endrepeat
        ; Restore bank71 before any sky-state access or scalar RPIX path.
        move    R0, #1
        ramb
        with    R2
        and     R2
        beq     @Empty
        nop
        GSU_ABSOLUTE_GOTO SkyScanScalarEntry
@Empty:
        move    R0, R8
        add     #8
        move    R8, R0
        GSU_ABSOLUTE_GOTO SkyScanPixelEntry
  .endif
SkyScanBlockRejectEnd:
.assert SkyScanBlockRejectEnd - (SkyScanPixelEntry & $FFFFF0) <= 512, lderror, "Sky block probe escaped resident scan window"

; Build the exact common-denominator-64 ray. Inputs R0/R1 are logical u/v;
; outputs are three signed 32-bit numerators in scratch.
SkyBuildRayNumerators:
        sm      (SKY_RAY_RETURN), R11
.if BSP_RENDER_SCALE = 3
        move    R2, R0
        with    R0
        add     R0
        with    R0
        add     R2
        move    R2, R1
        with    R1
        add     R1
        with    R1
        add     R2
.endif
        move    R2, R0
.if BSP_RENDER_SCALE = 3
        ; X3's center is 129. MOVE chooses sign-extending IBT for a byte-sized
        ; immediate, which would turn this positive center into -127.
        iwt     R3, #BSP_VIEW_CENTER_X * (2 * BSP_RENDER_SCALE - 3)
.else
        move    R3, #BSP_VIEW_CENTER_X * (2 * BSP_RENDER_SCALE - 3)
.endif
        with    R2
        sub     R3
        sm      (SKY_DU), R2
        move    R2, #BSP_VIEW_CENTER_Y * (2 * BSP_RENDER_SCALE - 3)
        with    R2
        sub     R1
        sm      (SKY_DV), R2

        ; Nx = 64*pc*yc - 64*du*ys - dv*ps*yc.
.if BSP_RENDER_SCALE = 3
        lm      R0, (SKY_FOCAL_PITCH_COS)
        lm      R6, (YAW_COS)
        with    R0
        lmult
.else
        lm      R0, (PITCH_COS)
        lm      R6, (YAW_COS)
        jal     SkyMultiplyScale64
        nop
.endif
        sm      (SKY_NX_LO), R4
        sm      (SKY_NX_HI), R0
        lm      R0, (SKY_DU)
        lm      R6, (YAW_SIN)
        jal     SkyMultiplyScale64
        nop
        lm      R1, (SKY_NX_LO)
        lm      R2, (SKY_NX_HI)
        with    R1
        sub     R4
        with    R2
        sbc     R0
        sm      (SKY_NX_LO), R1
        sm      (SKY_NX_HI), R2
        lm      R0, (PITCH_SIN)
        lm      R6, (YAW_COS)
        with    R0
        lmult
        move    R0, R4
        lm      R6, (SKY_DV)
        with    R0
        lmult
        lm      R1, (SKY_NX_LO)
        lm      R2, (SKY_NX_HI)
        with    R1
        sub     R4
        with    R2
        sbc     R0
        sm      (SKY_NX_LO), R1
        sm      (SKY_NX_HI), R2

        ; Ny = 64*pc*ys + 64*du*yc - dv*ps*ys.
.if BSP_RENDER_SCALE = 3
        lm      R0, (SKY_FOCAL_PITCH_COS)
        lm      R6, (YAW_SIN)
        with    R0
        lmult
.else
        lm      R0, (PITCH_COS)
        lm      R6, (YAW_SIN)
        jal     SkyMultiplyScale64
        nop
.endif
        sm      (SKY_NY_LO), R4
        sm      (SKY_NY_HI), R0
        lm      R0, (SKY_DU)
        lm      R6, (YAW_COS)
        jal     SkyMultiplyScale64
        nop
        lm      R1, (SKY_NY_LO)
        lm      R2, (SKY_NY_HI)
        with    R1
        add     R4
        with    R2
        adc     R0
        sm      (SKY_NY_LO), R1
        sm      (SKY_NY_HI), R2
        lm      R0, (PITCH_SIN)
        lm      R6, (YAW_SIN)
        with    R0
        lmult
        move    R0, R4
        lm      R6, (SKY_DV)
        with    R0
        lmult
        lm      R1, (SKY_NY_LO)
        lm      R2, (SKY_NY_HI)
        with    R1
        sub     R4
        with    R2
        sbc     R0
        sm      (SKY_NY_LO), R1
        sm      (SKY_NY_HI), R2

        ; Nz = 192*(64*ps + dv*pc). The parenthesized value is signed16.
        lm      R0, (SKY_DV)
        lm      R6, (PITCH_COS)
        with    R0
        lmult
        move    R1, R4
        move    R2, R0
.if BSP_RENDER_SCALE = 3
        lm      R0, (SKY_FOCAL_PITCH_SIN)
        move    R6, #1
        with    R0
        lmult
.else
        lm      R0, (PITCH_SIN)
        move    R6, #1
        jal     SkyMultiplyScale64
        nop
.endif
        with    R1
        add     R4
        with    R2
        adc     R0
        move    R0, R1
        iwt     R6, #192
        with    R0
        lmult
        sm      (SKY_NZ_LO), R4
        sm      (SKY_NZ_HI), R0
        lm      R11, (SKY_RAY_RETURN)
        ret
        nop

SkyMultiplyScale64:
        with    R0
        lmult
  .repeat 6
        with    R4
        add     R4
        with    R0
        adc     R0
  .endrepeat
        ret
        nop

; Square unsigned WORK as a base-2^15 value into SQUARE[47:0].
.include "quake/SkyIntegerMath.sgs"

; Quake full partitions use signed arithmetic floor(delta/32).
SkyDdaFullFloor:
  .repeat 5
        lm      R0, (SKY_WORK_LO)
        lm      R1, (SKY_WORK_HI)
        with    R1
        asr
        with    R0
        ror
        sm      (SKY_WORK_LO), R0
        sm      (SKY_WORK_HI), R1
  .endrepeat
        ret
        nop

; Final partial partitions use signed C truncation toward zero by count-1.
SkyDdaPartialTrunc0:
        sm      (SKY_DDA_RETURN), R11
        lm      R4, (SKY_WORK_LO)
        lm      R0, (SKY_WORK_HI)
        move    R1, #0
        sm      (SKY_SIGN), R1
        moves   R0, R0
        bpl     @DdaMagnitudeReady
        nop
        move    R1, #1
        sm      (SKY_SIGN), R1
        move    R1, #0
        with    R1
        sub     R4
        move    R2, #0
        with    R2
        sbc     R0
        move    R4, R1
        move    R0, R2
@DdaMagnitudeReady:
        sm      (SKY_NUMERATOR_LO), R4
        sm      (SKY_NUMERATOR_MID), R0
        move    R1, #0
        sm      (SKY_NUMERATOR_HI), R1
.if BSP_RENDER_SCALE = 2
        sm      (SKY_NUMERATOR_TOP), R1
.endif
        lm      R0, (SKY_CHUNK_COUNT)
        dec     R0
        sm      (SKY_DENOMINATOR_LO), R0
        sm      (SKY_DENOMINATOR_HI), R1
        jal     SkyUnsignedDivide48By32
        nop
        lm      R4, (SKY_QUOTIENT_LO)
        lm      R0, (SKY_QUOTIENT_HI)
        lm      R1, (SKY_SIGN)
        moves   R1, R1
        beq     @DdaStore
        nop
        move    R1, #0
        with    R1
        sub     R4
        move    R2, #0
        with    R2
        sbc     R0
        move    R4, R1
        move    R0, R2
@DdaStore:
        sm      (SKY_WORK_LO), R4
        sm      (SKY_WORK_HI), R0
        lm      R11, (SKY_DDA_RETURN)
        ret
        nop

; Select the exact released-Quake DDA rounding rule for WORK. A one-pixel
; terminal partition has a zero step and never divides by zero.
SkyPrepareDdaStep:
        sm      (SKY_STEP_RETURN), R11
        lm      R0, (SKY_CHUNK_COUNT)
        dec     R0
        bne     @DdaHasIntervals
        nop
        move    R0, #0
        sm      (SKY_WORK_LO), R0
        sm      (SKY_WORK_HI), R0
        bra     @DdaReady
        nop
@DdaHasIntervals:
        lm      R0, (SKY_CHUNK_FULL)
        moves   R0, R0
        beq     @DdaPartial
        nop
        jal     SkyDdaFullFloor
        nop
        bra     @DdaReady
        nop
@DdaPartial:
        jal     SkyDdaPartialTrunc0
        nop
@DdaReady:
        lm      R11, (SKY_STEP_RETURN)
        ret
        nop

; Split one final marker run into Quake's 32-pixel partitions, project both
; endpoints, derive the signed DDA, and overwrite only its owned pixels.
SkyProcessRun:
        sm      (SKY_RUN_RETURN), R11
        lm      R0, (SKY_RUN_START)
        sm      (SKY_CHUNK_X), R0
        lm      R1, (SKY_RUN_END)
        with    R1
        sub     R0
        inc     R1
        sm      (SKY_CHUNK_REMAIN), R1

        ; A nonfinal chunk's right endpoint is the next chunk's exact left
        ; endpoint. DDA/pixel work leaves these projected words intact, so
        ; project the first left once and reuse the preceding right thereafter.
        lm      R0, (SKY_CHUNK_X)
        lm      R1, (SKY_SCAN_Y)
        jal     SkyProjectEndpoint
        nop

@ChunkLoop:
        lm      R0, (SKY_CHUNK_REMAIN)
        iwt     R1, #BSP_SKY_SPAN_MAXIMUM
        with    R0
        cmp     R1
        bcc     @ChunkCountReady
        nop
        move    R0, R1
@ChunkCountReady:
        sm      (SKY_CHUNK_COUNT), R0
        lm      R1, (SKY_CHUNK_REMAIN)
        with    R1
        sub     R0
        sm      (SKY_CHUNK_REMAIN), R1
        lm      R2, (SKY_CHUNK_X)
        moves   R1, R1
        beq     @FinalChunk
        nop
        move    R3, #1
        sm      (SKY_CHUNK_FULL), R3
        with    R2
        add     R0
        bra     @ChunkEndpointReady
        nop
@FinalChunk:
        move    R3, #0
        sm      (SKY_CHUNK_FULL), R3
        dec     R0
        with    R2
        add     R0
@ChunkEndpointReady:
        sm      (SKY_CHUNK_ENDPOINT_X), R2

        lm      R0, (SKY_ENDPOINT_S_LO)
        sm      (SKY_LEFT_S_LO), R0
        sm      (SKY_DDA_S_LO), R0
        lm      R0, (SKY_ENDPOINT_S_HI)
        sm      (SKY_LEFT_S_HI), R0
        sm      (SKY_DDA_S_HI), R0
        lm      R0, (SKY_ENDPOINT_T_LO)
        sm      (SKY_LEFT_T_LO), R0
        sm      (SKY_DDA_T_LO), R0
        lm      R0, (SKY_ENDPOINT_T_HI)
        sm      (SKY_LEFT_T_HI), R0
        sm      (SKY_DDA_T_HI), R0

        lm      R0, (SKY_CHUNK_ENDPOINT_X)
        lm      R1, (SKY_SCAN_Y)
        jal     SkyProjectEndpoint
        nop
        lm      R0, (SKY_ENDPOINT_S_LO)
        sm      (SKY_RIGHT_S_LO), R0
        lm      R0, (SKY_ENDPOINT_S_HI)
        sm      (SKY_RIGHT_S_HI), R0
        lm      R0, (SKY_ENDPOINT_T_LO)
        sm      (SKY_RIGHT_T_LO), R0
        lm      R0, (SKY_ENDPOINT_T_HI)
        sm      (SKY_RIGHT_T_HI), R0

        ; S step = right - left with the partition-specific rounding rule.
        lm      R0, (SKY_RIGHT_S_LO)
        lm      R1, (SKY_RIGHT_S_HI)
        lm      R2, (SKY_LEFT_S_LO)
        lm      R3, (SKY_LEFT_S_HI)
        with    R0
        sub     R2
        with    R1
        sbc     R3
        sm      (SKY_WORK_LO), R0
        sm      (SKY_WORK_HI), R1
        jal     SkyPrepareDdaStep
        nop
        lm      R0, (SKY_WORK_LO)
        sm      (SKY_STEP_S_LO), R0
        lm      R0, (SKY_WORK_HI)
        sm      (SKY_STEP_S_HI), R0

        ; T step follows the same floor/full versus trunc0/final split.
        lm      R0, (SKY_RIGHT_T_LO)
        lm      R1, (SKY_RIGHT_T_HI)
        lm      R2, (SKY_LEFT_T_LO)
        lm      R3, (SKY_LEFT_T_HI)
        with    R0
        sub     R2
        with    R1
        sbc     R3
        sm      (SKY_WORK_LO), R0
        sm      (SKY_WORK_HI), R1
        jal     SkyPrepareDdaStep
        nop
        lm      R0, (SKY_WORK_LO)
        sm      (SKY_STEP_T_LO), R0
        lm      R0, (SKY_WORK_HI)
        sm      (SKY_STEP_T_HI), R0

@ChunkPixelLoop:
        jal     SkyDrawChunkPixels
        nop
        lm      R0, (SKY_CHUNK_REMAIN)
        moves   R0, R0
        beq     @RunDone
        nop
        GSU_ABSOLUTE_GOTO @ChunkLoop
@RunDone:
        lm      R11, (SKY_RUN_RETURN)
        ret
        nop

; DDA coordinates and steps stay live for one complete perspective chunk.
; SKY_STEP_RETURN is dead after SkyPrepareDdaStep, and no endpoint word is
; touched: the next chunk must still reuse its previous right endpoint.
SkyDrawChunkPixels:
        sm      (SKY_STEP_RETURN), R11
.if BSP_RENDER_SCALE = 2
        move    R0, #0
        sm      (SF_CHUNK_EXACT), R0
        lm      R0, (SKY_CHUNK_X)
        sm      (SF_CHUNK_START), R0
SkyReloadChunkPixels:
.endif
        lm      R3, (SKY_DDA_S_LO)
        lm      R4, (SKY_DDA_S_HI)
        lm      R5, (SKY_DDA_T_LO)
        lm      R6, (SKY_DDA_T_HI)
        lm      R7, (SKY_STEP_S_LO)
        lm      R8, (SKY_STEP_S_HI)
        lm      R9, (SKY_STEP_T_LO)
        lm      R10, (SKY_STEP_T_HI)
        lm      R0, (SKY_CHUNK_X)
        lm      R12, (SKY_CHUNK_COUNT)
        iwt     R11, #GSU_TEXTURE_COORD_MAP_OFFSET
        with    R11
        add     R0
        with    R0
        add     R12
        sm      (SKY_CHUNK_X), R0
        iwt     R13, #SkyPlotSample
.if BSP_RENDER_SCALE = 2
        lm      R0, (SF_CHUNK_EXACT)
        moves   R0, R0
        bne     SkyPlotSample
        nop
        iwt     R13, #SkyPlotMaybeExactSample
SkyPlotMaybeExactSample:
        ; The complete Q3/float/DDA proof bounds either coordinate by71Q16.
        ; A72-unit closed envelope is conservative at both wrap boundaries.
        iwt     R1, #72
        iwt     R2, #144
        move    R0, R3
        with    R0
        add     R1
        with    R0
        cmp     R2
        bcc     @CheckEnvelope
        nop
        move    R0, R5
        with    R0
        add     R1
        with    R0
        cmp     R2
        bcs     SkyPlotSample
        nop
@CheckEnvelope:
        GSU_ABSOLUTE_GOTO SkyCheckColorEnvelope
.endif

; R3:R4=S, R5:R6=T, R7:R8=dS, R9:R10=dT. Only R0/R1/R2 and the
; ROM buffer are sampler temporaries. Index zero in the shifted foreground
; is transparent; the background uses the original unshifted coordinates.
SkyPlotSample:
.assert (BSP_SKY_COORD_MASK >> BSP_SKY_COORD_FRACTION_BITS) <= $7F, error, "Sky mask must fit positive IBT"
        move    R2, #(BSP_SKY_COORD_MASK >> BSP_SKY_COORD_FRACTION_BITS)
        lm      R1, (SKY_PHASE_HI)
        to      R0
        from    R4
        add     R1
        with    R0
        and     R2
        to      R1
        from    R6
        add     R1
        with    R1
        and     R2
        with    R1
        swap
        with    R1
        add     R0
        lm      R0, (SKY_TEXTURE_ADDRESS)
        with    R1
        add     R0
        GSU_SET_ROM_BUFFER_ADDRESS R1
        to      R0
        getb
        moves   R0, R0
        bne     @SkyColorReady
        nop

        to      R0
        from    R4
        and     R2
        to      R1
        from    R6
        and     R2
        with    R1
        swap
        with    R1
        add     R0
        lm      R0, (SKY_TEXTURE_ADDRESS)
        iwt     R2, #BSP_SKY_LAYER_SIZE
        with    R0
        add     R2
        with    R1
        add     R0
        GSU_SET_ROM_BUFFER_ADDRESS R1
        to      R0
        getb
@SkyColorReady:
        color
        moveb   R1, (R11)
        lm      R2, (SKY_MAPPED_Y)
SkyPlotPixel:
        plot
        with    R3
        add     R7
        with    R4
        adc     R8
        with    R5
        add     R9
        with    R6
        adc     R10
        inc     R11
        loop
        cache   ; Taken LOOP primes its destination, including both layers.
        sm      (SKY_DDA_S_LO), R3
        sm      (SKY_DDA_S_HI), R4
        sm      (SKY_DDA_T_LO), R5
        sm      (SKY_DDA_T_HI), R6
        move    R0, #0
        sm      (SKY_CHUNK_COUNT), R0
        lm      R11, (SKY_STEP_RETURN)
        ret
        nop
SkyPixelLoopEnd:
.if BSP_RENDER_SCALE = 2
.assert SkyPixelLoopEnd-(SkyPlotMaybeExactSample & $FFFFF0)<=512, lderror, "Exact gate escaped cached loop"
.else
.assert * - SkyPlotSample <= $1F0, error, "Sky pixel loop exceeds its cache window"
.endif

.if BSP_RENDER_SCALE = 3
SkyFocalNormal:
        .repeat 129, value
          .word .loword((value-64)*128)
        .endrepeat
.endif
; The opaque marker phase owns this scratch until its compositor begins.
; Normal samplers clear it on every call; the fast row publishes its exact
; bank-$70 continuation. No formerly preserved working register is borrowed.
SkyMarkerDispatchROM:
        ; Update every dispatch, including same-face/row hits and split spans.
        ; The full remaining span is conservative even when a depth test later
        ; rejects a marker. Never assume the first span covered later fragments.
        lm      R0, (GSU_SKY_MARKER_LOGICAL_Y_OFFSET)
        add     R0
        iwt     R4, #GSU_SKY_ROW_BOUNDS_OFFSET
        with    R4
        add     R0
        move    R0, #0
        moveb   R0, (R4)
        lm      R1, (TEXTURE_SPAN_X)
        with    R1
        cmp     R0
        bcs     @MinimumReady
        nop
        moveb   (R4), R1
@MinimumReady:
        inc     R4
        moveb   R0, (R4)
        lm      R1, (TEXTURE_SPAN_END_X)
        cmp     R1
        bcs     @MaximumReady
        nop
        moveb   (R4), R1
@MaximumReady:
        lm      R4, (SKY_RUN_RETURN)
        moves   R4, R4
        beq     SkyMarkerDispatchOrdinary
        nop
        move    R0, R7
        GSU_ABSOLUTE_GOTO SkyMarkerReturnToBank70
SkyMarkerDispatchOrdinary:
        ; The sampler sees the full logical span end, never an8-pixel block
        ; endpoint. A clipped surviving first pixel is a valid START boundary.
        lm      R0, (TEXTURE_SPAN_X)
        lm      R1, (TEXTURE_SPAN_END_X)
        with    R0
        cmp     R1
        bne     @TokenReady
        nop
        iwt     R1, #BSP_SKY_TOKEN_START
        with    R7
        cmp     R1
        beq     @SingleToken
        nop
        iwt     R7, #BSP_SKY_TOKEN_END
        bra     @TokenReady
        nop
@SingleToken:
        iwt     R7, #BSP_SKY_TOKEN_SINGLE
@TokenReady:
        move    R0, R7
        lm      R1, (TEXTURE_RENDER_MODE)
        GSU_ABSOLUTE_GOTO SkyMarkerOrdinaryDispatchReady
; R2 is the exact logical row recovered by the existing inverse PLOT map.
; The material selector invalidates its face cache on each new command, so the
; first marker always reaches this hook before any same-face/row dispatch hit.
SkyMarkerInitializeBounds:
        sm      (GSU_SKY_MARKER_LOGICAL_Y_OFFSET), R2
        lm      R0, (GSU_SKY_PRESENT_OFFSET)
        moves   R0, R0
        bne     @Ready
        nop
        iwt     R4, #GSU_SKY_ROW_BOUNDS_OFFSET
        iwt     R0, #$00FF               ; empty min=255, max=0
.ifdef PLAYABLE_MAP_ID
        move    R1, #BSP_VIEW_HEIGHT
.else
        move    R1, #GSU_SKY_ROW_BOUNDS_ROWS
.endif
@Clear:
        movew   (R4), R0
        inc     R4
        inc     R4
        dec     R1
        bne     @Clear
        nop
        move    R0, #0
@Ready:
        GSU_ABSOLUTE_GOTO SkyMarkerBoundsPrepared

; The outer scan is bounded; ExtendRun intentionally retains its original
; viewport limit. A run reaching the conservative end sees one ordinary pixel
; outside it, or the actual viewport edge, preserving all DDA run endpoints.
SkyScanRowBounds:
        lm      R0, (SKY_SCAN_Y)
        add     R0
        iwt     R4, #GSU_SKY_ROW_BOUNDS_OFFSET
        with    R4
        add     R0
        move    R8, #0
        moveb   R8, (R4)
        inc     R4
        move    R9, #0
        moveb   R9, (R4)
        inc     R9
        sm      (SKY_ROW_SCAN_END), R9
        with    R8
        cmp     R9
        bcc     @Nonempty
        nop
        GSU_ABSOLUTE_GOTO SkyScanRowDone
@Nonempty:
        sm      (SKY_SCAN_X), R8
        GSU_ABSOLUTE_GOTO SkyScanPrepareRow
SkyScanResumeBounds:
        lm      R8, (SKY_SCAN_X)
        lm      R9, (SKY_ROW_SCAN_END)
SkyScanPrepareRow:
        ; No-call scan owns R3; SkyProcessRun may clobber it, so both row
        ; entry and run resume derive the OBJ row base again from mapped Y.
        lm      R2, (SKY_MAPPED_Y)
        move    R3, R2
        iwt     R1, #$FFF8
        with    R3
        and     R1
        with    R3
        swap
        with    R3
        lsr
        move    R0, R2
        and     #7
        add     R0
        with    R3
        add     R0
        ; Install the same cache anchor even if the first block is rejected
        ; or the row begins with surviving sky before the scalar backedge.
        GSU_ABSOLUTE_GOTO SkyScanPixelEntry, shared_delay
        cache
; Raw RAM loads do not drain either PLOT cache. Do this once before any
; block test; the established final RPIX still drains completed sky work.
SkyScanFlushBeforeBlocks:
        move    R0, #1
        ramb
        move    R1, #0
        move    R2, #0
        rpix
        GSU_ABSOLUTE_GOTO SkyCompositor+4


.if BSP_RENDER_SCALE = 2
.include "quake/SkyFloatNormalize.sgs"
.include "quake/SkyFloatRoundProduct.sgs"
.include "quake/SkyFloatMultiply.sgs"
.include "quake/SkyFloatAdd.sgs"
.include "quake/SkyFloatSqrt.sgs"
.include "quake/SkyFloatReciprocal.sgs"
.include "quake/SkyFloatEndpoint.sgs"
.include "quake/SkyFloatPhase.sgs"
.include "quake/SkyFloatProjectAdapter.sgs"
.include "quake/SkyExactGate.sgs"
.endif

SkyRomCodeEnd:
.assert ^SkyRomCodeStart = ($80+BSP_GSU_ROM2_BANK), lderror, "Sky compositor left GSU ROM bank $02"
.assert ^(SkyRomCodeEnd-1) = ($80+BSP_GSU_ROM2_BANK), lderror, "Sky compositor crosses its executable ROM bank"
