; Compile-time viewport constants. The generated fly3x copy changes SCALE
; and every private symbol name; neither renderer tests resolution at runtime.
BSP_RENDER_SCALE = 2
.if BSP_RENDER_SCALE = 2
BSP_VIEW_WIDTH = 128
.ifdef PLAYABLE_MAP_ID
BSP_VIEW_HEIGHT = BSP_PLAYABLE_X2_HEIGHT
BSP_VIEW_STAGE_BYTES = BSP_PLAYABLE_X2_STAGE_BYTES
.else
BSP_VIEW_HEIGHT = 112
BSP_VIEW_STAGE_BYTES = GSU_TEXTURE_VISIBLE_BYTES
.endif
BSP_VIEW_CENTER_X = 64
BSP_VIEW_RECIPROCAL_NUMERATOR = 24576
BSP_VIEW_SCREEN_ADMISSION_GUARD = 7
.else
BSP_VIEW_WIDTH = 85
.ifdef PLAYABLE_MAP_ID
BSP_VIEW_HEIGHT = BSP_PLAYABLE_X3_HEIGHT
BSP_VIEW_STAGE_BYTES = BSP_PLAYABLE_X3_STAGE_BYTES
.else
BSP_VIEW_HEIGHT = 74
BSP_VIEW_STAGE_BYTES = GSU_TEXTURE_VISIBLE_BYTES
.endif
; Round the camera center to a whole framebuffer texel in both projections.
BSP_VIEW_CENTER_X = 43
BSP_VIEW_RECIPROCAL_NUMERATOR = 16384
BSP_VIEW_SCREEN_ADMISSION_GUARD = 1
.endif
; The last playable X3 row is only partly visible, so its center rounds down.
BSP_VIEW_CENTER_Y = BSP_VIEW_HEIGHT / 2
BSP_VIEW_CENTER_X_Q7 = BSP_VIEW_CENTER_X * 128
BSP_VIEW_CENTER_Y_Q7 = BSP_VIEW_CENTER_Y * 128
