; Enabled-only dynamic-brush renderer staged into bank $70 below expansion
; tables. State zero never enters this segment.

.segment "GSU_BRUSH_CODE"

.export GSU_BrushTextureCode, GSU_BrushTextureLightmapCode

DynamicBrushOverlayStart:

.include "DynamicBrushMerge.sgs"
.include "DynamicBrushRaster.sgs"
.include "DynamicBrushArbiter.sgs"
.include "DynamicBrushArbiterSpan.sgs"
; Preserve the retained entry address while setup still fits its historical
; window. New overlay features may consume that dead padding and move the cold
; entry points earlier without changing their exported ABI.
.if * - DynamicBrushOverlayStart < $1AAF
  .repeat $1AAF - (* - DynamicBrushOverlayStart)
        nop
  .endrepeat
.endif

GSU_BrushTextureCode:
        move    R0, #2
        bra     BrushRendererStart
        nop

; Keep the address-sensitive technique-4 brush windows stable while obsolete
; entry slots remain vacant.
.res $10

GSU_BrushTextureLightmapCode:
        move    R0, #1

BrushRendererStart:
        sm      (TEXTURE_RENDER_MODE), R0
        iwt     R1, #BrushArbiterSpanAlbedo
        dec     R0
        bne     BrushRendererComposeReady
        nop
        iwt     R1, #BrushArbiterSpanLightmapped
BrushRendererComposeReady:
        sm      (BRUSH_ARBITER_COMPOSE_ROUTINE), R1
        jal     TexturePublishOrdinaryQ12Routes
        nop
        move    R0, #1
        ramb
        move    R0, #$11
        cmode
        iwt     R10, #COMMAND+12
        movew   R0, (R10)
        sm      (GSU_TELEMETRY_BRUSH_VISUAL_STATE), R0

        jal     LoadProjectedPacketState
        nop
        ; Packet selection's Q2 camera cache is phase-overlaid with the
        ; near-clip return words. Dynamic fragments invoke that clipper many
        ; times, so preserve a brush-private copy for every later face cull.
        lm      R0, (CAMERA_X)
        with    R0
        add     R0
        with    R0
        add     R0
        sm      (BRUSH_CAMERA_Q2_X), R0
        lm      R0, (CAMERA_Y)
        with    R0
        add     R0
        with    R0
        add     R0
        sm      (BRUSH_CAMERA_Q2_Y), R0
        lm      R0, (CAMERA_Z)
        with    R0
        add     R0
        with    R0
        add     R0
        sm      (BRUSH_CAMERA_Q2_Z), R0
        jal     BrushBuildMixedTokens
        nop
        lm      R0, (BRUSH_OVERFLOW)
        moves   R0, R0
        bne     BrushRenderFallbackWorld
        nop
        ; Zero admitted brush links leave the staged packet as the complete
        ; painter-ordered result. Reuse its normal renderer and avoid building
        ; a view cache only to traverse an equivalent world-only token stream.
        lm      R0, (BRUSH_OVERLAY_FLAGS)
        with    R0
        and     #BSP_OVERLAY_ALIAS_ENTITIES
        bne     BrushRenderMixed
        nop
        lm      R0, (BRUSH_LINK_COUNT)
        moves   R0, R0
        beq     BrushRenderFallbackWorld
        nop
BrushRenderMixed:
        jal     BuildPacketViewCache
        nop
        bra     BrushRenderMixedFast
        nop
        ; Reserved address-layout window outside the executed path preserves
        ; every qualified technique-4 brush overlay address.
        .res    $10
BrushRenderMixedFast:
        jal     BrushRenderMixedTokens
        nop
        bra     BrushRenderComplete
        nop
BrushRenderFallbackWorld:
        jal     TextureRenderFaces
        nop
        bra     BrushRenderComplete
        nop
  .repeat GSU_T4_BRUSH_FALLBACK_CAPACITY - (* - BrushRenderFallbackWorld)
        nop
  .endrepeat
BrushRenderFallbackWorldEnd:
BrushRenderComplete:
        GSU_FLUSH_PLOT 0, 0
        iwt     R10, #TELEMETRY
        iwt     R0, #$B529
        movew   (R10), R0
        stop
        nop

.include "PacketViewCache.sgs"

; Test-only coverage entry is cold and fits the always-loaded overlay. Keeping
; it here leaves the production GSUCODE cache layout independent of diagnostics.
GSU_CACHE_KERNEL_BEGIN GSU_CoverageCode
        moves   R0, R0
        beq     CoveragePhaseZero
        nop
        iwt     R4, #$AAAA
        iwt     R5, #$5555
        bra     CoveragePatternReady
        nop
CoveragePhaseZero:
        iwt     R4, #$5555
        iwt     R5, #$AAAA
CoveragePatternReady:
        move    R0, #0
        ramb
        iwt     R10, #FRAMEBUFFER
        iwt     R12, #GSU_LOGICAL_BYTES / 4
        iwt     R13, #CoveragePatternLoop
CoveragePatternLoop:
        movew   (R10), R4
        inc     R10
        inc     R10
        movew   (R10), R5
        inc     R10
        inc     R10
        loop
        nop
        move    R0, #1
        ramb
        iwt     R10, #COMMAND+5
        move    R0, #0
        moveb   R0, (R10)
        with    R0
        sex
        beq     CoverageFlatColorMode
        nop
        move    R0, #$12
        cmode
        bra     CoverageColorModeReady
        nop
CoverageFlatColorMode:
        move    R0, #$10
        cmode
CoverageColorModeReady:
        jal     LoadProjectedPacketState
        nop
        jal     RasterHotKernel
        nop
        jal     RenderFaces
        nop
        GSU_FLUSH_PLOT 0, 0
        move    R0, #0
        ramb
        jal     ExpandFrame
        nop
        move    R0, #1
        ramb
        iwt     R10, #TELEMETRY
        iwt     R0, #$B529
        movew   (R10), R0
        stop
        nop
GSU_CACHE_KERNEL_END GSU_CoverageCode

.include "TextureColdSpanSetup.sgs"

; The brush overlay has a small cold tail while auxiliary code is saturated.
; Alias rendering borrows it for cold presentation helpers used outside any
; dynamic-brush call, so their code and state lifetimes cannot overlap.
; Map one logical 128x112 coordinate to the GSU's tiled 2x presentation order.
; R0 is the logical input and mapped output; R4 is scratch so AliasRenderBillboard
; can retain its dynamic depth-plane cursor in R10 across both map calls.
AliasMapTextureCoordinate:
        iwt     R4, #GSU_TEXTURE_COORD_MAP_OFFSET
        with    R4
        add     R0
        move    R0, #0
        moveb   R0, (R4)
        ret
        nop

; Complete the first-sample clamp after the texture-tail DDA reduction. Keeping
; this cold return path here leaves enough hidden-row space for exact endpoint
; decomposition without changing either overlay boundary.
AliasInitializeAxisClampCold:
        dec     R2
        with    R4
        cmp     R2
        bcc     AliasInitializeAxisReady
        nop
        move    R4, R2
AliasInitializeAxisReady:
        ret
        nop

AliasRenderDone:
        ; Billboard state and texels select several QBA1 ROM banks. Restore
        ; the ordinary face sampler's published bank before mixed painting
        ; resumes, then return through the billboard's saved outer link.
        lm      R0, (TEXTURE_ROM_BANK)
        romb
        lm      R11, (ALIAS_RENDER_RETURN)
        ret
        nop

.assert * - GSU_BrushTextureCode <= GSU_BRUSH_CODE_CAPACITY, error, "Dynamic-brush renderer exceeds staged overlay"
