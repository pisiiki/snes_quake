
; Keep the dominant interior decoder inside the lightmap interpolation cache
; window. The technique-0/1 flat loop occupies this routine's former cold slot.
; Padding below retains the CPU-installed T4 overlays and cache-manifest
; addresses while hot instructions shrink inside their established windows.
LightmapSampleInteriorDirect:
        ; Both entries establish this source prefix in their jump slot.
        to      R3
        with    R8
        hib
        with    R8
        sex
        iwt     R1, #$00F0
        with    R3
        and     R1

        to      R5
        from    R9
        and     R1
        with    R9
        hib
        with    R9
        sex

        lm      R1, (LIGHTMAP_WIDTH)
        with    R9
        mult    R1
        to      R6
        from    R8
        add     R9
        ; This is the adjusted sampler's sole entry. R15 already names the
        ; target while its delay executes, so CACHE sees the same cache line.
        GSU_ABSOLUTE_GOTO LightmapSampleAdjustedHorizontalReady, shared_delay
        cache
  .repeat 5
        nop
  .endrepeat

; Face setup proves this route has equal power-of-two axes in one packed ROM
; bank. A Q4 mask and width-specific row-shift continuation replace four T
; shifts plus the per-pixel width multiply.
TextureSampleAbsolutePowerOfTwoSingleBank:
        lm      R5, (TEXTURE_SPAN_S)
        lm      R6, (TEXTURE_SPAN_T)
        ; Keep the ordinary entry's inputs and flags while skipping the cold
        ; gap now occupied by a private, cache-resident lightmap continuation.
        bra     TextureSampleAbsolutePowerOfTwoSingleBankRegisters
        nop
TextureUntexturedLightmapInteriorBlock:
TextureUntexturedLightmapInteriorSpanLoop:
        ; The common selector already leaves this entry in R13. Retaining it
        ; avoids returning to the uncached main-code tail for every pixel.
        iwt     R7, #TextureUntexturedLightmapSampleReady
        move    R8, R5
        move    R9, R6
        bra     LightmapSampleInteriorDirect
        with    R8
  .repeat $27DC - (* - GSU_SelectVisibility)
        nop
  .endrepeat
TextureSampleAbsolutePowerOfTwoSingleBankRegisters:
.if .defined(PLAYABLE_RECTANGULAR_POT_SAMPLER) && (BSP_RENDER_SCALE = 2)
        lm      R1, (TEXTURE_WRAP_MASK_S)
.else
        lm      R1, (TEXTURE_SPAN_SHADE_Q8)
.endif
        from    R5
        and     R1
        ; R0 is scratch until GETB. Keep the first three shifts implicit.
  .repeat 3
        lsr
  .endrepeat
        to      R5
        lsr
.if .defined(PLAYABLE_RECTANGULAR_POT_SAMPLER) && (BSP_RENDER_SCALE = 2)
        lm      R1, (TEXTURE_SPAN_SHADE_Q8)
.endif
        with    R6
        and     R1
        lm      R12, (TEXTURE_STEP_SHADE_Q8)
        jmp     R12
        with    R6
.if .defined(PLAYABLE_RECTANGULAR_POT_SAMPLER) && (BSP_RENDER_SCALE = 2)
.else
        ; Pin every row continuation in the alternate sampler.
  .repeat 3
        nop
  .endrepeat
.endif
TextureSamplePowerOfTwoRowShift3:
        add     R6
        with    R6
TextureSamplePowerOfTwoRowShift2:
        add     R6
        with    R6
TextureSamplePowerOfTwoRowShift1:
        add     R6
        with    R6
TextureSamplePowerOfTwoRowReady:
        add     R5
        lm      R4, (TEXTURE_ROM_ADDRESS)
        with    R4
        add     R6
        GSU_SET_ROM_BUFFER_ADDRESS R4
        ; Raw JMP resets the destination before GETB; RET inserts a delay NOP.
        ; Every sample supplies a fresh absolute R14 address.
        jmp     R11
        getb
        .res 3, $01
        nop

TextureLightmapInteriorSpanLoop:
        move    R8, R5
        move    R9, R6
        jal     TextureSampleAbsolutePowerOfTwoSingleBankRegisters
        move    R12, R0
        GSU_ABSOLUTE_GOTO LightmapSampleInteriorDirect, shared_delay
        with    R8

; Fraction carries advance exact finite-block coordinates without per-pixel
; residual branches. LOOP owns R12/R13; the shared tail restores the read pointer.
        with    R1
TextureBuildCoordinateLoop:
        add     R9
        with    R5
        adc     R7
        movew   (R10), R5
        inc     R10
        inc     R10
        with    R2
        add     R3
        with    R6
        adc     R8
        movew   (R10), R6
        inc     R10
        inc     R10
        loop
        with    R1
TextureBuildCoordinateDone:
.include "quake/TextureCoordinateReturn.sgs"

; Preloaded lightmap cells use the same resident window as the pixel loop.
LightmapSampleBlockBilinearCached:
        with    R3
        and     R1
        to      R5
        from    R9
        and     R1
        lm      R8, (LIGHTMAP_BLOCK_UL)
        lm      R9, (LIGHTMAP_BLOCK_UR)
        lm      R6, (LIGHTMAP_BLOCK_LL)
        lm      R11, (LIGHTMAP_BLOCK_LR)
        GSU_ABSOLUTE_GOTO LightmapSampleLowerReady
        .res 46 - (* - TextureBuildCoordinateLoop), $01
; The following slot shares the lightmap sampling window.
TextureCoordinateSetupSlotStart:
        .assert TextureCoordinateSetupSlotStart - TextureBuildCoordinateLoop = 46, error, "Coordinate loop moved following cache entries"
.if .defined(QUAKE_CACHED_LIGHTMAP_BLOCK8) && (BSP_RENDER_SCALE = 2)
.include "quake/MsuLightmapBlock8Cache.sgs"
.else
TextureDivideQ12Lookup:
TextureDivideQ12HotMirrorStart:
        iwt     R4, #GSU_DIVIDE_Q12_HOT_MIRROR_SAFE_ENTRIES+1
        with    R2
        cmp     R4
        bcs     TextureDivideQ12HotMirrorMissCached
        nop
        with    R2
        add     R2
        with    R2
        add     R2
        iwt     R4, #GSU_DIVIDE_Q12_HOT_MIRROR_OFFSET-GSU_DIVIDE_Q12_RECIPROCAL_ENTRY_BYTES
        with    R4
        add     R2
        move    R0, #0
        ramb
        movew   R12, (R4)
        inc     R4
        inc     R4
        movew   R13, (R4)
        move    R0, #1
        ramb
        jmp     R10
        nop
TextureDivideQ12HotMirrorMissCached:
        bra     TextureDivideQ12HotMirrorMissCold
        nop
; The sequential endpoint reader shares the non-MSU sampling window.
TexturePerspectiveSampleSpanBuffered:
        lm      R10, (GSU_TEXTURE_ENDPOINT_READ_PTR_OFFSET)
        moves   R10, R10
        beq     TexturePerspectiveSampleSpanBufferedFallbackCached
        movew   R5, (R10)
        inc     R10
        inc     R10
        movew   R6, (R10)
        inc     R10
        inc     R10
        sm      (GSU_TEXTURE_ENDPOINT_READ_PTR_OFFSET), R10
        ret
        nop
TexturePerspectiveSampleSpanBufferedFallbackCached:
        GSU_ABSOLUTE_GOTO TexturePerspectiveSampleSpan
.endif
TextureDivideQ12HotMirrorMissCold:
        move    R1, R2
        dec     R1
        GSU_ABSOLUTE_GOTO TextureDivideQ12HotMirrorMiss

; Keep signed mask interpolation in the divider's unused cache space.
FlyBrushMaskDepthFinishCached:
        BSP_SIGNED_MUL_SHIFT_TRUNC12 R0, R7, R3
        with    R5
        add     R0
        lm      R11, (FLY_MASK_DEPTH_RETURN)
        ret
        nop
FlyBrushMaskDepthFinishCachedEnd:
.assert * - FlyBrushMaskDepthFinishCached = $2D, error, "Cached mask finish changed footprint"

  .repeat $73 - (* - TextureCoordinateSetupSlotStart)
        nop
  .endrepeat
; Keep the old lightmap entry, and cache the exact mask perspective factor
; beside its shared reciprocal lookup/multiply during visibility tests.
LightmapPrepareCachedContinue:
        GSU_ABSOLUTE_GOTO LightmapPrepareCachedContinueCold
FlyMaskPerspectiveFactorQ12:
        lm      R5, (TEXTURE_BASE_DEPTH)
; Ordinary spans retain their selected lookup/loaded pair. The edge overlays
; enter Products with a cache-local lookup in R13; arithmetic preserves R10/R13.
FlyMaskPerspectiveFactorQ12BaseLoaded:
        lm      R10, (TEXTURE_Q12_LOADED_ROUTINE)
        lm      R13, (TEXTURE_Q12_LOOKUP_ROUTINE)
FlyMaskPerspectiveFactorQ12Products:
        ; Three doubles scale Q12 to Q15 without wrapping for factors below
        ; unity. The only negative result is exactly 4096, handled directly.
        ; R0 is dead before either multiply/unity continuation. The final
        ; ADD has the original 4*factor operands, including all16-bit flags.
        from    R3
        add     R3
        add     R0
        to      R6
        add     R0
        bpl     FlyMaskPerspectiveFactorScaledProducts
        nop
        GSU_ABSOLUTE_GOTO FlyMaskPerspectiveFactorUnityProductsCold
        ; Both paths already exited; retain every following public entry.
  .repeat 3
        nop
  .endrepeat
FlyMaskPerspectiveFactorScaledProducts:
        ; Base depth is nonnegative; its floor product needs no signed
        ; truncation correction. Delta depth retains exact toward-zero rules.
        BSP_SIGNED_MUL_SCALED8_SHIFT12 R5
        move    R12, R0
        lm      R7, (TEXTURE_DELTA_DEPTH)
        BSP_SIGNED_MUL_SCALED8_SHIFT_TRUNC12 R7
        move    R1, R0
        bra     FlyMaskPerspectiveFactorProductsReady
        nop
  .repeat 4
        nop
  .endrepeat
FlyMaskPerspectiveFactorProductsReady:
        to      R2
        from    R5
        add     R7
        with    R2
        sub     R1

        from    R12
        cmp     R2
        bne     FlyMaskPerspectiveFactorDivide
        nop
        iwt     R3, #4096
        ret
        nop
        nop                             ; Preserve the divide entry address.
FlyMaskPerspectiveFactorDivide:
        ; Dispatch the exact quotient using the caller's resident cache.
        move    R8, R12
        move    R9, R2
        ; R13 retains the caller-selected lookup; R10 is its loaded continuation.
        jmp     R13
        nop

.assert * - FlyMaskPerspectiveFactorQ12 = $4F, error, "Mask factor clone footprint changed"
.res $59 - (* - LightmapPrepareCachedContinue), $01
LightmapPrepareBlockDone:
        GSU_ABSOLUTE_GOTO TextureLightmapSelectBlockRoutine

FlyMaskPerspectiveFactorUnityProductsCold:
        move    R12, R5
        lm      R7, (TEXTURE_DELTA_DEPTH)
        move    R1, R7
        GSU_ABSOLUTE_GOTO FlyMaskPerspectiveFactorProductsReady

.assert * - FlyMaskPerspectiveFactorUnityProductsCold = 11, error, "Mask unity clone changed"

        ; Absorb cold setup/selector size changes while every qualified
        ; cache-kernel address remains stable.
        .repeat 0
        nop
        .endrepeat

;-------------------------------------------------------------------------------
; Clip one complete convex BSP face against a wide four-plane view pyramid,
; project it at Q7 subpixel precision, then emit one exact pixel-center span
; per covered row. The wide planes bound division without acting as a semantic
; near plane. Viewport guards bound |axis|/depth by one.
  .repeat $2920 - (* - GSU_SelectVisibility)
        nop
  .endrepeat
GSU_CACHE_KERNEL_BEGIN RenderConvexFace
        sm      (CONVEX_RETURN), R11
        iwt     R0, #CONVEX_VIEW_A
        sm      (CONVEX_OUTPUT_CURSOR), R0
        move    R0, #0
        sm      (CONVEX_OUTPUT_COUNT), R0
        lm      R0, (CONVEX_FACE_VERTICES)
        sm      (CONVEX_EDGE_COUNT), R0
ConvexTransformLoop:
        lm      R10, (CONVEX_INDEX_PTR)
        movew   R0, (R10)
        inc     R10
        inc     R10
        sm      (CONVEX_INDEX_PTR), R10
        sm      (CLIP_VERTEX_INDEX), R0
        jal     ClipTransformVertex
        nop
        CONVEX_EMIT_VIEW CLIP_RIGHT, CLIP_UP, CLIP_DEPTH
        lm      R0, (CONVEX_EDGE_COUNT)
        dec     R0
        sm      (CONVEX_EDGE_COUNT), R0
        bne     ConvexTransformLoop
        nop

        iwt     R0, #CONVEX_VIEW_A
        sm      (CONVEX_INPUT_PTR), R0
        iwt     R0, #CONVEX_VIEW_B
        sm      (CONVEX_OUTPUT_PTR), R0
        lm      R0, (CONVEX_OUTPUT_COUNT)
        sm      (CONVEX_COUNT), R0
        move    R0, #0
        sm      (CONVEX_PLANE), R0
ConvexPlaneLoop:
        jal     ConvexClipPlane
        nop
        lm      R0, (CONVEX_OUTPUT_COUNT)
        move    R1, #3
        with    R0
        cmp     R1
        bcs     ConvexPlaneHasPolygon
        nop
        GSU_ABSOLUTE_GOTO ConvexFaceDone
ConvexPlaneHasPolygon:
        sm      (CONVEX_COUNT), R0
        lm      R1, (CONVEX_INPUT_PTR)
        lm      R2, (CONVEX_OUTPUT_PTR)
        sm      (CONVEX_INPUT_PTR), R2
        sm      (CONVEX_OUTPUT_PTR), R1
        lm      R0, (CONVEX_PLANE)
        inc     R0
        sm      (CONVEX_PLANE), R0
        move    R1, #4
        with    R0
        cmp     R1
        bne     ConvexPlaneLoop
        nop

        jal     ConvexProjectPolygon
        nop
        moves   R0, R0
        beq     ConvexFaceDone
        nop
        jal     ConvexRasterPolygon
        nop
ConvexFaceDone:
        lm      R11, (CONVEX_RETURN)
        ret
        nop
        .res $00B1 - (* - RenderConvexFace)
GSU_CACHE_KERNEL_END RenderConvexFace

; Return unsigned magnitude in R0 and 1=inside/0=outside in R1 for the current
; wide frustum plane. Halving both Q6 terms before the sum keeps the exact
; signed result in one word; the common scale cancels in edge interpolation.
ConvexComputeDistance:
        move    R4, R3
        with    R4
        asr
        lm      R0, (CONVEX_PLANE)
        to      R5
        and     #2
        beq     ConvexDistanceUseRight
        nop
        move    R5, R2
        bra     ConvexDistanceAxisReady
        nop
ConvexDistanceUseRight:
        move    R5, R1
ConvexDistanceAxisReady:
        with    R5
        asr
        lm      R0, (CONVEX_PLANE)
        moves   R0, R0
        beq     ConvexDistanceAdd
        dec     R0
        beq     ConvexDistanceSubtract
        dec     R0
        beq     ConvexDistanceSubtract
        nop
ConvexDistanceAdd:
        with    R4
        add     R5
        bra     ConvexDistanceSigned
        nop
ConvexDistanceSubtract:
        with    R4
        sub     R5
ConvexDistanceSigned:
        moves   R4, R4
        bmi     ConvexDistanceOutside
        nop
        move    R0, R4
        move    R1, #1
        ret
        nop
ConvexDistanceOutside:
        move    R0, #0
        sub     R4
        move    R1, #0
        ret
        nop

  .repeat $2A20 - (* - GSU_SelectVisibility)
        nop
  .endrepeat
GSU_CACHE_KERNEL_BEGIN ConvexClipPlane
        sm      (CONVEX_CLIP_RETURN), R11
        move    R0, #0
        sm      (CONVEX_OUTPUT_COUNT), R0
        lm      R0, (CONVEX_OUTPUT_PTR)
        sm      (CONVEX_OUTPUT_CURSOR), R0

        ; Seed the closed edge walk with the last input vertex.
        lm      R0, (CONVEX_COUNT)
        dec     R0
        to      R1
        add     R0                       ; 2n
        to      R2
        from    R1
        add     R1                       ; 4n
        with    R1
        add     R2                       ; 6n
        lm      R10, (CONVEX_INPUT_PTR)
        with    R10
        add     R1
        CONVEX_LOAD_VIEW R10, CONVEX_PREV_RIGHT, CONVEX_PREV_UP, CONVEX_PREV_DEPTH
        lm      R1, (CONVEX_PREV_RIGHT)
        lm      R2, (CONVEX_PREV_UP)
        lm      R3, (CONVEX_PREV_DEPTH)
        jal     ConvexComputeDistance
        nop
        sm      (CONVEX_PREV_MAG), R0
        sm      (CONVEX_PREV_INSIDE), R1

        lm      R0, (CONVEX_INPUT_PTR)
        sm      (CONVEX_CURRENT_PTR), R0
        lm      R0, (CONVEX_COUNT)
        sm      (CONVEX_EDGE_COUNT), R0
ConvexClipEdgeLoop:
        lm      R10, (CONVEX_CURRENT_PTR)
        CONVEX_LOAD_VIEW R10, CONVEX_CUR_RIGHT, CONVEX_CUR_UP, CONVEX_CUR_DEPTH
        inc     R10
        inc     R10
        sm      (CONVEX_CURRENT_PTR), R10
        lm      R1, (CONVEX_CUR_RIGHT)
        lm      R2, (CONVEX_CUR_UP)
        lm      R3, (CONVEX_CUR_DEPTH)
        jal     ConvexComputeDistance
        nop
        sm      (CONVEX_CUR_MAG), R0
        sm      (CONVEX_CUR_INSIDE), R1

        lm      R0, (CONVEX_PREV_INSIDE)
        lm      R1, (CONVEX_CUR_INSIDE)
        with    R0
        xor     R1
        bne     :+
        nop
        iwt     R13, #ConvexClipNoTransition
        jmp     R13
        nop
:
        moves   R1, R1
        beq     ConvexClipPreviousInside
        nop
        BSP_CLIP_COPY_VIEW CONVEX_CUR_RIGHT, CONVEX_CUR_UP, CONVEX_CUR_DEPTH, CONVEX_IN_RIGHT, CONVEX_IN_UP, CONVEX_IN_DEPTH
        BSP_CLIP_COPY_VIEW CONVEX_PREV_RIGHT, CONVEX_PREV_UP, CONVEX_PREV_DEPTH, CONVEX_OUT_RIGHT, CONVEX_OUT_UP, CONVEX_OUT_DEPTH
        lm      R0, (CONVEX_CUR_MAG)
        sm      (CONVEX_INSIDE_MAG), R0
        lm      R0, (CONVEX_PREV_MAG)
        sm      (CONVEX_OUTSIDE_MAG), R0
        bra     ConvexClipInterpolate
        nop
ConvexClipPreviousInside:
        BSP_CLIP_COPY_VIEW CONVEX_PREV_RIGHT, CONVEX_PREV_UP, CONVEX_PREV_DEPTH, CONVEX_IN_RIGHT, CONVEX_IN_UP, CONVEX_IN_DEPTH
        BSP_CLIP_COPY_VIEW CONVEX_CUR_RIGHT, CONVEX_CUR_UP, CONVEX_CUR_DEPTH, CONVEX_OUT_RIGHT, CONVEX_OUT_UP, CONVEX_OUT_DEPTH
        lm      R0, (CONVEX_PREV_MAG)
        sm      (CONVEX_INSIDE_MAG), R0
        lm      R0, (CONVEX_CUR_MAG)
        sm      (CONVEX_OUTSIDE_MAG), R0
ConvexClipInterpolate:
        jal     ConvexInterpolateEdge
        nop
        CONVEX_EMIT_VIEW CONVEX_INTER_RIGHT, CONVEX_INTER_UP, CONVEX_INTER_DEPTH
ConvexClipNoTransition:
        lm      R0, (CONVEX_CUR_INSIDE)
        moves   R0, R0
        beq     ConvexClipAdvance
        nop
        CONVEX_EMIT_VIEW CONVEX_CUR_RIGHT, CONVEX_CUR_UP, CONVEX_CUR_DEPTH
ConvexClipAdvance:
        BSP_CLIP_COPY_VIEW CONVEX_CUR_RIGHT, CONVEX_CUR_UP, CONVEX_CUR_DEPTH, CONVEX_PREV_RIGHT, CONVEX_PREV_UP, CONVEX_PREV_DEPTH
        lm      R0, (CONVEX_CUR_MAG)
        sm      (CONVEX_PREV_MAG), R0
        lm      R0, (CONVEX_CUR_INSIDE)
        sm      (CONVEX_PREV_INSIDE), R0
        lm      R0, (CONVEX_EDGE_COUNT)
        dec     R0
        sm      (CONVEX_EDGE_COUNT), R0
        beq     :+
        nop
        iwt     R13, #ConvexClipEdgeLoop
        jmp     R13
        nop
:
        lm      R11, (CONVEX_CLIP_RETURN)
        ret
        nop
        .res $0178 - (* - ConvexClipPlane)
GSU_CACHE_KERNEL_END ConvexClipPlane

  .repeat $2BA0 - (* - GSU_SelectVisibility)
        nop
  .endrepeat
GSU_CACHE_KERNEL_BEGIN ConvexInterpolateEdge
        sm      (CONVEX_INTERPOLATE_RETURN), R11
        lm      R1, (CONVEX_INSIDE_MAG)
        lm      R2, (CONVEX_OUTSIDE_MAG)
ConvexInterpolateScale:
        move    R0, R1
        add     R2
        bcs     ConvexInterpolateScaleDown
        nop
        bpl     ConvexInterpolateDivideReady
        nop
ConvexInterpolateScaleDown:
        with    R1
        lsr
        with    R2
        lsr
        bne     ConvexInterpolateScale
        nop
        move    R2, #1
        bra     ConvexInterpolateScale
        nop
ConvexInterpolateDivideReady:
        move    R0, R1                   ; Remainder/numerator.
        to      R1
        add     R2                       ; Positive denominator.
        move    R3, #0
        move    R12, #12
        iwt     R13, #ConvexInterpolateDivideLoop
ConvexInterpolateDivideLoop:
        with    R0
        add     R0
        with    R3
        add     R3
        to      R2
        sub     R1
        bcc     ConvexInterpolateDivideNext
        nop
        move    R0, R2
        inc     R3
ConvexInterpolateDivideNext:
        loop
        nop

        iwt     R1, #2048
        move    R0, R3
        cmp     R1
        bcc     ConvexInterpolateInsideBase
        nop
        iwt     R0, #4096
        sub     R3
        sm      (CONVEX_FACTOR), R0
        BSP_CLIP_COPY_VIEW CONVEX_OUT_RIGHT, CONVEX_OUT_UP, CONVEX_OUT_DEPTH, CONVEX_BASE_RIGHT, CONVEX_BASE_UP, CONVEX_BASE_DEPTH
        lm      R0, (CONVEX_IN_RIGHT)
        lm      R1, (CONVEX_OUT_RIGHT)
        sub     R1
        sm      (CONVEX_DELTA_RIGHT), R0
        lm      R0, (CONVEX_IN_UP)
        lm      R1, (CONVEX_OUT_UP)
        sub     R1
        sm      (CONVEX_DELTA_UP), R0
        lm      R0, (CONVEX_IN_DEPTH)
        lm      R1, (CONVEX_OUT_DEPTH)
        sub     R1
        sm      (CONVEX_DELTA_DEPTH), R0
        bra     ConvexInterpolateComponents
        nop
ConvexInterpolateInsideBase:
        sm      (CONVEX_FACTOR), R3
        BSP_CLIP_COPY_VIEW CONVEX_IN_RIGHT, CONVEX_IN_UP, CONVEX_IN_DEPTH, CONVEX_BASE_RIGHT, CONVEX_BASE_UP, CONVEX_BASE_DEPTH
        lm      R0, (CONVEX_OUT_RIGHT)
        lm      R1, (CONVEX_IN_RIGHT)
        sub     R1
        sm      (CONVEX_DELTA_RIGHT), R0
        lm      R0, (CONVEX_OUT_UP)
        lm      R1, (CONVEX_IN_UP)
        sub     R1
        sm      (CONVEX_DELTA_UP), R0
        lm      R0, (CONVEX_OUT_DEPTH)
        lm      R1, (CONVEX_IN_DEPTH)
        sub     R1
        sm      (CONVEX_DELTA_DEPTH), R0
ConvexInterpolateComponents:
        lm      R5, (CONVEX_BASE_RIGHT)
        lm      R7, (CONVEX_DELTA_RIGHT)
        lm      R8, (CONVEX_FACTOR)
        BSP_CLIP_MUL_VIEW12 R2, R7, R8
        with    R5
        add     R2
        sm      (CONVEX_INTER_RIGHT), R5
        lm      R5, (CONVEX_BASE_UP)
        lm      R7, (CONVEX_DELTA_UP)
        lm      R8, (CONVEX_FACTOR)
        BSP_CLIP_MUL_VIEW12 R2, R7, R8
        with    R5
        add     R2
        sm      (CONVEX_INTER_UP), R5
        lm      R5, (CONVEX_BASE_DEPTH)
        lm      R7, (CONVEX_DELTA_DEPTH)
        lm      R8, (CONVEX_FACTOR)
        BSP_CLIP_MUL_VIEW12 R2, R7, R8
        with    R5
        add     R2
        sm      (CONVEX_INTER_DEPTH), R5
        lm      R11, (CONVEX_INTERPOLATE_RETURN)
        ret
        nop
        ; X2's cold reciprocal lookup reuses the unreachable post-RET slot.
  .if BSP_RENDER_SCALE = 2
        .include "quake/PacketProjectionReciprocalROM.sgs"
  .endif
; Depth-only brush views supply packed XY in R4 and Z/residuals in R7.
; Decode in this retired padding, then reuse the packet decoder without
; changing its hot entry. CACHE anchors at $ECE0 and includes the shared RET.
ClipTransformPackedQ2Registers:
        cache
        move    R1, R4
        with    R1
        sex
        move    R2, R4
        with    R2
        hib
        with    R2
        sex
        move    R3, R7
        with    R3
        sex
        with    R7
        hib
        bra     ClipTransformPackedQ2Coordinates
        nop
        ; Preserve the retired slot after the branch delay; never executed.
        nop
        nop
        nop
.assert * - ClipTransformPackedQ2Registers = 23, error, "Packed Q2 adapter changed its bounded footprint"
; The packed transform's existing $ECE0 cache also owns these two retired
; padding slots. Store raw right/up before halving, then finish in its tail.
FlyBrushDepthClassifyStore:
        lm      R1, (CLIP_RIGHT)
        movew   (R9), R1
        inc     R9
        inc     R9
        lm      R2, (CLIP_UP)
        movew   (R9), R2
        inc     R9
        inc     R9
        GSU_ABSOLUTE_GOTO FlyBrushDepthClassifyStorePlanes
.assert * - FlyBrushDepthClassifyStore <= 20, error, "Fly depth store exceeds the packed adapter padding"
        .res $0176 - (* - ConvexInterpolateEdge)
GSU_CACHE_KERNEL_END ConvexInterpolateEdge

.include "quake/VertexTransform.sgs"

; Store exact R12 depth in the ten-byte XYZ/zero-S/T record.
; ROL collects the signs of the bounded half-coordinate sums in bits 3..0.
FlyBrushDepthClassifyStorePlanes:
        movew   (R9), R12
        inc     R9
        inc     R9
        move    R0, #0
        stw     (R9)
        inc     R9
        inc     R9
        stw     (R9)
        inc     R9
        to      R4
        from    R12
        asr
        with    R1
        asr
        with    R2
        asr
        to      R6
        from    R4
        add     R2
        with    R6
        rol
        with    R0
        rol
        to      R6
        from    R4
        sub     R2
        with    R6
        rol
        with    R0
        rol
        to      R6
        from    R4
        sub     R1
        with    R6
        rol
        with    R0
        rol
        to      R6
        from    R4
        add     R1
        with    R6
        rol
        to      R2
        from    R0
        rol
        ; Keep the OR outcode in R8's low byte and the AND outcode in its high byte.
        with    R8
        or      R2
        to      R6
        from    R2
        swap
        with    R6
        or      #15
        with    R8
        and     R6
        jmp     R11                     ; Increment in the hardware delay slot.
        inc     R9
FlyBrushDepthClassifyStoreEnd:
        .res 65 - (* - FlyBrushDepthClassifyStorePlanes), $01
.assert FlyBrushDepthClassifyStoreEnd - FlyBrushDepthClassifyStorePlanes <= 65, error, "Fly depth classify/store exceeds the transform padding"
.assert ^FlyBrushDepthClassifyStore = ^FlyBrushDepthClassifyStoreEnd, lderror, "Fly depth classify/store crosses its code bank"
.assert .loword(FlyBrushDepthClassifyStoreEnd) <= ((.loword(ClipTransformPackedQ2Registers + 1) & $FFF0) + $0200), lderror, "Fly depth classify/store escapes the packed transform cache"
  .if BSP_RENDER_SCALE = 2
.include "quake/PacketDepthRight.sgs"
  .endif
  .repeat $2EA0 - (* - GSU_SelectVisibility)
        nop
  .endrepeat
GSU_CACHE_KERNEL_BEGIN ConvexProjectPolygon
        sm      (CONVEX_PROJECT_RETURN), R11
        iwt     R0, #24576
        sm      (CONVEX_MIN_Y), R0
        iwt     R0, #-8192
        sm      (CONVEX_MAX_Y), R0
        lm      R0, (CONVEX_INPUT_PTR)
        sm      (CONVEX_CURRENT_PTR), R0
        iwt     R0, #CONVEX_SCREEN
        sm      (CONVEX_SCREEN_PTR), R0
        lm      R0, (CONVEX_COUNT)
        sm      (CONVEX_SCREEN_COUNT), R0
        sm      (CONVEX_EDGE_COUNT), R0
ConvexProjectLoop:
        lm      R10, (CONVEX_CURRENT_PTR)
        CONVEX_LOAD_VIEW R10, CONVEX_CUR_RIGHT, CONVEX_CUR_UP, CONVEX_CUR_DEPTH
        inc     R10
        inc     R10
        sm      (CONVEX_CURRENT_PTR), R10

        ; Both screen components share this vertex's exact depth reciprocal.
        lm      R2, (CONVEX_CUR_DEPTH)
        jal     TexturePrepareDivideQ12
        nop
        lm      R1, (CONVEX_CUR_RIGHT)
        lm      R2, (CONVEX_CUR_DEPTH)
        jal     ConvexProjectComponent
        nop
        iwt     R1, #BSP_VIEW_CENTER_X_Q7               ; 64 logical pixels in Q7.
        with    R0
        add     R1
        lm      R10, (CONVEX_SCREEN_PTR)
        movew   (R10), R0
        inc     R10
        inc     R10

        lm      R1, (CONVEX_CUR_UP)
        lm      R2, (CONVEX_CUR_DEPTH)
        jal     ConvexProjectComponent
        nop
        iwt     R1, #BSP_VIEW_CENTER_Y_Q7               ; 56 logical pixels in Q7.
        with    R1
        sub     R0
        movew   (R10), R1

        lm      R2, (CONVEX_MIN_Y)
        to      R3
        from    R1
        sub     R2
        bpl     ConvexProjectMinReady
        nop
        sm      (CONVEX_MIN_Y), R1
        move    R0, R10
        dec     R0
        dec     R0
        sm      (CONVEX_TOP_PTR), R0
ConvexProjectMinReady:
        lm      R2, (CONVEX_MAX_Y)
        to      R3
        from    R2
        sub     R1
        bpl     ConvexProjectMaxReady
        nop
        sm      (CONVEX_MAX_Y), R1
ConvexProjectMaxReady:
        inc     R10
        inc     R10
        sm      (CONVEX_SCREEN_PTR), R10
        lm      R0, (CONVEX_EDGE_COUNT)
        dec     R0
        sm      (CONVEX_EDGE_COUNT), R0
        beq     ConvexProjectDone
        nop
        GSU_ABSOLUTE_GOTO ConvexProjectLoop
ConvexProjectDone:
        lm      R0, (CONVEX_SCREEN_PTR)
        sm      (CONVEX_SCREEN_END_PTR), R0
        lm      R0, (CONVEX_TOP_PTR)
        sm      (CONVEX_FORWARD_PTR), R0
        sm      (CONVEX_REVERSE_PTR), R0

        ; Pixel centers cover minY <= y*128+64 < maxY. Compute that bounded
        ; logical row interval once; CONVEX_TOP_PTR is free to hold lastY.
        lm      R0, (CONVEX_MIN_Y)
        iwt     R1, #63
        with    R0
        add     R1
  .repeat 7
        with    R0
        asr
  .endrepeat
        moves   R0, R0
        bpl     ConvexRasterFirstYPositive
        nop
        move    R0, #0
ConvexRasterFirstYPositive:
        move    R1, #BSP_VIEW_HEIGHT-1
        with    R1
        sub     R0
        bpl     ConvexRasterFirstYReady
        nop
        GSU_ABSOLUTE_GOTO ConvexProjectRejected
ConvexRasterFirstYReady:
        sm      (CONVEX_RASTER_Y), R0

        lm      R0, (CONVEX_MAX_Y)
        iwt     R1, #65
        with    R0
        sub     R1
  .repeat 7
        with    R0
        asr
  .endrepeat
        moves   R0, R0
        bpl     ConvexRasterLastYPositive
        nop
        GSU_ABSOLUTE_GOTO ConvexProjectRejected
ConvexRasterLastYPositive:
        move    R1, #BSP_VIEW_HEIGHT-1
        to      R2
        from    R1
        sub     R0
        bpl     ConvexRasterLastYReady
        nop
        move    R0, R1
ConvexRasterLastYReady:
        lm      R1, (CONVEX_RASTER_Y)
        to      R2
        sub     R1
        bpl     ConvexRasterRowsReady
        nop
        GSU_ABSOLUTE_GOTO ConvexProjectRejected
ConvexRasterRowsReady:
        sm      (CONVEX_TOP_PTR), R0
        move    R0, #1
        bra     ConvexProjectReturn
        nop
ConvexProjectRejected:
        move    R0, #0
ConvexProjectReturn:
        lm      R11, (CONVEX_PROJECT_RETURN)
        ret
        nop
        .res $0126 - (* - ConvexProjectPolygon)
GSU_CACHE_KERNEL_END ConvexProjectPolygon

; R1=signed Q6 component, R2=positive Q6 depth. Return signed Q7 screen
; delta in R0 and the legacy signed Q11 quotient in R3. X2 retains Q12 for R0.
; The ordinary entry preserves +/-depth saturation. Coherent alias endpoints
; set R4 nonzero and enter after that mode initializer; their rectangle-level
; same-side classification makes the unsaturated quotient safe and necessary.
ConvexProjectComponent:
        move    R4, #0
ConvexProjectComponentUnsaturated:
        move    R0, #0
        sm      (CONVEX_CUR_INSIDE), R0
        moves   R1, R1
        bpl     ConvexProjectMagnitudeReady
        nop
        move    R0, #0
        sub     R1
        move    R1, R0
        move    R0, #1
        sm      (CONVEX_CUR_INSIDE), R0
ConvexProjectMagnitudeReady:
        ; Every caller supplies a post-near-clip positive depth. R4 selects
        ; only whether the already-classified alias endpoint bypasses the
        ; ordinary component clamp.
        moves   R4, R4
        bne     ConvexProjectDivide
        nop
        move    R0, R1
        cmp     R2
        bcc     ConvexProjectDivide
        nop
.if BSP_RENDER_SCALE = 2
        iwt     R3, #4096
.else
        iwt     R3, #2048
.endif
        bra     ConvexProjectSignedQuotient
        nop
ConvexProjectDivide:
        move    R0, R1
        ; Keep the exact Q12 quotient for X2's 3*q screen delta before halving
        ; it for the legacy R3 alias ABI. X3 retains its original Q11 scaling.
        move    R7, R11
        move    R5, R10
        jal     TextureDivideQ12Prepared
        nop
        move    R10, R5
        move    R11, R7
.if BSP_RENDER_SCALE <> 2
        with    R3
        lsr
.endif
ConvexProjectSignedQuotient:
.if BSP_RENDER_SCALE = 2
        move    R0, R3
        add     R0
        add     R3
        with    R3
        lsr
.endif
        lm      R1, (CONVEX_CUR_INSIDE)
        moves   R1, R1
        beq     ConvexProjectScale
        nop
        move    R1, #0
        with    R1
        sub     R3
        move    R3, R1
.if BSP_RENDER_SCALE = 2
        not
        inc     R0
.endif
ConvexProjectScale:
.if BSP_RENDER_SCALE <> 2
        move    R0, R3
        add     R0                       ; 2q
        to      R1
        from    R3
        add     R3
        with    R1
        add     R1                       ; 4q
        move    R0, R1                  ; 4q: focal length 64.
.endif
ConvexProjectComponentDone:
        ret
        nop

  .repeat $3020 - (* - GSU_SelectVisibility)
        nop
  .endrepeat
GSU_CACHE_KERNEL_BEGIN ConvexRasterPolygon
        sm      (CONVEX_RASTER_RETURN), R11
ConvexRasterRowLoop:
        lm      R0, (CONVEX_RASTER_Y)
  .repeat 7
        with    R0
        add     R0
  .endrepeat
        iwt     R1, #64
        with    R0
        add     R1
        sm      (CONVEX_SAMPLE_Y), R0

        ; Advance each boundary from the top vertex only when its next vertex
        ; no longer lies above the half-open row sample. The edge-count guard
        ; makes malformed input terminate rather than spin inside a frame.
        lm      R10, (CONVEX_FORWARD_PTR)
        lm      R12, (CONVEX_SCREEN_COUNT)
ConvexRasterForwardAdvance:
        to      R9
        from    R10
        add     #4
        lm      R0, (CONVEX_SCREEN_END_PTR)
        with    R9
        cmp     R0
        bne     ConvexRasterForwardNextReady
        nop
        iwt     R9, #CONVEX_SCREEN
ConvexRasterForwardNextReady:
        move    R8, R9
        inc     R8
        inc     R8
        movew   R1, (R8)
        lm      R0, (CONVEX_SAMPLE_Y)
        to      R2
        from    R1
        sub     R0
        moves   R2, R2
        bmi     ConvexRasterForwardStep
        nop
        beq     ConvexRasterForwardStep
        nop
        sm      (CONVEX_FORWARD_PTR), R10
        movew   R4, (R10)
        inc     R10
        inc     R10
        movew   R5, (R10)
        movew   R6, (R9)
        move    R10, R9
        inc     R10
        inc     R10
        movew   R7, (R10)
        jal     ConvexIntersectActiveEdge
        nop
        sm      (CONVEX_MIN_X), R0
        bra     ConvexRasterReverseBegin
        nop
ConvexRasterForwardStep:
        move    R10, R9
        dec     R12
        bne     ConvexRasterForwardAdvance
        nop
        GSU_ABSOLUTE_GOTO ConvexRasterDone

ConvexRasterReverseBegin:
        lm      R10, (CONVEX_REVERSE_PTR)
        lm      R12, (CONVEX_SCREEN_COUNT)
ConvexRasterReverseAdvance:
        iwt     R0, #CONVEX_SCREEN
        with    R10
        cmp     R0
        bne     ConvexRasterReverseNoWrap
        nop
        lm      R9, (CONVEX_SCREEN_END_PTR)
        with    R9
        sub     #4
        bra     ConvexRasterReverseNextReady
        nop
ConvexRasterReverseNoWrap:
        to      R9
        from    R10
        sub     #4
ConvexRasterReverseNextReady:
        move    R8, R9
        inc     R8
        inc     R8
        movew   R1, (R8)
        lm      R0, (CONVEX_SAMPLE_Y)
        to      R2
        from    R1
        sub     R0
        moves   R2, R2
        bpl     ConvexRasterReverseNonNegative
        nop
ConvexRasterReverseStep:
        move    R10, R9
        dec     R12
        bne     ConvexRasterReverseContinue
        nop
        GSU_ABSOLUTE_GOTO ConvexRasterDone
ConvexRasterReverseContinue:
        GSU_ABSOLUTE_GOTO ConvexRasterReverseAdvance
ConvexRasterReverseNonNegative:
        beq     ConvexRasterReverseStep
        nop
        sm      (CONVEX_REVERSE_PTR), R10
        movew   R4, (R10)
        inc     R10
        inc     R10
        movew   R5, (R10)
        movew   R6, (R9)
        move    R10, R9
        inc     R10
        inc     R10
        movew   R7, (R10)
        jal     ConvexIntersectActiveEdge
        nop

        lm      R1, (CONVEX_MIN_X)
        to      R2
        sub     R1
        bpl     ConvexRasterXOrderReady
        nop
        sm      (CONVEX_MIN_X), R0
        sm      (CONVEX_MAX_X), R1
        bra     ConvexRasterXBoundsReady
        nop
ConvexRasterXOrderReady:
        sm      (CONVEX_MAX_X), R0
ConvexRasterXBoundsReady:
        lm      R1, (CONVEX_MIN_X)
        iwt     R0, #59
        with    R1
        add     R0                     ; ceil((min - 68) / 128)
  .repeat 7
        with    R1
        asr
  .endrepeat
        moves   R1, R1
        bpl     ConvexRasterFirstReady
        nop
        move    R1, #0
ConvexRasterFirstReady:
        lm      R3, (CONVEX_MAX_X)
        iwt     R0, #60
        with    R3
        sub     R0                     ; floor((max - 60) / 128)
  .repeat 7
        with    R3
        asr
  .endrepeat
        move    R0, #BSP_VIEW_WIDTH-1
        to      R4
        sub     R3
        bpl     ConvexRasterLastReady
        nop
        move    R3, R0
ConvexRasterLastReady:
        move    R0, R3
        with    R0
        sub     R1
        bmi     ConvexRasterNextRow
        nop
        lm      R2, (CONVEX_RASTER_Y)
        jal     GSU_DrawHLine
        nop
ConvexRasterNextRow:
        lm      R0, (CONVEX_RASTER_Y)
        lm      R1, (CONVEX_TOP_PTR)
        with    R0
        cmp     R1
        beq     ConvexRasterDone
        inc     R0
        sm      (CONVEX_RASTER_Y), R0
        GSU_ABSOLUTE_GOTO ConvexRasterRowLoop
ConvexRasterDone:
        lm      R11, (CONVEX_RASTER_RETURN)
        ret
        nop

; R4:R5 is the active upper endpoint and R6:R7 the lower endpoint. The chain
; walk already enforces y0 <= sample < y1, so only the exact old Q10
; interpolation remains in the hot path.
ConvexIntersectActiveEdge:
        lm      R0, (CONVEX_SAMPLE_Y)
        to      R1
        sub     R5
        sm      (CONVEX_DIV_NUM), R1
        move    R0, R7
        with    R0
        sub     R5
        sm      (CONVEX_DIV_DEN), R0
        sm      (CONVEX_BASE_RIGHT), R4
        move    R0, R6
        with    R0
        sub     R4
        sm      (CONVEX_DELTA_RIGHT), R0

        lm      R0, (CONVEX_DIV_NUM)
        lm      R2, (CONVEX_DIV_DEN)
        move    R3, #0
        move    R12, #10
        iwt     R13, #ConvexIntersectDivideLoop
ConvexIntersectDivideLoop:
        with    R0
        add     R0
        with    R3
        add     R3
        to      R4
        sub     R2
        bcc     ConvexIntersectDivideNext
        nop
        move    R0, R4
        inc     R3
ConvexIntersectDivideNext:
        loop
        nop
        lm      R5, (CONVEX_BASE_RIGHT)
        lm      R7, (CONVEX_DELTA_RIGHT)
        BSP_SIGNED_MUL_SHIFT R0, R7, R3, 10
        with    R5
        add     R0
        move    R0, R5
        move    R1, #1
        ret
        nop
        .res $01BC - (* - ConvexRasterPolygon)
GSU_CACHE_KERNEL_END ConvexRasterPolygon

; Warm the stable horizontal-span cache window once per frame.
  .repeat $31E0 - (* - GSU_SelectVisibility)
        nop
  .endrepeat
GSU_CACHE_KERNEL_BEGIN RasterHotKernel
        ret
        nop

GSU_DrawHLine:
        moves   R2, R2
        bmi     HLineDone
        nop
        move    R0, #BSP_VIEW_HEIGHT-1
        with    R0
        sub     R2
        bmi     HLineDone
        nop

        move    R0, R3
        with    R0
        sub     R1
        bpl     HLineForward
        nop
        move    R0, R1
        move    R1, R3
        move    R3, R0
HLineForward:
        ; Keep the projected edge endpoints exact. Coverage repairs belong in
        ; packet/shared-edge ownership, never in unconditional span padding.
        moves   R3, R3
        bmi     HLineDone
        nop
        move    R0, #BSP_VIEW_WIDTH-1
        with    R0
        sub     R1
        bmi     HLineDone
        nop
        moves   R1, R1
        bpl     HLineLeftReady
        nop
        move    R1, #0
HLineLeftReady:
        move    R0, #BSP_VIEW_WIDTH-1
        with    R0
        sub     R3
        bpl     HLineRightReady
        nop
        move    R3, #BSP_VIEW_WIDTH-1
HLineRightReady:
        to      R12
        from    R3
        sub     R1
        inc     R12
        iwt     R13, #HLineLoop
HLineLoop:
        plot
        loop
        nop
HLineDone:
        ret
        nop
        .res $0047 - (* - RasterHotKernel)
GSU_CACHE_KERNEL_END RasterHotKernel

;-------------------------------------------------------------------------------
; Expand each logical 8x8 4bpp tile into four physical tiles. Lookup tables
; duplicate every source bit horizontally; duplicate stores handle vertical
; doubling. Both SNES plane pairs and all 28,672 destination bytes are written.
  .repeat $3230 - (* - GSU_SelectVisibility)
        nop
  .endrepeat
GSU_CACHE_KERNEL_BEGIN ExpandFrame
        sm      (EXPAND_RETURN), R11
        iwt     R0, #FRAMEBUFFER
        sm      (SOURCE_POINTER), R0
        iwt     R0, #OUTPUT
        sm      (ROW_DESTINATION), R0
        move    R0, #14
        sm      (ROWS_LEFT), R0

ExpandRowLoop:
        lm      R0, (ROW_DESTINATION)
        sm      (TILE_DESTINATION), R0
        move    R0, #16
        sm      (COLUMNS_LEFT), R0

ExpandColumnLoop:
        lm      R7, (SOURCE_POINTER)
        lm      R8, (TILE_DESTINATION)
        move    R9, R8
        move    R0, #32
        with    R9
        add     R0
        jal     ExpandFourRows
        nop

        lm      R8, (TILE_DESTINATION)
        iwt     R0, #1024
        with    R8
        add     R0
        move    R9, R8
        move    R0, #32
        with    R9
        add     R0
        jal     ExpandFourRows
        nop

        move    R0, #16
        with    R7
        add     R0
        sm      (SOURCE_POINTER), R7
        lm      R0, (TILE_DESTINATION)
        move    R1, #64
        with    R0
        add     R1
        sm      (TILE_DESTINATION), R0
        lm      R0, (COLUMNS_LEFT)
        dec     R0
        sm      (COLUMNS_LEFT), R0
        bne     ExpandColumnLoop
        nop

        lm      R0, (ROW_DESTINATION)
        iwt     R1, #2048
        with    R0
        add     R1
        sm      (ROW_DESTINATION), R0
        lm      R0, (ROWS_LEFT)
        dec     R0
        sm      (ROWS_LEFT), R0
        bne     ExpandRowLoop
        nop

        lm      R11, (EXPAND_RETURN)
        ret
        nop

; R7=source low-plane rows, R8=left output tile, R9=right output tile.
; Each call expands four rows from both the 0/1 and 2/3 plane pairs. R7 advances
; by eight bytes; the caller skips the first tile's remaining high-plane bytes
; after the second call.
ExpandFourRows:
        sm      (EXPAND_FOUR_RETURN), R11
        move    R6, R7
        move    R0, #16
        with    R6
        add     R0

        move    R12, #4
        iwt     R13, #ExpandLowPlaneRowsLoop
ExpandLowPlaneRowsLoop:
        move    R4, #0
        moveb   R4, (R7)
        inc     R7
        move    R5, #0
        moveb   R5, (R7)
        inc     R7

        jal     ExpandPlanePair
        nop

        moveb   (R8), R0
        inc     R8
        moveb   (R8), R1
        inc     R8
        moveb   (R8), R0
        inc     R8
        moveb   (R8), R1
        inc     R8

        moveb   (R9), R2
        inc     R9
        moveb   (R9), R3
        inc     R9
        moveb   (R9), R2
        inc     R9
        moveb   (R9), R3
        inc     R9
        loop
        nop

        move    R12, #4
        iwt     R13, #ExpandHighPlaneRowsLoop
ExpandHighPlaneRowsLoop:
        move    R4, #0
        moveb   R4, (R6)
        inc     R6
        move    R5, #0
        moveb   R5, (R6)
        inc     R6

        jal     ExpandPlanePair
        nop

        moveb   (R8), R0
        inc     R8
        moveb   (R8), R1
        inc     R8
        moveb   (R8), R0
        inc     R8
        moveb   (R8), R1
        inc     R8

        moveb   (R9), R2
        inc     R9
        moveb   (R9), R3
        inc     R9
        moveb   (R9), R2
        inc     R9
        moveb   (R9), R3
        inc     R9
        loop
        nop

        lm      R11, (EXPAND_FOUR_RETURN)
        ret
        nop

; Expand the high and low nibbles of two plane bytes. Sharing this cache-local
; helper across the low/high plane loops keeps the compact 16-byte lookup from
; duplicating its nibble extraction code.
ExpandPlanePair:
        move    R0, R4
  .repeat 4
        with    R0
        lsr
  .endrepeat
        iwt     R10, #GSU_EXPAND_NIBBLE_OFFSET
        with    R10
        add     R0
        move    R0, #0
        moveb   R0, (R10)
        with    R4
        and     #$0F
        iwt     R10, #GSU_EXPAND_NIBBLE_OFFSET
        with    R10
        add     R4
        move    R2, #0
        moveb   R2, (R10)

        move    R1, R5
  .repeat 4
        with    R1
        lsr
  .endrepeat
        iwt     R10, #GSU_EXPAND_NIBBLE_OFFSET
        with    R10
        add     R1
        move    R1, #0
        moveb   R1, (R10)
        with    R5
        and     #$0F
        iwt     R10, #GSU_EXPAND_NIBBLE_OFFSET
        with    R10
        add     R5
        move    R3, #0
        moveb   R3, (R10)
        ret
        nop
        .res $0153 - (* - ExpandFrame)
GSU_CACHE_KERNEL_END ExpandFrame

; These exact restoring divides sit after the pinned cache kernels so unrolling
; removes loop control from the texture hot path without perturbing cache
; placement. R0/R2 are the Q12 numerator/denominator and return the quotient in
; R3; R0/R1 are the unsigned numerator/denominator and return quotient/remainder
; in R2/R3.
.macro TEXTURE_DIVIDE_Q12_STEP
        .local Next
        with    R0
        add     R0
        with    R3
        add     R3
        with    R0
        cmp     R2
        bcc     Next
        nop
        with    R0
        sub     R2
        inc     R3
Next:
.endmacro

; The table stores ceil(2^27/d) as two base-2^15 limbs. Prepared span
; divisions and ordinary depth divisions share the lookup without sharing
; reciprocals: the latter denominator varies for every perspective sample.
TexturePrepareDivideQ12:
        iwt     R10, #TexturePrepareDivideQ12Ready
        lm      R13, (TEXTURE_Q12_LOOKUP_ROUTINE)
        jmp     R13
        nop

TextureDivideQ12:
        move    R8, R0                  ; numerator
        move    R9, R2                  ; denominator
        lm      R10, (TEXTURE_Q12_LOADED_ROUTINE)
        lm      R13, (TEXTURE_Q12_LOOKUP_ROUTINE)
        jmp     R13
        nop
        .include "BakedFaceClipLeading.sgs"
  .repeat $32 - (* - TexturePrepareDivideQ12)
        nop
  .endrepeat
TextureDivideQ12HotMirrorMiss:
        move    R0, #GSU_DIVIDE_Q12_RECIPROCAL_FIRST_ROM_BANK
        iwt     R4, #GSU_DIVIDE_Q12_RECIPROCAL_ENTRIES_PER_BANK
TextureDivideQ12SelectBank:
        with    R1
        cmp     R4
        bcc     TextureDivideQ12BankReady
        nop
        QuakeNextQ12Bank TextureDivideQ12SelectBank, TextureDivideQ12PackedTail
TextureDivideQ12BankReady:
        romb
        to      R2
        from    R1
        add     R1
        with    R2
        add     R2
        iwt     R4, #GSU_DIVIDE_Q12_RECIPROCAL_ROM_ADDRESS
        with    R4
        add     R2
        GSU_SET_ROM_BUFFER_ADDRESS R4
        BSP_ROM_LOAD_WORD R12           ; high base-2^15 limb
        BSP_ROM_LOAD_WORD R13           ; low base-2^15 limb
        jmp     R10
        nop

TexturePrepareDivideQ12Ready:
        sm      (TEXTURE_RECIPROCAL_HIGH), R12
        sm      (TEXTURE_RECIPROCAL_LOW), R13
        ret
        nop

        ; Face-granular composed routing consumes this retired trampoline gap;
        ; cache kernels below remain independently line-aligned.
  .repeat 0
        nop
  .endrepeat
        ; Keep the sky ROM thunk in this unreachable reserve. Turbulence uses
        ; the bounded bank-$70 raster-phase overlay directly, avoiding two
        ; cross-bank jumps per liquid pixel.
SkyMarkerSampler:
        ; LJMP's bank operand is restricted to R8-R13. All admitted sampler
        ; callers either document R12 as volatile or replace it immediately;
        ; mode 4 is rejected before publishing this route.
        ; Compositor run scratch is dead while opaque faces publish markers.
        ; Normal calls always clear the private span continuation, including
        ; cache hits, without changing any formerly preserved register.
        iwt     R4, #.loword(SkyMarkerSamplerROM)
        move    R12, #BSP_GSU_ROM2_BANK
        ; IWT/IBT reset both prefixes. SUB R0 is the one-byte self-zero;
        ; together with the four-byte high-RAM store it fills five old NOPs.
        sub     R0
        sm      (SKY_RUN_RETURN), R0
        from    R4
        ljmp    R12
        nop
  .repeat 14 - (* - SkyMarkerSampler)
        nop
  .endrepeat
.assert * - SkyMarkerSampler = 14, error, "Sky marker thunk changed the retired reserve footprint"

TextureDivideUnsigned:
.include "quake/TextureFullDivideDispatch.sgs"

; Technique 4's projective blocks are at most eight pixels wide. Handle the
; power-of-two widths directly and use exact reciprocals for 3/5/6/7. A balanced
; dispatch keeps short remainder blocks from walking every earlier width.
TextureDivideBlockUnsigned:
        to      R4
        from    R1
        sub     #4
        beq     TextureDivideBlock4
        nop
        bcc     TextureDivideBlockBelow4
        nop
        with    R4
        sub     #2
        beq     TextureDivideBlock6
        nop
        bcc     TextureDivideBlock5
        nop
        with    R4
        sub     #2
        beq     TextureDivideBlock8
        nop
        bcc     TextureDivideBlock7
        nop
TextureDivideBlockFallback:
        iwt     R13, #TextureDivideUnsigned
        jmp     R13
        nop
TextureDivideBlockBelow4:
        with    R4
        add     #2
        beq     TextureDivideBlock2
        nop
        bpl     TextureDivideBlock3
        nop
        inc     R4
        beq     TextureDivideBlock1
        nop
        GSU_ABSOLUTE_GOTO TextureDivideBlockFallback
        ; Preserve the divider bodies and following cache layout.
        .res $3C - (* - TextureDivideBlockUnsigned)
TextureDivideBlock8:
        to      R3
        and     #7
  .repeat 3
        lsr
  .endrepeat
        move    R2, R0
        ret
        nop
        ; Unreachable padding retains every following divider/cache entry.
  .repeat 3
        nop
  .endrepeat
TextureDivideBlock4:
        to      R3
        and     #3
  .repeat 2
        lsr
  .endrepeat
        move    R2, R0
        ret
        nop
        ; Unreachable padding retains every following divider/cache entry.
  .repeat 2
        nop
  .endrepeat
TextureDivideBlock2:
        to      R3
        and     #1
        lsr
        move    R2, R0
        ret
        nop
TextureDivideBlock1:
        move    R2, R0
        move    R3, #0
        ret
        nop
TextureDivideBlock3:
        iwt     R6, #10923              ; ceil(32768 / 3)
        bra     TextureDivideBlockReciprocal
        nop
TextureDivideBlock5:
        iwt     R6, #6554               ; ceil(32768 / 5)
        bra     TextureDivideBlockReciprocal
        nop
TextureDivideBlock6:
        iwt     R6, #5462               ; ceil(32768 / 6)
        bra     TextureDivideBlockReciprocal
        nop
TextureDivideBlock7:
        iwt     R6, #4682               ; ceil(32768 / 7)
TextureDivideBlockReciprocal:
        ; The unsigned magnitude is at most $8000. Reduce that sole
        ; sign-bit case by one divisor and restore one quotient afterward.
        move    R12, #0
        moves   R0, R0
        bpl     TextureDivideBlockMagnitudeReady
        nop
        with    R0
        sub     R1
        move    R12, #1
TextureDivideBlockMagnitudeReady:
        move    R5, R0
        lmult
        ; floor(product / 32768) is the high word doubled plus low bit 15.
        with    R4
        add     R4
        adc     R0
        move    R2, R0
        move    R6, R1
        lmult
        to      R3
        from    R5
        sub     R4
        moves   R3, R3
        bpl     TextureDivideBlockReciprocalReady
        nop
        dec     R2
        with    R3
        add     R1
TextureDivideBlockReciprocalReady:
        with    R2
        add     R12
        ret
        nop

; Lightmap preparation runs once per block. Keep its bounds-proof prefix in the
; builder's former cold slot and rejoin the unchanged suffix above.
; Production generation publishes the conservative emitted world UV/grid proof.
; Unqualified assets retain the complete original per-block proof below.
.ifndef BSP_WORLD_LIGHTMAP_CLOSED_GRID_PROVEN
BSP_WORLD_LIGHTMAP_CLOSED_GRID_PROVEN = 0
.endif
LightmapPrepareBlock:
        move    R0, #0
        sm      (LIGHTMAP_BLOCK_FAST), R0
        lm      R0, (LIGHTMAP_ROM_BANK)
        moves   R0, R0
LightmapPrepareBlockBankReady:
        bpl     :+
        nop
        GSU_ABSOLUTE_GOTO LightmapPrepareBlockDone
:
        lm      R0, (TEXTURE_SPAN_S)
        hib
        sex
        lm      R1, (LIGHTMAP_MIN_BLOCK_S)
        sub     R1
        move    R12, R0
        ; R1 still holds this face's minimum from the first endpoint.
        lm      R0, (TEXTURE_BLOCK_END_S)
        hib
        sex
        sub     R1
        move    R6, R0
        lm      R1, (LIGHTMAP_WIDTH)
        dec     R1
        from    R12
        cmp     R1
        bcc     LightmapPrepareStartSInterior
        nop
        GSU_ABSOLUTE_GOTO LightmapPrepareBlockDone
LightmapPrepareStartSInterior:
        from    R6
        cmp     R1
        bcc     LightmapPrepareEndSInterior
        nop
        GSU_ABSOLUTE_GOTO LightmapPrepareBlockDone
LightmapPrepareEndSInterior:
        to      R8
        from    R6
        sub     R12
        lm      R0, (TEXTURE_SPAN_T)
        hib
        sex
        lm      R1, (LIGHTMAP_MIN_BLOCK_T)
        sub     R1
        move    R13, R0
        ; R1 still holds this face's minimum from the first endpoint.
        lm      R0, (TEXTURE_BLOCK_END_T)
        hib
        sex
        sub     R1
        move    R7, R0
        lm      R1, (LIGHTMAP_HEIGHT)
        dec     R1
        from    R13
        cmp     R1
        bcc     LightmapPrepareStartTInterior
        nop
        GSU_ABSOLUTE_GOTO LightmapPrepareBlockDone
LightmapPrepareStartTInterior:
        GSU_ABSOLUTE_GOTO LightmapPrepareCachedContinueCold

.assert * - LightmapPrepareBlock <= $6D, error, "Lightmap proof prefix exceeds its pinned slot"
        .res $6D - (* - LightmapPrepareBlock), $01
TextureRenderConvexFaceAlbedo:
TextureRenderConvexFaceAlbedoGeneric:
TextureRenderConvexFaceAlbedoSamplerReady:
.ifdef PLAYABLE_MAP_ID
        iwt     R13, #BakedRenderWorldFace
.else
        iwt     R13, #TextureRenderConvexFace
.endif
        jmp     R13
        nop

  .if BSP_WORLD_LIGHTMAP_CLOSED_GRID_PROVEN
; Only a fully checked endpoint batch can bypass the original per-block proof.
LightmapPrepareWorldClosedGrid:
        lm      R0, (GSU_TEXTURE_ENDPOINT_WORLD_PROOF_OFFSET)
        moves   R0, R0
        beq     LightmapPrepareWorldClosedGridFallback
        nop
        ; Replay initializes FAST once per qualified row. No sampler mutates it.
LightmapPrepareWorldClosedGridReady:
        ; Published endpoints qualify the face's interior route, including T7.
        ; Buffered endpoints preserve ROMB; the header selected this face's bank.
        lm      R13, (TEXTURE_ERR_T)
        iwt     R7, #TextureLightmapSampleReady
        lm      R5, (TEXTURE_SPAN_S)
        lm      R6, (TEXTURE_SPAN_T)
        iwt     R10, #GSU_TEXTURE_BLOCK_COORDS_OFFSET+4
.if .defined(PLAYABLE_SAME_T_LIGHTMAP_BLOCK) && (BSP_RENDER_SCALE = 2)
        GSU_ABSOLUTE_GOTO TextureLightmapSameTSelect
.else
        jmp     R13
        nop
.endif
LightmapPrepareWorldClosedGridFallback:
        GSU_ABSOLUTE_GOTO LightmapPrepareBlock
  .endif

; Resolve the overwhelmingly common sampler once per face. The fallback
; retains non-power-of-two, 256-wide, and cross-bank cases.
  .repeat $364B - (* - GSU_SelectVisibility)
        nop
  .endrepeat
TextureSelectSampleRoutine:
        iwt     R1, #TextureSampleAbsoluteRegisters
        sm      (TEXTURE_SAMPLE_ROUTINE), R1
        ; Technique 4's register-fed builder leaves these four contiguous
        ; affine-state words free for its per-face block-route table.
        iwt     R1, #TextureLightmapSpanLoop
        sm      (TEXTURE_STEP_S), R1
        sm      (TEXTURE_STEP_T), R1
        sm      (TEXTURE_REM_S), R1
        sm      (TEXTURE_REM_T), R1
        sm      (TEXTURE_ERR_S), R1
        sm      (TEXTURE_ERR_T), R1
        move    R2, #BSP_WORLD_TEXTURE_FLAG_POWER_OF_TWO_AXES | BSP_WORLD_TEXTURE_FLAG_SINGLE_BANK
        cmp     R2
        bne     TextureSelectSampleRoutineWidthMismatch
        nop
        lm      R0, (TEXTURE_WIDTH)
.if .defined(PLAYABLE_RECTANGULAR_POT_SAMPLER) && (BSP_RENDER_SCALE = 2)
        ; Single-bank POT materials use one of the four pinned row shifts.
        ibt     R1, #16
        cmp     R1
        bcc     TextureSelectSampleRoutineWidthMismatch
        nop
        iwt     R1, #129
        cmp     R1
        bcs     TextureSelectSampleRoutineWidthMismatch
        nop
.else
        lm      R1, (TEXTURE_HEIGHT)
        cmp     R1
        bne     TextureSelectSampleRoutineWidthMismatch
        nop
        iwt     R2, #256
        cmp     R2
        beq     TextureSelectSampleRoutineDone
        nop
.endif
        iwt     R10, #TextureSelectPowerOfTwoStateReady
        GSU_ABSOLUTE_GOTO TexturePreparePowerOfTwoSamplerState
  .repeat $368A - (* - GSU_SelectVisibility)
        nop
  .endrepeat
TextureSelectPowerOfTwoStateReady:
        iwt     R1, #TextureSampleAbsolutePowerOfTwoSingleBankRegisters
        sm      (TEXTURE_SAMPLE_ROUTINE), R1
        iwt     R1, #TextureLightmapBilinearSpanLoop
        sm      (TEXTURE_STEP_T), R1
        iwt     R1, #TextureLightmapConstantSpanLoop
        sm      (TEXTURE_REM_S), R1
        iwt     R1, #TextureLightmapVerticalSpanLoop
        sm      (TEXTURE_REM_T), R1
        iwt     R1, #TextureLightmapHorizontalSpanLoop
        sm      (TEXTURE_ERR_S), R1
        iwt     R1, #TextureLightmapInteriorSpanLoop
        sm      (TEXTURE_ERR_T), R1
TextureSelectSampleRoutineDone:
        ret
        nop

; Mask away Q4 fractions before the row contribution is shifted into place.
; Widths 16/32/64/128 select zero through three doubles. R10 is the caller's
; continuation so both direct and arbitrated material selectors can share it.
TexturePreparePowerOfTwoSamplerState:
.if .defined(PLAYABLE_RECTANGULAR_POT_SAMPLER) && (BSP_RENDER_SCALE = 2)
        lm      R1, (TEXTURE_HEIGHT_Q4)
.else
        lm      R1, (TEXTURE_WIDTH_Q4)
.endif
        with    R1
        sub     #15
        dec     R1
        sm      (TEXTURE_SPAN_SHADE_Q8), R1
        iwt     R1, #TextureSamplePowerOfTwoRowShift2
        iwt     R2, #64
        cmp     R2
        beq     TextureSelectSampleRowRoutineReady
        nop
        iwt     R1, #TextureSamplePowerOfTwoRowShift3
        iwt     R2, #128
        cmp     R2
        beq     TextureSelectSampleRowRoutineReady
        nop
        iwt     R1, #TextureSamplePowerOfTwoRowShift1
        iwt     R2, #32
        cmp     R2
        beq     TextureSelectSampleRowRoutineReady
        nop
        iwt     R1, #TextureSamplePowerOfTwoRowReady
TextureSelectSampleRowRoutineReady:
        sm      (TEXTURE_STEP_SHADE_Q8), R1
        jmp     R10
        nop

; Generated special flags and the unequal-axis sky route through one cold ROM
; selector. Ordinary square textures retain the bank-$70 fast path above.
TextureSelectSampleRoutineWidthMismatch:
        move    R9, #BSP_GSU_ROM2_BANK
        iwt     R8, #.loword(SkySelectSampleRoutineROM)
        from    R8
        ljmp    R9
        nop

; Both possible outer owners use one stable thunk.  The ROM handler tests the
; command-cleared/mixed-published brush return to select the exact saved path.
SkyOwnerReturn:
        move    R9, #BSP_GSU_ROM2_BANK
        iwt     R8, #.loword(SkyOwnerReturnROM)
        from    R8
        ljmp    R9
        nop
        .repeat 13 - (* - SkyOwnerReturn)
        nop
        .endrepeat
.assert * - SkyOwnerReturn = 13, error, "Sky owner thunk changed the retired reserve footprint"

; Technique-0/1 flat rendering is cold while the lightmapped path runs.
RenderFaces:
        sm      (RENDER_RETURN), R11
        lm      R0, (GSU_TELEMETRY_PACKET_FACE_COUNT)
        moves   R0, R0
        bne     FacesPresent
        nop
        lm      R11, (RENDER_RETURN)
        ret
        nop
FacesPresent:
        iwt     R0, #FACES
        sm      (FACE_POINTER), R0
        lm      R0, (GSU_TELEMETRY_PACKET_FACE_COUNT)
        sm      (FACES_LEFT), R0

        iwt     R10, #COMMAND+5
        move    R0, #0
        moveb   R0, (R10)
        with    R0
        sex
        inc     R0                      ; Face byte 3=flat, byte 4=dither.
        sm      (COLOR_SKIP), R0

FaceLoop:
FaceVisible:
        lm      R10, (FACE_POINTER)
        jal     LoadPacketFaceFirstIndex ; First index, in uint16 elements.
        move    R1, #0
        move    R6, R0
        moveb   R1, (R10)
        sm      (CONVEX_FACE_VERTICES), R1

        lm      R2, (COLOR_SKIP)
        with    R10
        add     R2
        move    R0, #0
        moveb   R0, (R10)
        color

        with    R6
        add     R6
        iwt     R10, #INDICES
        with    R10
        add     R6
        sm      (CONVEX_INDEX_PTR), R10
        jal     RenderConvexFace
        nop
FaceTrianglesDone:

FaceAdvance:
        lm      R0, (FACE_POINTER)
        with    R0
        add     #BSP_FACE_RECORD_BYTES
        sm      (FACE_POINTER), R0
        lm      R0, (FACES_LEFT)
        dec     R0
        sm      (FACES_LEFT), R0
        beq     FacesDone
        nop
        GSU_ABSOLUTE_GOTO FaceLoop

FacesDone:
        lm      R11, (RENDER_RETURN)
        ret
        nop
