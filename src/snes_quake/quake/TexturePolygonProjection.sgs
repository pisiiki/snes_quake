TextureProjectPolygonShaded:
        ; Keep this vertex loop resident while its exact divider runs outside
        ; the window. No projection arithmetic or clipping policy changes.
        cache
        sm      (TEXTURE_PROJECT_RETURN), R11
        iwt     R0, #24576
        sm      (CONVEX_MIN_Y), R0
        iwt     R0, #-8192
        sm      (CONVEX_MAX_Y), R0
        lm      R0, (CONVEX_INPUT_PTR)
        sm      (CONVEX_CURRENT_PTR), R0
        iwt     R0, #TEXTURE_SCREEN
        sm      (CONVEX_SCREEN_PTR), R0
        lm      R0, (CONVEX_COUNT)
        sm      (CONVEX_SCREEN_COUNT), R0
        sm      (CONVEX_EDGE_COUNT), R0
TextureShadeProjectLoop:
.ifdef PLAYABLE_E1M1_SHADED_PROJECTOR
        ; Clipped view records precede the separate screen arena. Read each
        ; attribute from its owning record instead of copying through scratch.
        .assert TEXTURE_VIEW_RECORD_BYTES = 10, error, "Shaded input record changed"
        .assert TEXTURE_SHADE_SCREEN_RECORD_BYTES = 10, error, "Shaded output record changed"
        .assert TEXTURE_VIEW_B + CONVEX_VERTEX_CAPACITY * TEXTURE_VIEW_RECORD_BYTES <= TEXTURE_SCREEN, error, "Shaded input overlaps output"
        lm      R5, (CONVEX_CURRENT_PTR)
        move    R10, R5
        with    R10
        add     #4
        movew   R9, (R10)
.else
        lm      R10, (CONVEX_CURRENT_PTR)
        TEXTURE_LOAD_VIEW R10, CONVEX_CUR_RIGHT, CONVEX_CUR_UP, CONVEX_CUR_DEPTH, TEXTURE_CUR_S, TEXTURE_CUR_T
        inc     R10
        inc     R10
        sm      (CONVEX_CURRENT_PTR), R10

.endif
        ; Both screen components share this vertex's exact depth reciprocal.
.ifdef PLAYABLE_E1M1_SHADED_PROJECTOR
        move    R2, R9
.else
        lm      R2, (CONVEX_CUR_DEPTH)
.endif
.if .defined(PLAYABLE_FLAT_MONOTONE_RASTER) && (BSP_RENDER_SCALE = 2)
  .if PLAYABLE_MAP_ID = PLAYABLE_E1M1_MAP_ID
        .export TextureShadePrepareDepthCall, TexturePrepareDivideQ12
TextureShadePrepareDepthCall:
  .endif
.endif
        jal     TexturePrepareDivideQ12
.if .defined(PLAYABLE_FLAT_MONOTONE_RASTER) && (BSP_RENDER_SCALE = 2)
  .if PLAYABLE_MAP_ID = PLAYABLE_E1M1_MAP_ID
        .assert * - TextureShadePrepareDepthCall = 5, error, "Projection depth JAL operand contract changed"
  .endif
.endif
        nop
.ifdef PLAYABLE_E1M1_SHADED_PROJECTOR
        ; Both reciprocal lookup routes preserve R5/R9. The component calls
        ; preserve R10 and return the original denominator in R9.
        move    R10, R5
        movew   R1, (R10)
        move    R2, R9
.else
        lm      R1, (CONVEX_CUR_RIGHT)
        lm      R2, (CONVEX_CUR_DEPTH)
.endif
TextureShadeProjectRightCall:
        jal     ConvexProjectComponent
.assert * - TextureShadeProjectRightCall = 5, error, "Projection right JAL operand contract changed"
        iwt     R1, #BSP_VIEW_CENTER_X_Q7
        with    R0
        add     R1
.ifdef PLAYABLE_E1M1_SHADED_PROJECTOR
        lm      R5, (CONVEX_SCREEN_PTR)
        movew   (R5), R0
        inc     R10
        inc     R10
        movew   R1, (R10)
        move    R2, R9
.else
        lm      R10, (CONVEX_SCREEN_PTR)
        movew   (R10), R0
        inc     R10
        inc     R10

        lm      R1, (CONVEX_CUR_UP)
        lm      R2, (CONVEX_CUR_DEPTH)
.endif
TextureShadeProjectUpCall:
        jal     ConvexProjectComponent
.assert * - TextureShadeProjectUpCall = 5, error, "Projection up JAL operand contract changed"
        iwt     R1, #BSP_VIEW_CENTER_Y_Q7
        with    R1
        sub     R0
.ifdef PLAYABLE_E1M1_SHADED_PROJECTOR
        ; The general component may use R5 to save R10. Reload the output
        ; cursor after it returns. R1 remains screen Y for the bounds below.
        lm      R5, (CONVEX_SCREEN_PTR)
        inc     R5
        inc     R5
        movew   (R5), R1
        inc     R5
        inc     R5
        with    R10
        add     #4
        movew   R0, (R10)
        movew   (R5), R0
        inc     R10
        inc     R10
        inc     R5
        inc     R5
        movew   R0, (R10)
        movew   (R5), R0
        inc     R10
        inc     R10
        sm      (CONVEX_CURRENT_PTR), R10
        inc     R5
        inc     R5
        movew   (R5), R9
        move    R10, R5
.else
        movew   (R10), R1
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_CUR_S)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_CUR_T)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (CONVEX_CUR_DEPTH)
        movew   (R10), R0

.endif
        lm      R2, (CONVEX_MIN_Y)
  .if BSP_RENDER_SCALE = 2
        with    R1
        cmp     R2
  .else
        move    R3, R1
        with    R3
        sub     R2
  .endif
        bpl     TextureShadeProjectMinReady
        nop
        sm      (CONVEX_MIN_Y), R1
        move    R0, R10
        with    R0
        sub     #8
        sm      (CONVEX_TOP_PTR), R0
TextureShadeProjectMinReady:
        lm      R2, (CONVEX_MAX_Y)
  .if BSP_RENDER_SCALE = 2
        with    R2
        cmp     R1
  .else
        move    R3, R2
        with    R3
        sub     R1
  .endif
        bpl     TextureShadeProjectMaxReady
        nop
        sm      (CONVEX_MAX_Y), R1
TextureShadeProjectMaxReady:
        inc     R10
        inc     R10
        sm      (CONVEX_SCREEN_PTR), R10
        lm      R0, (CONVEX_EDGE_COUNT)
        dec     R0
        sm      (CONVEX_EDGE_COUNT), R0
        beq     TextureShadeProjectVerticesDone
        nop
        GSU_ABSOLUTE_GOTO TextureShadeProjectLoop
.ifdef PLAYABLE_E1M1_SHADED_PROJECTOR
        ; Keep the shared projected-polygon tail and following overlays pinned.
  .if BSP_RENDER_SCALE = 2
        .res $9A - (* - TextureShadeProjectLoop), $01
  .else
        .res $9C - (* - TextureShadeProjectLoop), $01
  .endif
.endif
TextureShadeProjectVerticesDone:
        lm      R0, (CONVEX_SCREEN_PTR)
        sm      (CONVEX_SCREEN_END_PTR), R0
  .if BSP_RENDER_SCALE = 2
        jal     TextureFinalizeProjectedY
        nop
  .endif
        lm      R0, (CONVEX_TOP_PTR)
        sm      (CONVEX_FORWARD_PTR), R0
        sm      (CONVEX_REVERSE_PTR), R0

        lm      R0, (CONVEX_MIN_Y)
        iwt     R1, #63
        with    R0
        add     R1
  .if !(.defined(PLAYABLE_FX3_PLANE_DISTANCE) && (BSP_RENDER_SCALE = 2))
  .if BSP_RENDER_SCALE = 2
    .repeat 7
        asr
    .endrepeat
  .else
  .repeat 7
        with    R0
        asr
  .endrepeat
  .endif
        moves   R0, R0
  .endif
        bpl     TextureShadeRasterFirstYPositive
        nop
        move    R0, #0
TextureShadeRasterFirstYPositive:
  .if .defined(PLAYABLE_FX3_PLANE_DISTANCE) && (BSP_RENDER_SCALE = 2)
        ; After the signed clamp, the Q7 integer fits in one unsigned byte.
        add     R0
        hib
  .endif
        move    R1, #BSP_VIEW_HEIGHT-1
        with    R1
        sub     R0
        bpl     TextureShadeRasterFirstYReady
        nop
        bra     TextureShadeProjectRejected
        nop
TextureShadeRasterFirstYReady:
        sm      (CONVEX_RASTER_Y), R0

        lm      R0, (CONVEX_MAX_Y)
        iwt     R1, #65
        with    R0
        sub     R1
  .if !(.defined(PLAYABLE_FX3_PLANE_DISTANCE) && (BSP_RENDER_SCALE = 2))
  .if BSP_RENDER_SCALE = 2
    .repeat 7
        asr
    .endrepeat
  .else
  .repeat 7
        with    R0
        asr
  .endrepeat
  .endif
        moves   R0, R0
  .endif
        bpl     TextureShadeRasterLastYPositive
        nop
        bra     TextureShadeProjectRejected
        nop
TextureShadeRasterLastYPositive:
  .if .defined(PLAYABLE_FX3_PLANE_DISTANCE) && (BSP_RENDER_SCALE = 2)
        add     R0
        hib
  .endif
        move    R1, #BSP_VIEW_HEIGHT-1
        move    R2, R1
        with    R2
        sub     R0
        bpl     TextureShadeRasterLastYReady
        nop
        move    R0, R1
TextureShadeRasterLastYReady:
        lm      R1, (CONVEX_RASTER_Y)
        move    R2, R0
        with    R2
        sub     R1
        bpl     TextureShadeRasterRowsReady
        nop
        bra     TextureShadeProjectRejected
        nop
TextureShadeRasterRowsReady:
        sm      (CONVEX_TOP_PTR), R0
        move    R0, #1
        bra     TextureShadeProjectReturn
        nop
TextureShadeProjectRejected:
        move    R0, #0
TextureShadeProjectReturn:
        lm      R11, (TEXTURE_PROJECT_RETURN)
        ret
        nop
  .if .defined(PLAYABLE_FX3_PLANE_DISTANCE) && (BSP_RENDER_SCALE = 2)
        ; Keep the following T2/T4 entry at its linked offset.
        .res 10 + $71 - (TextureShadeProjectReturn - TextureShadeProjectVerticesDone), $01
  .elseif BSP_RENDER_SCALE = 2
        .res 10, $01                    ; Retired 3-byte short SM + 6-byte JAL/NOP; preserve T2/T4 entry.
  .endif
