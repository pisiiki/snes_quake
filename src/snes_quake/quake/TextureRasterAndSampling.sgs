; Exact signed Q12 products for a factor already scaled by eight in R6.
; Because the caller handles factor 4096 as unity, R6 stays nonnegative.
; Doubling LMULT's high word and shifting bit 15 out of its low word forms
; floor(source*factor/4096). The truncating form corrects a negative result
; toward zero whenever the remaining low 15 product bits are nonzero.
.macro BSP_SIGNED_MUL_SCALED8_SHIFT12 source
        move    R0, source
        with    R0
        lmult
        with    R4
        add     R4
        with    R0
        adc     R0
.endmacro

.macro BSP_SIGNED_MUL_SCALED8_SHIFT_TRUNC12 source
        .local Done
        BSP_SIGNED_MUL_SCALED8_SHIFT12 source
        moves   source, source
        bpl     Done
        nop
        move    R1, R4
        with    R1
        sub     #1
        with    R0
        adc     #0
Done:
.endmacro

; A logical screen coordinate is 0..127. Byte-swapping it and shifting once is
; the exact 16-bit equivalent of seven dependent doubles into unsigned Q7.
.macro BSP_SCALE_LOGICAL_TO_Q7 reg
        with    reg
        swap
        with    reg
        lsr
.endmacro

; Arithmetic Q7-to-integer conversion is twice the signed high byte plus bit 7
; of the low byte. Keeping the signed high byte separate preserves unclamped
; positive results through 255 as well as negative off-screen bounds.
.macro BSP_ARITH_SHIFT7 reg, scratch
        move    scratch, reg
        with    scratch
        swap
        move    reg, scratch
        with    reg
        sex
        with    scratch
        add     scratch
        with    reg
        adc     reg
.endmacro

; Perspective-correct albedo raster. The screen records include depth for the
; same Q12 edge correction as technique 4, but spans enter an independent
; texture-only pixel loop.
TextureRasterPolygon:
        sm      (TEXTURE_RASTER_RETURN), R11
TextureRasterRowLoop:
        lm      R0, (CONVEX_RASTER_Y)
        BSP_SCALE_LOGICAL_TO_Q7 R0
        iwt     R1, #64
        with    R0
        add     R1
        sm      (CONVEX_SAMPLE_Y), R0

        lm      R10, (CONVEX_FORWARD_PTR)
        lm      R12, (CONVEX_SCREEN_COUNT)
TextureRasterForwardAdvance:
        move    R9, R10
        with    R9
        add     #TEXTURE_SHADE_SCREEN_RECORD_BYTES
        lm      R0, (CONVEX_SCREEN_END_PTR)
        with    R9
        cmp     R0
        bne     TextureRasterForwardNextReady
        nop
        iwt     R9, #TEXTURE_SCREEN
TextureRasterForwardNextReady:
        move    R8, R9
        inc     R8
        inc     R8
        movew   R1, (R8)
        lm      R0, (CONVEX_SAMPLE_Y)
        move    R2, R1
        with    R2
        sub     R0
        moves   R2, R2
        bmi     TextureRasterForwardStep
        nop
        beq     TextureRasterForwardStep
        nop
        sm      (CONVEX_FORWARD_PTR), R10
        jal     TextureIntersectActiveEdgeProjective
        nop
        sm      (CONVEX_MIN_X), R0
        lm      R0, (TEXTURE_EDGE_S)
        sm      (TEXTURE_LEFT_S), R0
        lm      R0, (TEXTURE_EDGE_T)
        sm      (TEXTURE_LEFT_T), R0
        lm      R0, (TEXTURE_EDGE_SHADE)
        sm      (TEXTURE_LEFT_SHADE), R0
        bra     TextureRasterReverseBegin
        nop
TextureRasterForwardStep:
        move    R10, R9
        dec     R12
        bne     TextureRasterForwardAdvance
        nop
        GSU_ABSOLUTE_GOTO TextureRasterDone

TextureRasterReverseBegin:
        lm      R10, (CONVEX_REVERSE_PTR)
        lm      R12, (CONVEX_SCREEN_COUNT)
TextureRasterReverseAdvance:
        iwt     R0, #TEXTURE_SCREEN
        with    R10
        cmp     R0
        bne     TextureRasterReverseNoWrap
        nop
        lm      R9, (CONVEX_SCREEN_END_PTR)
        with    R9
        sub     #TEXTURE_SHADE_SCREEN_RECORD_BYTES
        bra     TextureRasterReverseNextReady
        nop
TextureRasterReverseNoWrap:
        move    R9, R10
        with    R9
        sub     #TEXTURE_SHADE_SCREEN_RECORD_BYTES
TextureRasterReverseNextReady:
        move    R8, R9
        inc     R8
        inc     R8
        movew   R1, (R8)
        lm      R0, (CONVEX_SAMPLE_Y)
        move    R2, R1
        with    R2
        sub     R0
        moves   R2, R2
        bpl     TextureRasterReverseNonNegative
        nop
TextureRasterReverseStep:
        move    R10, R9
        dec     R12
        bne     TextureRasterReverseAdvance
        nop
        GSU_ABSOLUTE_GOTO TextureRasterDone
TextureRasterReverseNonNegative:
        beq     TextureRasterReverseStep
        nop
        sm      (CONVEX_REVERSE_PTR), R10
        jal     TextureIntersectActiveEdgeProjective
        nop
        sm      (CONVEX_MAX_X), R0
        lm      R0, (TEXTURE_EDGE_S)
        sm      (TEXTURE_RIGHT_S), R0
        lm      R0, (TEXTURE_EDGE_T)
        sm      (TEXTURE_RIGHT_T), R0
        lm      R0, (TEXTURE_EDGE_SHADE)
        sm      (TEXTURE_RIGHT_SHADE), R0

        lm      R1, (CONVEX_MIN_X)
        lm      R0, (CONVEX_MAX_X)
        move    R2, R0
        with    R2
        sub     R1
        bpl     TextureRasterXOrderReady
        nop
        sm      (CONVEX_MIN_X), R0
        sm      (CONVEX_MAX_X), R1
        lm      R2, (TEXTURE_LEFT_S)
        lm      R3, (TEXTURE_RIGHT_S)
        sm      (TEXTURE_LEFT_S), R3
        sm      (TEXTURE_RIGHT_S), R2
        lm      R2, (TEXTURE_LEFT_T)
        lm      R3, (TEXTURE_RIGHT_T)
        sm      (TEXTURE_LEFT_T), R3
        sm      (TEXTURE_RIGHT_T), R2
        lm      R2, (TEXTURE_LEFT_SHADE)
        lm      R3, (TEXTURE_RIGHT_SHADE)
        sm      (TEXTURE_LEFT_SHADE), R3
        sm      (TEXTURE_RIGHT_SHADE), R2
TextureRasterXOrderReady:
        lm      R1, (CONVEX_MIN_X)
        iwt     R0, #59
        with    R1
        add     R0
        BSP_ARITH_SHIFT7 R1, R2
        moves   R1, R1
        bpl     TextureRasterFirstReady
        nop
        move    R1, #0
TextureRasterFirstReady:
        lm      R3, (CONVEX_MAX_X)
        iwt     R0, #60
        with    R3
        sub     R0
        BSP_ARITH_SHIFT7 R3, R4
        move    R0, #127
        move    R4, R0
        with    R4
        sub     R3
        bpl     TextureRasterLastReady
        nop
        move    R3, R0
TextureRasterLastReady:
        move    R0, R3
        with    R0
        sub     R1
        bmi     TextureRasterNextRow
        nop
        lm      R2, (CONVEX_RASTER_Y)
        jal     TextureDrawSpan
        nop
TextureRasterNextRow:
        lm      R0, (CONVEX_RASTER_Y)
        lm      R1, (CONVEX_TOP_PTR)
        with    R0
        cmp     R1
        beq     TextureRasterDone
        inc     R0
        sm      (CONVEX_RASTER_Y), R0
        GSU_ABSOLUTE_GOTO TextureRasterRowLoop
TextureRasterDone:
        lm      R11, (TEXTURE_RASTER_RETURN)
        ret
        nop

.macro DEFINE_TEXTURE_SHADED_RASTER entry, fixed_lightmap, edge_cache, edge_intersect, stage_row, edge_register_outputs
        .local RowLoop, ForwardAdvance, ForwardNextReady, ForwardStep
        .local ReverseBegin, ReverseAdvance, ReverseNoWrap, ReverseNextReady
        .local ReverseStep, ReverseNonNegative, XOrderReady, FirstReady
        .local LastReady, LightmapStageRow, NextRow, Done
        .local ReplayLoop, ReplayRows, ReplayFirstReady
        .local ReplayLastReady, ReplayCoordinates, ReplayBufferedCoordinates
        .local ReplayCoordinatesReady, ReplayNext, ReplayClearEndpoints, Return
        .local LightmapStageUnavailable, LightmapSpan, ReplayAvailable
        .local DirectLeftFallback, DirectRightFallback
        .local T4ReplayAvailable
entry:
        sm      (TEXTURE_RASTER_RETURN), R11
        ; Technique 4 stages edge intersections, then replays compact rows
        ; through the unchanged lightmap span kernel.
    .if fixed_lightmap = 0
        lm      R0, (TEXTURE_RENDER_MODE)
        dec     R0
        bne     LightmapStageUnavailable
        nop
    .endif
        lm      R0, (CONVEX_TOP_PTR)
        lm      R1, (CONVEX_RASTER_Y)
        with    R0
        sub     R1
        move    R1, #GSU_LIGHTMAP_ROW_STAGE_ROWS
        with    R0
        sub     R1
        bpl     LightmapStageUnavailable
        nop
        jal     edge_cache
        nop
        iwt     R0, #GSU_LIGHTMAP_ROW_STAGE_OFFSET
        sm      (TEXTURE_COORD_PTR), R0
    .if edge_register_outputs = 1
        ; Keep the per-face edge route in the stage-count word until staging
        ; finishes. The row count is derived from the advanced stream pointer
        ; once per face, immediately before replay.
        iwt     R0, #T4TextureStageLightmapEdge
        sm      (TEXTURE_LIGHTMAP_FAST_ROUTINE), R0
    .else
        move    R0, #0
        sm      (TEXTURE_LIGHTMAP_FAST_ROUTINE), R0
    .endif
        bra     RowLoop
        nop
LightmapStageUnavailable:
    .if edge_register_outputs = 1
        iwt     R0, #$FFFF
        sm      (TEXTURE_COORD_PTR), R0
        iwt     R0, #T4TextureStageLightmapFallback
        sm      (TEXTURE_LIGHTMAP_FAST_ROUTINE), R0
    .else
        iwt     R0, #$FFFF
        sm      (TEXTURE_LIGHTMAP_FAST_ROUTINE), R0
    .endif
RowLoop:
        lm      R0, (CONVEX_RASTER_Y)
        BSP_SCALE_LOGICAL_TO_Q7 R0
        iwt     R1, #64
        with    R0
        add     R1
        sm      (CONVEX_SAMPLE_Y), R0

        lm      R10, (CONVEX_FORWARD_PTR)
        lm      R12, (CONVEX_SCREEN_COUNT)
ForwardAdvance:
        move    R9, R10
        with    R9
        add     #TEXTURE_SHADE_SCREEN_RECORD_BYTES
        lm      R0, (CONVEX_SCREEN_END_PTR)
        with    R9
        cmp     R0
        bne     ForwardNextReady
        nop
        iwt     R9, #TEXTURE_SCREEN
ForwardNextReady:
        move    R8, R9
        inc     R8
        inc     R8
        movew   R1, (R8)
        lm      R0, (CONVEX_SAMPLE_Y)
        move    R2, R1
        with    R2
        sub     R0
        moves   R2, R2
        bmi     ForwardStep
        nop
        beq     ForwardStep
        nop
        sm      (CONVEX_FORWARD_PTR), R10
        iwt     R13, #GSU_TEXTURE_EDGE_DIVIDE_CACHE_OFFSET
        jal     edge_intersect
    .if fixed_lightmap = 1
      .if edge_register_outputs = 1
        move    R2, #0
        lm      R10, (TEXTURE_LIGHTMAP_FAST_ROUTINE)
        link    #2
        jmp     R10
        nop
        bra     ReverseBegin
        nop
      .else
        lm      R1, (TEXTURE_LIGHTMAP_FAST_ROUTINE)
        moves   R1, R1
        bmi     DirectLeftFallback
        nop
        move    R2, #0
        jal     stage_row
        nop
        bra     ReverseBegin
        nop
DirectLeftFallback:
      .endif
    .endif
        sm      (CONVEX_MIN_X), R0
    .if edge_register_outputs = 0
        lm      R0, (TEXTURE_EDGE_S)
        sm      (TEXTURE_LEFT_S), R0
        lm      R0, (TEXTURE_EDGE_T)
        sm      (TEXTURE_LEFT_T), R0
    .endif
  .if edge_register_outputs = 0
        lm      R0, (TEXTURE_EDGE_SHADE)
        sm      (TEXTURE_LEFT_SHADE), R0
  .endif
        bra     ReverseBegin
        nop
ForwardStep:
        move    R10, R9
        dec     R12
        bne     ForwardAdvance
        nop
        GSU_ABSOLUTE_GOTO Done

ReverseBegin:
        lm      R10, (CONVEX_REVERSE_PTR)
        lm      R12, (CONVEX_SCREEN_COUNT)
ReverseAdvance:
        iwt     R0, #TEXTURE_SCREEN
        with    R10
        cmp     R0
        bne     ReverseNoWrap
        nop
        lm      R9, (CONVEX_SCREEN_END_PTR)
        with    R9
        sub     #TEXTURE_SHADE_SCREEN_RECORD_BYTES
        bra     ReverseNextReady
        nop
ReverseNoWrap:
        move    R9, R10
        with    R9
        sub     #TEXTURE_SHADE_SCREEN_RECORD_BYTES
ReverseNextReady:
        move    R8, R9
        inc     R8
        inc     R8
        movew   R1, (R8)
        lm      R0, (CONVEX_SAMPLE_Y)
        move    R2, R1
        with    R2
        sub     R0
        moves   R2, R2
        bpl     ReverseNonNegative
        nop
ReverseStep:
        move    R10, R9
        dec     R12
        bne     ReverseAdvance
        nop
        GSU_ABSOLUTE_GOTO Done
ReverseNonNegative:
        beq     ReverseStep
        nop
        sm      (CONVEX_REVERSE_PTR), R10
        iwt     R13, #GSU_TEXTURE_EDGE_DIVIDE_CACHE_OFFSET+GSU_TEXTURE_EDGE_DIVIDE_CACHE_ENTRY_BYTES
        jal     edge_intersect
    .if fixed_lightmap = 1
      .if edge_register_outputs = 1
        move    R2, #2
        lm      R10, (TEXTURE_LIGHTMAP_FAST_ROUTINE)
        link    #2
        jmp     R10
        nop
      .else
        lm      R1, (TEXTURE_LIGHTMAP_FAST_ROUTINE)
        moves   R1, R1
        bmi     DirectRightFallback
        nop
        move    R3, R1
        move    R2, #2
        jal     stage_row
        nop
        inc     R3
        sm      (TEXTURE_LIGHTMAP_FAST_ROUTINE), R3
        GSU_ABSOLUTE_GOTO NextRow
DirectRightFallback:
      .endif
    .endif
        sm      (CONVEX_MAX_X), R0
    .if edge_register_outputs = 0
        lm      R0, (TEXTURE_EDGE_S)
        sm      (TEXTURE_RIGHT_S), R0
        lm      R0, (TEXTURE_EDGE_T)
        sm      (TEXTURE_RIGHT_T), R0
    .endif
  .if edge_register_outputs = 0
        lm      R0, (TEXTURE_EDGE_SHADE)
        sm      (TEXTURE_RIGHT_SHADE), R0
  .endif

        lm      R1, (CONVEX_MIN_X)
        lm      R0, (CONVEX_MAX_X)
        move    R2, R0
        with    R2
        sub     R1
        bpl     XOrderReady
        nop
        sm      (CONVEX_MIN_X), R0
        sm      (CONVEX_MAX_X), R1
        lm      R2, (TEXTURE_LEFT_S)
        lm      R3, (TEXTURE_RIGHT_S)
        sm      (TEXTURE_LEFT_S), R3
        sm      (TEXTURE_RIGHT_S), R2
        lm      R2, (TEXTURE_LEFT_T)
        lm      R3, (TEXTURE_RIGHT_T)
        sm      (TEXTURE_LEFT_T), R3
        sm      (TEXTURE_RIGHT_T), R2
        lm      R2, (TEXTURE_LEFT_SHADE)
        lm      R3, (TEXTURE_RIGHT_SHADE)
        sm      (TEXTURE_LEFT_SHADE), R3
        sm      (TEXTURE_RIGHT_SHADE), R2
XOrderReady:
    .if edge_register_outputs = 0
        lm      R0, (TEXTURE_LIGHTMAP_FAST_ROUTINE)
        moves   R0, R0
        bpl     LightmapStageRow
        nop
    .endif
        lm      R1, (CONVEX_MIN_X)
        iwt     R0, #59
        with    R1
        add     R0
        BSP_ARITH_SHIFT7 R1, R2
        moves   R1, R1
        bpl     FirstReady
        nop
        move    R1, #0
FirstReady:
        lm      R3, (CONVEX_MAX_X)
        iwt     R0, #60
        with    R3
        sub     R0
        BSP_ARITH_SHIFT7 R3, R4
        move    R0, #127
        move    R4, R0
        with    R4
        sub     R3
        bpl     LastReady
        nop
        move    R3, R0
LastReady:
        move    R0, R3
        with    R0
        sub     R1
        bmi     NextRow
        nop
        lm      R2, (CONVEX_RASTER_Y)
    .if fixed_lightmap = 1
        jal     TextureDrawSpanLightmapped
        nop
    .else
        lm      R0, (TEXTURE_RENDER_MODE)
        dec     R0
        beq     LightmapSpan
        nop
        jal     TextureDrawSpanLightmapped
        nop
    .endif
        bra     NextRow
        nop
LightmapSpan:
        jal     TextureDrawSpanLightmapped
        nop
        bra     NextRow
        nop
LightmapStageRow:
        ; Both edge intersections leave the shaded-edge cache resident. Keep
        ; the row's RAM write burst in that window so its loads and stores do
        ; not compete with program fetches.
        jal     stage_row
        nop
        bra     NextRow
        nop
  .if edge_register_outputs = 1
T4TextureRasterNextRow:
  .endif
NextRow:
        lm      R0, (CONVEX_RASTER_Y)
        lm      R1, (CONVEX_TOP_PTR)
        with    R0
        cmp     R1
        beq     Done
        inc     R0
        sm      (CONVEX_RASTER_Y), R0
        GSU_ABSOLUTE_GOTO RowLoop
Done:
    .if edge_register_outputs = 1
        ; The handler pointer is stable across the direct-span fallback. Only
        ; the staged route advances TEXTURE_COORD_PTR in 16-byte row records.
        lm      R10, (TEXTURE_LIGHTMAP_FAST_ROUTINE)
        iwt     R12, #T4TextureStageLightmapEdge
        with    R10
        cmp     R12
        beq     T4ReplayAvailable
        nop
        GSU_ABSOLUTE_GOTO Return
T4ReplayAvailable:
        lm      R10, (TEXTURE_COORD_PTR)
        iwt     R12, #GSU_LIGHTMAP_ROW_STAGE_OFFSET
        with    R10
        sub     R12
      .repeat 4
        with    R10
        lsr
      .endrepeat
        move    R12, R10
        sm      (TEXTURE_LIGHTMAP_FAST_ROUTINE), R12
    .else
        lm      R12, (TEXTURE_LIGHTMAP_FAST_ROUTINE)
        moves   R12, R12
        bpl     ReplayAvailable
        nop
        GSU_ABSOLUTE_GOTO Return
    .endif
ReplayAvailable:
        bne     ReplayLoop
        nop
        GSU_ABSOLUTE_GOTO Return
ReplayLoop:
        ; CONVEX_RASTER_Y is the final staged row. Derive the first row from
        ; the contiguous count, then reuse the retired edge pointers as the
        ; replay cursor while span-local scratch remains untouched.
        lm      R0, (CONVEX_RASTER_Y)
        with    R0
        sub     R12
        inc     R0
        sm      (CONVEX_RASTER_Y), R0
        iwt     R0, #GSU_LIGHTMAP_ROW_STAGE_OFFSET
        sm      (CONVEX_FORWARD_PTR), R0
        ; Resolve every exact projective block endpoint while a private math
        ; cache owns the GSU window. A zero published pointer means that the
        ; bounded stream overflowed and the unchanged per-span path is used.
        jal     TexturePrepareFaceEndpointBatch
        nop
        ; Edge staging deliberately replaced the lightmap cache. Restore its
        ; exact window once before any projective span setup performs divides.
        jal     TexturePrimeLightmapCache
        nop
ReplayRows:
        lm      R10, (CONVEX_FORWARD_PTR)
        movew   R1, (R10)
        sm      (CONVEX_MIN_X), R1
        inc     R10
        inc     R10
        movew   R3, (R10)
        sm      (CONVEX_MAX_X), R3
        inc     R10
        inc     R10
        ; Recreate the exact covered logical interval from the staged raw-Q7
        ; intersections. The span kernel also consumes those raw endpoints for
        ; its perspective denominator.
        iwt     R0, #59
        with    R1
        add     R0
        BSP_ARITH_SHIFT7 R1, R2
        moves   R1, R1
        bpl     ReplayFirstReady
        nop
        move    R1, #0
ReplayFirstReady:
        iwt     R0, #60
        with    R3
        sub     R0
        BSP_ARITH_SHIFT7 R3, R4
        move    R0, #127
        move    R4, R0
        with    R4
        sub     R3
        bpl     ReplayLastReady
        nop
        move    R3, R0
ReplayLastReady:
        move    R0, R3
        with    R0
        sub     R1
        bpl     ReplayCoordinates
        nop
        with    R10
        add     #12
        sm      (CONVEX_FORWARD_PTR), R10
        bra     ReplayNext
        nop
ReplayCoordinates:
        lm      R0, (GSU_TEXTURE_ENDPOINT_READ_PTR_OFFSET)
        moves   R0, R0
        bne     ReplayBufferedCoordinates
        nop
        movew   R0, (R10)
        sm      (TEXTURE_BASE_S), R0
        inc     R10
        inc     R10
        movew   R4, (R10)
        with    R4
        sub     R0
        sm      (TEXTURE_DELTA_S), R4
        inc     R10
        inc     R10
        movew   R0, (R10)
        sm      (TEXTURE_BASE_T), R0
        inc     R10
        inc     R10
        movew   R4, (R10)
        with    R4
        sub     R0
        sm      (TEXTURE_DELTA_T), R4
        inc     R10
        inc     R10
        movew   R0, (R10)
        sm      (TEXTURE_BASE_DEPTH), R0
        inc     R10
        inc     R10
        movew   R4, (R10)
        with    R4
        sub     R0
        sm      (TEXTURE_DELTA_DEPTH), R4
        inc     R10
        inc     R10
        sm      (CONVEX_FORWARD_PTR), R10
        bra     ReplayCoordinatesReady
        nop
ReplayBufferedCoordinates:
        ; The cached prepass already consumed these six exact endpoint words.
        ; Advance the row stream without rebuilding state that replay will not
        ; read when every projective sample comes from the published buffer.
        with    R10
        add     #12
        sm      (CONVEX_FORWARD_PTR), R10
ReplayCoordinatesReady:
        move    R0, #0
        sm      (LIGHTMAP_BLOCK_FAST), R0
        sm      (TEXTURE_SPAN_X), R1
        sm      (TEXTURE_SPAN_END_X), R3
        lm      R2, (CONVEX_RASTER_Y)
        jal     TextureDrawSpanLightmappedPrepared
        nop
ReplayNext:
        lm      R0, (CONVEX_RASTER_Y)
        inc     R0
        sm      (CONVEX_RASTER_Y), R0
        lm      R0, (TEXTURE_LIGHTMAP_FAST_ROUTINE)
        dec     R0
        sm      (TEXTURE_LIGHTMAP_FAST_ROUTINE), R0
        beq     ReplayClearEndpoints
        nop
        GSU_ABSOLUTE_GOTO ReplayRows
ReplayClearEndpoints:
        move    R0, #0
        sm      (GSU_TEXTURE_ENDPOINT_READ_PTR_OFFSET), R0
Return:
        lm      R11, (TEXTURE_RASTER_RETURN)
        ret
        nop
  .if fixed_lightmap = 0
    ; The specialized T4 overlays depend on the established general-raster
    ; window. Fill only the general instance after removing retired branches.
    .repeat GSU_T4_RASTER_CODE_CAPACITY - (* - entry)
        nop
    .endrepeat
  .endif
.endmacro

; General retained lightmap raster.
DEFINE_TEXTURE_SHADED_RASTER TextureRasterPolygonShaded, 0, TextureCacheActiveEdgeShaded, TextureIntersectActiveEdgeShaded, TextureStageLightmapRow, 0

; R10 and R9 name the upper and lower 8-byte screen records. Return Q7 x in
; R0 and the corresponding signed Q4 texture coordinate in TEXTURE_EDGE_S/T.
; Projective records append geometric Q6 camera depth after x/y/s/t.
TextureCacheActiveEdgeShaded:
        cache
        ret
        nop
TextureIntersectActiveEdgeShaded:
        sm      (TEXTURE_EDGE_RETURN), R11
        movew   R4, (R10)
        inc     R10
        inc     R10
        movew   R5, (R10)
        inc     R10
        inc     R10
        movew   R8, (R10)
        sm      (TEXTURE_BASE_S), R8
        inc     R10
        inc     R10
        movew   R12, (R10)
        sm      (TEXTURE_BASE_T), R12
        inc     R10
        inc     R10
        movew   R11, (R10)
        sm      (TEXTURE_BASE_DEPTH), R11

        movew   R6, (R9)
        inc     R9
        inc     R9
        movew   R7, (R9)
        inc     R9
        inc     R9
        movew   R0, (R9)
        with    R0
        sub     R8
        sm      (TEXTURE_DELTA_S), R0
        inc     R9
        inc     R9
        movew   R0, (R9)
        with    R0
        sub     R12
        sm      (TEXTURE_DELTA_T), R0
        inc     R9
        inc     R9
        movew   R0, (R9)
        with    R0
        sub     R11
        sm      (TEXTURE_DELTA_DEPTH), R0

        lm      R0, (CONVEX_SAMPLE_Y)
        move    R1, R0
        with    R1
        sub     R5
        move    R0, R7
        with    R0
        sub     R5
        move    R2, R0
        sm      (CONVEX_BASE_RIGHT), R4
        move    R0, R6
        with    R0
        sub     R4
        sm      (CONVEX_DELTA_RIGHT), R0
        ; Preserve the already-loaded upper depth across the cached edge divide
        ; so perspective modes can skip reloading it in their factor helper.
        move    R5, R11
        ; The shared reciprocal divider returns floor(numerator*4096 /
        ; denominator). Dropping its two low bits is exactly the former Q10
        ; restoring quotient, while avoiding ten serial divide iterations.
        move    R0, R1
        jal     TextureDivideQ12EdgeCachedWindow
        ; Clearing the two low quotient bits is exactly the former Q12->Q10
        ; shift followed by Q10->Q12 promotion.
        iwt     R1, #$FFFC
        with    R3
        and     R1
        sm      (CONVEX_FACTOR), R3
TextureShadeIntersectModeDispatch:
        jal     TexturePerspectiveFactorQ12BaseLoaded
        move    R6, R3
        bra     TextureShadeIntersectScaleFactor
        nop
  .repeat GSU_T4_EDGE_PATCH_CAPACITY - (* - TextureShadeIntersectModeDispatch)
        nop
  .endrepeat
        ; Scale the shared perspective factor once for geometric depth, S,
        ; and T. Values below unity stay nonnegative in Q15; exact unity uses
        ; base + delta.
TextureShadeIntersectScaleFactor:
  .repeat 3
        with    R6
        add     R6
  .endrepeat
        moves   R6, R6
        bpl     TextureShadeIntersectScaledDepth
        nop
        GSU_ABSOLUTE_GOTO TextureShadeIntersectUnityAttributes
TextureShadeIntersectScaledDepth:
        ; Perspective modes retain the helper's live depth endpoints.
        BSP_SIGNED_MUL_SCALED8_SHIFT_TRUNC12 R7
        with    R5
        add     R0
        sm      (TEXTURE_EDGE_SHADE), R5
        bra     TextureShadeIntersectScaledAttributes
        nop
TextureShadeIntersectDepthEnd:
        ; Vacant former affine-shading jump; the retained paths are projective.
        .res    4
TextureStageLightmapRow:
        ; One record per logical row: raw min/max X followed by exact left and
        ; right S/T/depth. Convex rows are contiguous, so Y is reconstructed
        ; from the final raster row and the record count during replay.
        lm      R10, (TEXTURE_COORD_PTR)
        lm      R1, (CONVEX_MIN_X)
        lm      R3, (CONVEX_MAX_X)
        movew   (R10), R1
        inc     R10
        inc     R10
        movew   (R10), R3
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_LEFT_S)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_RIGHT_S)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_LEFT_T)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_RIGHT_T)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_LEFT_SHADE)
        movew   (R10), R0
        inc     R10
        inc     R10
        lm      R0, (TEXTURE_RIGHT_SHADE)
        movew   (R10), R0
        inc     R10
        inc     R10
        sm      (TEXTURE_COORD_PTR), R10
        lm      R0, (TEXTURE_LIGHTMAP_FAST_ROUTINE)
        inc     R0
        sm      (TEXTURE_LIGHTMAP_FAST_ROUTINE), R0
        ret
        nop
TextureShadeIntersectScaledAttributes:
        lm      R5, (TEXTURE_BASE_S)
        lm      R7, (TEXTURE_DELTA_S)
        BSP_SIGNED_MUL_SCALED8_SHIFT_TRUNC12 R7
        with    R5
        add     R0
        sm      (TEXTURE_EDGE_S), R5
        lm      R5, (TEXTURE_BASE_T)
        lm      R7, (TEXTURE_DELTA_T)
        BSP_SIGNED_MUL_SCALED8_SHIFT_TRUNC12 R7
        with    R5
        add     R0
        sm      (TEXTURE_EDGE_T), R5
        bra     TextureShadeIntersectScreenX
        nop
TextureShadeIntersectUnityAttributes:
        GSU_ABSOLUTE_GOTO TextureShadeIntersectUnityAttributesCold
  .repeat GSU_T4_EDGE_OUTPUT_CAPACITY - (* - TextureShadeIntersectScaledAttributes)
        nop
  .endrepeat
TextureShadeIntersectScreenX:
        lm      R5, (CONVEX_BASE_RIGHT)
        lm      R7, (CONVEX_DELTA_RIGHT)
        lm      R3, (CONVEX_FACTOR)
        move    R6, R3
  .repeat 3
        with    R6
        add     R6
  .endrepeat
        BSP_SIGNED_MUL_SCALED8_SHIFT12 R7
        with    R5
        add     R0
        move    R0, R5
        lm      R11, (TEXTURE_EDGE_RETURN)
        ret
        nop

; Put the recurring edge reciprocal-cache hit and miss dispatch in the shaded
; kernel's former $DE10 padding; the same fly-valid code runs cold for brushes.
TextureDivideQ12EdgeCachedWindow:
        move    R8, R0
        move    R9, R2
        move    R7, R13
        movew   R1, (R7)
        with    R9
        cmp     R1
        bne     TextureDivideQ12EdgeCachedWindowMiss
        nop
        inc     R7
        inc     R7
        movew   R6, (R7)
        inc     R7
        inc     R7
        movew   R13, (R7)
        bra     TextureDivideQ12EdgeLoadedCached
        nop
TextureDivideQ12EdgeCachedWindowMiss:
        GSU_ABSOLUTE_GOTO TextureDivideQ12EdgeCachedWindowMissCold
; Convert a Q12 screen-space interpolation factor in R3 to its perspective-
; correct world-edge factor. Positive Q6 endpoint depths are stored as
; TEXTURE_BASE_DEPTH and TEXTURE_BASE_DEPTH+TEXTURE_DELTA_DEPTH.
TexturePerspectiveFactorQ12:
        lm      R5, (TEXTURE_BASE_DEPTH)
TexturePerspectiveFactorQ12BaseLoaded:
        ; Three doubles scale Q12 to Q15 without wrapping for factors below
        ; unity. The only negative result is exactly 4096, handled directly.
        move    R6, R3
  .repeat 3
        with    R6
        add     R6
  .endrepeat
        moves   R6, R6
        bpl     TexturePerspectiveFactorScaledProducts
        nop
        GSU_ABSOLUTE_GOTO TexturePerspectiveFactorUnityProductsCold
TexturePerspectiveFactorScaledProducts:
        ; Base depth is nonnegative; its floor product needs no signed
        ; truncation correction. Delta depth retains exact toward-zero rules.
        BSP_SIGNED_MUL_SCALED8_SHIFT12 R5
        move    R12, R0
        lm      R7, (TEXTURE_DELTA_DEPTH)
        BSP_SIGNED_MUL_SCALED8_SHIFT_TRUNC12 R7
        move    R1, R0
        bra     TexturePerspectiveFactorProductsReady
        nop
TexturePerspectiveFactorProductsReady:
        move    R2, R5
        move    R0, R7
        with    R2
        add     R0
        with    R2
        sub     R1

        move    R0, R12
        with    R0
        cmp     R2
        bne     TexturePerspectiveFactorDivide
        nop
        iwt     R3, #4096
        ret
        nop
TexturePerspectiveFactorDivide:
        ; This is the sole ordinary-divide caller. Enter the cached lookup
        ; directly instead of paying a cold call/trampoline round trip.
        move    R8, R0
        move    R9, R2
        lm      R10, (TEXTURE_Q12_LOADED_ROUTINE)
        lm      R13, (TEXTURE_Q12_LOOKUP_ROUTINE)
        jmp     R13
        nop

; The edge cache already owns both reciprocal limbs. Keep its repeated exact
; hit quotient multiply in that same window while R6=high and R13=low remain
; live from the cache record. Misses use the same edge-specific fill path in
; both ordered playback and ordinary fly rendering.
TextureDivideQ12EdgeLoadedCached:
        move    R0, R8
        with    R0
        lmult
        move    R3, R4
        move    R6, R13
        move    R0, R8
        with    R0
        lmult
        with    R4
        add     R4
        with    R0
        adc     R0
        with    R3
        add     R0
        with    R4
        lsr
        with    R4
        cmp     R8
        bcs     TextureDivideQ12EdgeReady
        nop
        GSU_ABSOLUTE_GOTO TextureDivideQ12CorrectionCold
TextureDivideQ12EdgeReady:
        ret
        nop
  .repeat 3
        nop
  .endrepeat
; Evaluate the current shaded span at logical pixel center R0. The ordered
; edge intersections retain raw Q7 X, signed-Q4 S/T, and positive Q6 depth.
; Return perspective-correct S/T in R5/R6. Depth contributes to the
; perspective factor but no caller consumes the interpolated depth itself.
TexturePerspectiveSampleSpan:
        sm      (TEXTURE_PERSPECTIVE_RETURN), R11
        BSP_SCALE_LOGICAL_TO_Q7 R0
        iwt     R1, #64
        with    R0
        add     R1
        lm      R1, (CONVEX_MIN_X)
        with    R0
        sub     R1
        bpl     TexturePerspectiveSampleNumeratorPositive
        nop
        move    R0, #0
TexturePerspectiveSampleNumeratorPositive:
        lm      R2, (CONVEX_MAX_X)
        with    R2
        sub     R1
        moves   R2, R2
        bne     TexturePerspectiveSampleDenReady
        nop
        move    R3, #0
        bra     TexturePerspectiveSampleFactorReady
        nop
TexturePerspectiveSampleDenReady:
        move    R4, R0
        with    R4
        sub     R2
        bmi     TexturePerspectiveSampleDivide
        nop
        iwt     R3, #4096
        bra     TexturePerspectiveSampleFactorReady
        nop
TexturePerspectiveSampleDivide:
        lm      R13, (TEXTURE_Q12_PREPARED_ROUTINE)
        link    #2
        jmp     R13
        nop

TexturePerspectiveSampleFactorReady:
        jal     TexturePerspectiveFactorQ12

        lm      R5, (TEXTURE_BASE_S)
        lm      R7, (TEXTURE_DELTA_S)
        move    R6, R3
  .repeat 3
        with    R6
        add     R6
  .endrepeat
        moves   R6, R6
        bmi     TexturePerspectiveSampleUnityCoordinates
        nop
        BSP_SIGNED_MUL_SCALED8_SHIFT_TRUNC12 R7
        with    R5
        add     R0
        move    R8, R5
        lm      R5, (TEXTURE_BASE_T)
        lm      R7, (TEXTURE_DELTA_T)
        BSP_SIGNED_MUL_SCALED8_SHIFT_TRUNC12 R7
        with    R5
        add     R0
        move    R6, R5
        move    R5, R8
        bra     TexturePerspectiveSampleCoordinatesReady
        nop
TexturePerspectiveSampleUnityCoordinates:
        lm      R5, (TEXTURE_BASE_S)
        lm      R0, (TEXTURE_DELTA_S)
        with    R5
        add     R0
        lm      R6, (TEXTURE_BASE_T)
        lm      R0, (TEXTURE_DELTA_T)
        with    R6
        add     R0
TexturePerspectiveSampleCoordinatesReady:
        lm      R11, (TEXTURE_PERSPECTIVE_RETURN)
        ret
        nop
TextureDrawSpanLightmappedPrepared:
        sm      (TEXTURE_SPAN_RETURN), R11
        iwt     R10, #GSU_TEXTURE_COORD_MAP_OFFSET
        with    R10
        add     R2
        move    R2, #0
        moveb   R2, (R10)
        sm      (TEXTURE_PLOT_Y), R2
        GSU_ABSOLUTE_GOTO TextureDrawSpanLightmappedDenominator
  .repeat 24 - (* - TextureDrawSpanLightmappedPrepared)
        nop
  .endrepeat
; Lightmapped perspective span. Resolve exact pixel-center endpoints every
; eight pixels, then use the existing signed quotient/remainder DDA inside the
; short block. Absolute Q4 remains available to the BSP light grid.
TextureDrawSpanLightmapped:
        sm      (TEXTURE_SPAN_RETURN), R11
        move    R0, #0
        sm      (LIGHTMAP_BLOCK_FAST), R0
        sm      (TEXTURE_SPAN_X), R1
        sm      (TEXTURE_SPAN_END_X), R3
        ; The logical row is invariant across the span. Map it to the tiled
        ; 2x presentation coordinate once instead of re-reading the map for
        ; every plotted pixel.
        iwt     R10, #GSU_TEXTURE_COORD_MAP_OFFSET
        with    R10
        add     R2
        move    R2, #0
        moveb   R2, (R10)
        sm      (TEXTURE_PLOT_Y), R2
        jal     TexturePrepareDirectSpanEndpoints
        nop
TextureDrawSpanLightmappedDenominator:
        ; The projected-edge denominator is invariant for every exact sample
        ; in this span. Fetch its reciprocal limbs once instead of per block.
        ; A published endpoint stream has already consumed that reciprocal in
        ; the phase-separated math pass, so replay needs no duplicate lookup.
        lm      R0, (GSU_TEXTURE_ENDPOINT_READ_PTR_OFFSET)
        moves   R0, R0
        bne     TexturePerspectiveReciprocalReady
        nop
        lm      R2, (CONVEX_MAX_X)
        lm      R1, (CONVEX_MIN_X)
        with    R2
        sub     R1
        moves   R2, R2
        beq     TexturePerspectiveReciprocalReady
        nop
        jal     TexturePrepareDivideQ12
TexturePerspectiveReciprocalReady:
        lm      R0, (TEXTURE_SPAN_X)
        jal     TexturePerspectiveSampleSpanBuffered
        sm      (TEXTURE_SPAN_S), R5
        sm      (TEXTURE_SPAN_T), R6
        ; Reciprocal lookup changes ROMB. Select the face texture once before
        ; the first sample; wholly packed textures retain it for the block.
        lm      R0, (TEXTURE_ROM_BANK)
        romb
        lm      R0, (TEXTURE_SPAN_X)
        lm      R1, (TEXTURE_SPAN_END_X)
        with    R0
        cmp     R1
        bne     TextureLightmapBlockSetup
        nop
        GSU_COMPOSED_GOTO_IF_SELECTED TextureComposedSpanStart
        GSU_ABSOLUTE_GOTO TextureLightmapSpanLoop
TextureLightmapBlockSetup:
        lm      R0, (TEXTURE_SPAN_X)
        move    R4, R0
        with    R4
        add     #8
        lm      R1, (TEXTURE_SPAN_END_X)
        move    R8, R4
        move    R2, R4
        with    R2
        sub     R1
        bpl     TextureLightmapBlockFinalSetup
        nop
        GSU_COMPOSED_GOTO_LIGHTMAP_BLOCK8 TextureComposedLightmapBlock8Setup, TextureLightmapBlock8CachedSetup
TextureLightmapBlockFinalSetup:
        move    R4, R1
        iwt     R8, #$FFFF
TextureLightmapBlockEndReady:
        sm      (TEXTURE_BLOCK_END_X), R4
        ; A final block uses an unreachable sentinel so the hot loop needs only
        ; one projective-boundary comparison after its end-of-span check.
        sm      (TEXTURE_SIGN_S), R8
        move    R0, R4
        jal     TexturePerspectiveSampleSpanBuffered
        sm      (TEXTURE_BLOCK_END_S), R5
        sm      (TEXTURE_BLOCK_END_T), R6
        move    R10, R6
        lm      R0, (TEXTURE_BLOCK_END_X)
        lm      R1, (TEXTURE_SPAN_X)
        with    R0
        sub     R1
        sm      (TEXTURE_SPAN_DEN), R0
        move    R1, R0
        with    R1
        sub     #8
        bne     TextureLightmapShortBlockSetup
        nop
        GSU_ABSOLUTE_GOTO TextureLightmapBlock8Setup
TextureLightmapShortBlockSetup:
        move    R0, R5
        lm      R1, (TEXTURE_SPAN_S)
        with    R0
        sub     R1
        move    R4, #1
        moves   R0, R0
        bpl     TextureLightmapBlockSPositive
        nop
        iwt     R4, #-1
        move    R1, #0
        with    R1
        sub     R0
        move    R0, R1
TextureLightmapBlockSPositive:
        move    R8, R4
        lm      R1, (TEXTURE_SPAN_DEN)
        jal     TextureDivideBlockUnsigned
        move    R7, R2
        move    R9, R3
        move    R0, R10
        lm      R1, (TEXTURE_SPAN_T)
        with    R0
        sub     R1
        move    R4, #1
        moves   R0, R0
        bpl     TextureLightmapBlockTPositive
        nop
        iwt     R4, #-1
        move    R1, #0
        with    R1
        sub     R0
        move    R0, R1
TextureLightmapBlockTPositive:
        ; Preserve S state across the second width-1..8 divider, then map
        ; both quotient/remainder pairs directly into the builder ABI.
        move    R10, R8
        move    R8, R4
        lm      R1, (TEXTURE_SPAN_DEN)
        jal     TextureDivideBlockUnsigned
        move    R11, R8
        move    R8, R2
        move    R13, R3
        move    R4, R10
        ; The coordinate builder initializes its live error accumulators in
        ; R1/R2; the overlaid affine-state words are not consumed here.
        GSU_ABSOLUTE_GOTO TextureBuildCoordinateBlockLightmapRegisters
        ; Keep the established selector/cache layout while the register-fed
        ; builder returns directly to the continuation below.
  .repeat 1
        nop
  .endrepeat
TextureLightmapCoordinateBlockReady:
        GSU_COMPOSED_GOTO_IF_SELECTED TextureComposedSpanStart
        ; Preparation now tail-calls the selector. No return address needs to
        ; be spilled and restored once per projective block.
        GSU_ABSOLUTE_GOTO LightmapPrepareBlock
; Pick one direct pixel loop per projective block when both the face sampler
; and lightmap mode are known. All uncommon faces and checked blocks retain the
; established indirect sampler/decoder route.
TextureLightmapSelectBlockRoutine:
        ; Restore the texture ROM bank only once preparation has finished.
        lm      R0, (TEXTURE_ROM_BANK)
        romb
        lm      R0, (LIGHTMAP_BLOCK_FAST)
        moves   R0, R0
        bpl     TextureLightmapRouteIndexReady
        nop
        move    R0, #5
TextureLightmapRouteIndexReady:
        with    R0
        add     R0
        iwt     R10, #TEXTURE_STEP_S
        with    R10
        add     R0
        movew   R13, (R10)
        GSU_ABSOLUTE_GOTO TextureLightmapBlockRoutineReady
        ; Uncommon square textures use the generic pixel loop. Handle its
        ; cached constant/vertical modes in this unreachable slot so the
        ; established per-pixel tail and later cache kernels stay pinned.
LightmapSampleCachedDegenerate:
        dec     R0
        bne     LightmapSampleCachedVertical
        nop
        lm      R4, (LIGHTMAP_BLOCK_UL)
        GSU_ABSOLUTE_GOTO LightmapSampleMap
LightmapSampleCachedVertical:
        move    R5, R9
        lm      R6, (LIGHTMAP_BLOCK_LL)
        GSU_ABSOLUTE_GOTO TextureLightmapOneAxisSample
TextureLightmapBlockRoutineReady:
        ; Keep the block route resident in R13 until the projective boundary.
        ; The generic sampler dispatches through R12 so neither sampler path
        ; needs to spill or reload this per-pixel continuation.
        iwt     R7, #TextureLightmapSampleReady
        lm      R5, (TEXTURE_SPAN_S)
        lm      R6, (TEXTURE_SPAN_T)
        iwt     R10, #GSU_TEXTURE_BLOCK_COORDS_OFFSET+4
        jmp     R13
        nop
TextureLightmapBilinearSpanLoop:
        move    R8, R5
        move    R9, R6
        jal     TextureSampleAbsolutePowerOfTwoSingleBankRegisters
        move    R12, R0
        move    R3, R8
        iwt     R1, #$00F0
        GSU_ABSOLUTE_GOTO LightmapSampleBlockBilinearCached
TextureLightmapConstantSpanLoop:
        jal     TextureSampleAbsolutePowerOfTwoSingleBankRegisters
        move    R12, R0
        ; Constant blocks publish their mapped page once during preparation.
        lm      R4, (LIGHTMAP_BLOCK_LR)
        GSU_ABSOLUTE_GOTO TextureLightmapSampleReady
TextureLightmapSpanLoop:
        ; Keep exact Q4 coordinates for the lightmap decoder while the
        ; face-selected texture sampler destructively wraps R5/R6.
        move    R8, R5
        move    R9, R6
        ; The sampler route is invariant for the complete face. LINK #2 skips
        ; the indirect JMP and its delay slot, matching a normal JAL return.
        lm      R12, (TEXTURE_SAMPLE_ROUTINE)
        link    #2
        jmp     R12
        nop
        ; LightmapSample does not consume R12. Keep the texture index there
        ; across the call instead of spilling it to cartridge RAM per pixel.
        move    R12, R0
        jal     LightmapSample
TextureLightmapSampleReturn:
        ; Generic JAL returns are fixed at this address. Redirect them into the
        ; cache window; specialized R7 returns already target the moved tail.
        GSU_ABSOLUTE_GOTO TextureLightmapSampleReady
        nop
; This camera loader runs once per renderer command. Its 106-byte cold slot is
; more valuable to the per-pixel lightmap tail below, so keep its public entry
; at the old hot-tail address and leave downstream layout unchanged.
LoadProjectedPacketState:
        iwt     R10, #COMMAND
        GSU_LOAD_BYTE R4               ; yaw
        GSU_LOAD_BYTE R5               ; pitch
        iwt     R10, #COMMAND+8
        GSU_LOAD_BYTE R0               ; camera x
        with    R0
        sex
        sm      (CAMERA_X), R0
        GSU_LOAD_BYTE R0               ; camera y
        with    R0
        sex
        sm      (CAMERA_Y), R0
        GSU_LOAD_BYTE R0               ; camera z
        with    R0
        sex
        sm      (CAMERA_Z), R0
        GSU_LOAD_SIGNED_TABLE R0, GSU_SIN_OFFSET, R4
        sm      (YAW_SIN), R0
        GSU_LOAD_SIGNED_TABLE R0, GSU_COS_OFFSET, R4
        sm      (YAW_COS), R0
        GSU_LOAD_SIGNED_TABLE R0, GSU_SIN_OFFSET, R5
        sm      (PITCH_SIN), R0
        GSU_LOAD_SIGNED_TABLE R0, GSU_COS_OFFSET, R5
        sm      (PITCH_COS), R0
        ; Selector admission already populated PROJECTED and VALID for every
        ; accepted local vertex. Retain only the camera state needed by the
        ; cold near-plane clipper; unchanged packets reuse all three arrays.
        ret
        nop
; Place the uncommon pitch transform in the retired span window while
; preserving all downstream technique-4 sampler overlay addresses.
PacketProjectPitchedVertex:
        cache
        BSP_SIGNED_MUL_SHIFT R12, R3, R9, 2
        lm      R5, (PACKET_VIEW_FORWARD)
        BSP_SIGNED_MUL_SHIFT R7, R5, R9, 6
        lm      R9, (PACKET_PITCH_SIN)
        BSP_SIGNED_MUL_SHIFT R0, R5, R9, 6
        with    R12
        sub     R0
        sm      (PACKET_VIEW_UP), R12
        BSP_SIGNED_MUL_SHIFT R0, R3, R9, 2
        with    R7
        add     R0
        sm      (PACKET_VIEW_DEPTH), R7
        GSU_ABSOLUTE_GOTO PacketProjectTransformedWorldVertex, shared_delay
        with    R7
.res $1FE - (* - PacketProjectPitchedVertex)
; Wrap absolute Q4 coordinates in temporary registers, leaving the span state
; untouched for lightmap lookup. Quake contains a few non-power-of-two miptex.
TextureSampleAbsolute:
        lm      R5, (TEXTURE_SPAN_S)
        lm      R6, (TEXTURE_SPAN_T)
TextureSampleAbsoluteRegisters:
        lm      R0, (TEXTURE_WRAP_FLAGS)
        move    R7, R0
        with    R0
        and     #BSP_WORLD_TEXTURE_FLAG_POWER_OF_TWO_AXES
        moves   R0, R0
        beq     TextureSampleAbsoluteSNegative
        nop
        lm      R1, (TEXTURE_WRAP_MASK_S)
        with    R5
        and     R1
        lm      R1, (TEXTURE_WRAP_MASK_T)
        with    R6
        and     R1
        bra     TextureSampleCoordinatesReady
        nop
TextureSampleAbsoluteSNegative:
        moves   R5, R5
        bpl     TextureSampleAbsoluteSHigh
        nop
        lm      R1, (TEXTURE_WIDTH_Q4)
        with    R5
        add     R1
        bra     TextureSampleAbsoluteSNegative
        nop
TextureSampleAbsoluteSHigh:
        lm      R1, (TEXTURE_WIDTH_Q4)
        move    R0, R5
        with    R0
        sub     R1
        bmi     TextureSampleAbsoluteSDone
        nop
        move    R5, R0
        bra     TextureSampleAbsoluteSHigh
        nop
TextureSampleAbsoluteSDone:
TextureSampleAbsoluteTNegative:
        moves   R6, R6
        bpl     TextureSampleAbsoluteTHigh
        nop
        lm      R1, (TEXTURE_HEIGHT_Q4)
        with    R6
        add     R1
        bra     TextureSampleAbsoluteTNegative
        nop
TextureSampleAbsoluteTHigh:
        lm      R1, (TEXTURE_HEIGHT_Q4)
        move    R0, R6
        with    R0
        sub     R1
        bmi     TextureSampleAbsoluteTDone
        nop
        move    R6, R0
        bra     TextureSampleAbsoluteTHigh
        nop
TextureSampleAbsoluteTDone:
        bra     TextureSampleAbsoluteCoordinatesReady
        nop
TextureSample:
        lm      R5, (TEXTURE_SPAN_S)
        lm      R6, (TEXTURE_SPAN_T)
        move    R7, #0
TextureSampleAbsoluteCoordinatesReady:
TextureSampleCoordinatesReady:
  .repeat 4
        with    R5
        lsr
  .endrepeat
  .repeat 4
        with    R6
        lsr
  .endrepeat
        lm      R1, (TEXTURE_WIDTH)
        iwt     R0, #256
        with    R1
        cmp     R0
        beq     TextureSampleWidth256
        nop
        move    R0, R6
        with    R0
        umult   R1
        with    R0
        add     R5
        move    R5, R0
        bra     TextureSampleOffsetReady
        nop
TextureSampleWidth256:
        with    R6
        swap
        with    R6
        add     R5
        move    R5, R6
TextureSampleOffsetReady:
        with    R7
        and     #BSP_WORLD_TEXTURE_FLAG_SINGLE_BANK
        beq     TextureSampleGenericBank
        nop
        lm      R4, (TEXTURE_ROM_ADDRESS)
        with    R4
        add     R5
        GSU_SET_ROM_BUFFER_ADDRESS R4
        BSP_ROM_LOAD_BYTE R0
        ret
        nop
TextureSampleGenericBank:
        lm      R4, (TEXTURE_ROM_ADDRESS)
        iwt     R1, #$7FFF
        with    R4
        and     R1
        with    R4
        add     R5
        bcs     TextureSampleTwoBanks
        nop
        iwt     R1, #$8000
        move    R2, R4
        with    R2
        cmp     R1
        bcc     TextureSampleSameBank
        nop
        lm      R0, (TEXTURE_ROM_BANK)
        inc     R0
        romb
        GSU_SET_ROM_BUFFER_ADDRESS R4
        BSP_ROM_LOAD_BYTE R0
        ret
        nop
TextureSampleSameBank:
        with    R4
        add     R1
        lm      R0, (TEXTURE_ROM_BANK)
        romb
        GSU_SET_ROM_BUFFER_ADDRESS R4
        BSP_ROM_LOAD_BYTE R0
        ret
        nop
TextureSampleTwoBanks:
        iwt     R1, #$8000
        with    R4
        add     R1
        lm      R0, (TEXTURE_ROM_BANK)
        inc     R0
        inc     R0
        romb
        GSU_SET_ROM_BUFFER_ADDRESS R4
        BSP_ROM_LOAD_BYTE R0
        ret
        nop
 .include "quake/LightmapSample.sgs"
; Keep the composed texel-to-plot tail in the cache window established by
; LightmapSampleHorizontalReady. It formerly occupied the cold loader slot.
TextureLightmapSampleReady:
        with    R4
        swap
        with    R4
        add     R12
        moveb   R0, (R4)
TextureLightmapSkyPlotReady:
        color
        lm      R0, (TEXTURE_SPAN_X)
        iwt     R8, #GSU_TEXTURE_COORD_MAP_OFFSET
        with    R8
        add     R0
        moveb   R1, (R8)
        lm      R2, (TEXTURE_PLOT_Y)
        plot
        ; PLOT advances only R1. R0 still holds the logical X used to address
        ; the coordinate map, so retain it through the boundary tests.
        lm      R1, (TEXTURE_SPAN_END_X)
        with    R0
        cmp     R1
        bne     TextureLightmapSpanContinue
        inc     R0
        bra     TextureLightmapSpanDone
        nop
TextureLightmapSpanContinue:
        movew   R5, (R10)
        inc     R10
        inc     R10
        movew   R6, (R10)
        inc     R10
        inc     R10
        iwt     R8, #TEXTURE_SPAN_X
        lm      R1, (TEXTURE_SIGN_S)
        with    R0
        cmp     R1
        beq     TextureLightmapSpanCheckBlock
        ; Publish X with a single STW in the boundary branch delay slot. R8's
        ; former coordinate-map pointer is dead and each sampler reloads it.
        stw     (R8)
TextureLightmapSpanDispatch:
        jmp     R13
        nop
TextureLightmapSpanCheckBlock:
        ; Only the next projective block needs memory-backed coordinates.
        ; Within a block, R5/R6 stream directly into both samplers.
        sm      (TEXTURE_SPAN_S), R5
        sm      (TEXTURE_SPAN_T), R6
        GSU_ABSOLUTE_GOTO TextureLightmapBlockSetup
.include "quake/TextureCachedDivideTail.sgs"
TextureLightmapSpanDone:
        lm      R11, (TEXTURE_SPAN_RETURN)
        ret
