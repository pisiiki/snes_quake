; Experimental E1M3 X2 surface cache. Payloads live in $70, tags in $71.
.ifndef MSU_SURFACE_SLOT_BYTES
MSU_SURFACE_SLOT_BYTES = $1000
.endif
.if MSU_SURFACE_SLOT_BYTES = $0600
MSU_SURFACE_SLOT_COUNT = 4
.else
MSU_SURFACE_SLOT_COUNT = 2
.endif
MSU_SURFACE_SLOT_BASE = $8800 - MSU_SURFACE_SLOT_BYTES * MSU_SURFACE_SLOT_COUNT
MSU_L2_SLOT_COUNT = $F000 / MSU_SURFACE_SLOT_BYTES
MSU_L2_ENTRY_BYTES = 16
MSU_SURFACE_DIRECTORY = 40
.assert MSU_SURFACE_SLOT_BYTES = 1536 || MSU_SURFACE_SLOT_BYTES = 4096 || MSU_SURFACE_SLOT_BYTES = 8192, error, "Unsupported MSU surface page size"
MSU_SURFACE_LOOKUP_OFFSET = $8800
MSU_SURFACE_TAG_BASE = $77C0
MSU_SURFACE_TAG_BYTES = 8
MSU_SURFACE_READY = MSU_SURFACE_TAG_BASE + MSU_SURFACE_SLOT_COUNT * MSU_SURFACE_TAG_BYTES
MSU_SURFACE_INDEX = $7800       ; low byte of face ID -> tag offset + 1
MSU_SURFACE_COLLISION = $FF

MSU_SURFACE_TAGS = $710000 + MSU_SURFACE_TAG_BASE
MSU_SURFACE_INDEX_CPU = $710000 + MSU_SURFACE_INDEX
