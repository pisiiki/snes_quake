; Transform signed Q2 world coordinates already resident in R1/R2/R3. Keep
; this cache entry in the line immediately before the generic decoder: its
; 512-byte window contains the shared transform core without adding a branch
; to the much hotter packet-vertex entry.
ClipTransformQ2Registers:
        cache
        GSU_ABSOLUTE_GOTO ClipTransformQ2Coordinates

; Transform one raw compact packet vertex into signed Q6 view coordinates.
GSU_CACHE_KERNEL_BEGIN ClipTransformVertex
        lm      R0, (CLIP_VERTEX_INDEX)
        move    R1, R0
        with    R1
        add     R1
        with    R1
        add     R1
        iwt     R10, #VERTICES
        with    R10
        add     R1

        move    R0, #0
        moveb   R0, (R10)
        inc     R10
        with    R0
        sex
        move    R1, R0

        move    R0, #0
        moveb   R0, (R10)
        inc     R10
        with    R0
        sex
        move    R2, R0

        move    R0, #0
        moveb   R0, (R10)
        inc     R10
        with    R0
        sex
        move    R3, R0
        move    R7, #0
        moveb   R7, (R10)

; R1/R2/R3 are signed-byte bases; R7 holds their packed two-bit residuals.
; The depth-only brush adapter enters here without another packet load.
ClipTransformPackedQ2Coordinates:
        with    R1
        add     R1
        with    R1
        add     R1
        move    R0, R7
        with    R0
        and     #3
        with    R1
        add     R0
        with    R2
        add     R2
        with    R2
        add     R2
        move    R0, R7
  .repeat 2
        with    R0
        lsr
  .endrepeat
        with    R0
        and     #3
        with    R2
        add     R0
        with    R3
        add     R3
        with    R3
        add     R3
        move    R0, R7
  .repeat 4
        with    R0
        lsr
  .endrepeat
        with    R0
        and     #3
        with    R3
        add     R0

ClipTransformQ2Coordinates:
.if BSP_QUAKEC_GAMEPLAY
        lm      R0, (GSU_PLAYABLE_CAMERA_Q2_X)
.else
        lm      R0, (CAMERA_X)
        add     R0
        add     R0
.endif
        with    R1
        sub     R0
        sm      (DX), R1
.if BSP_QUAKEC_GAMEPLAY
        lm      R0, (GSU_PLAYABLE_CAMERA_Q2_Y)
.else
        lm      R0, (CAMERA_Y)
        add     R0
        add     R0
.endif
        with    R2
        sub     R0
        sm      (DY), R2
.if BSP_QUAKEC_GAMEPLAY
        lm      R0, (GSU_PLAYABLE_CAMERA_Q2_Z)
.else
        lm      R0, (CAMERA_Z)
        add     R0
        add     R0
.endif
        with    R3
        sub     R0
        sm      (DZ), R3

; The selector enters here with signed-word deltas, after its own subtraction.
; Never write the old return scratch: it aliases the selector's cached camera Y.
; R11 is the leaf return; R12 retains depth for the Fly brush classifier.
ClipTransformQ2Deltas:
    BSP_VIEW_DOT_RIGHT CLIP_RIGHT
    BSP_VIEW_DOT_AXIS3 GSU_VIEW_MATRIX_UX, GSU_VIEW_MATRIX_UY, GSU_VIEW_MATRIX_UZ, CLIP_UP
ClipTransformQ2DepthOnly:
    BSP_VIEW_DOT_AXIS3 GSU_VIEW_MATRIX_DX, GSU_VIEW_MATRIX_DY, GSU_VIEW_MATRIX_DZ, CLIP_DEPTH
    move R12,R0
    jmp R11
    nop
GSU_CACHE_KERNEL_END ClipTransformVertex
