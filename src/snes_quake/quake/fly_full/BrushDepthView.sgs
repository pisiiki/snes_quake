; Build exact QBSF view records for the Flat brush collector and Fly masks.
; Both consume geometry and Q6 depth. Zero S/T keeps the shared ten-byte
; record layout for clipping and projection.
; R13 retains the ROM bank and R9 the cursor across the shared RAM helpers.
.segment "GSU_TEXTURE_TAIL_CODE"

.if .defined(PLAYABLE_FLAT_BRUSH_MATERIAL) && (BSP_RENDER_SCALE = 2)
        .export FlyBrushBuildDepthView
.endif
FlyBrushBuildDepthView:
        sm      (BRUSH_VERTEX_RETURN), R11
        ; Resolve the first occurrence's bank/address once. Subsequent records
        ; advance R14 sequentially until its exact zero wrap selects a new bank.
        lm      R3, (BRUSH_FRAGMENT_FIRST_VERTEX_LO)
        to      R1
        from    R3
        hib
  .repeat 5
        with    R1
        lsr
  .endrepeat
        lm      R0, (BRUSH_FRAGMENT_FIRST_VERTEX_HI)
        with    R0
        and     #1
  .repeat 3
        with    R0
        add     R0
  .endrepeat
        with    R1
        add     R0
        iwt     R2, #BSP_BRUSH_FRAGMENT_VERTICES_FIRST_BANK
        with    R1
        add     R2
        move    R13, R1
        move    R0, R13
        romb

        iwt     R5, #$1FFF
        with    R3
        and     R5
        with    R3
        add     R3
        with    R3
        add     R3
        iwt     R4, #BSP_BRUSH_FRAGMENT_VERTICES_ROM_ADDRESS
        with    R4
        add     R3
        GSU_SET_ROM_BUFFER_ADDRESS R4

        iwt     R9, #TEXTURE_VIEW_A
        iwt     R8, #$0F00
        lm      R10, (BRUSH_FRAGMENT_VERTEX_COUNT)
        sm      (CONVEX_OUTPUT_COUNT), R10
FlyBrushDepthVertexLoop:
        BSP_ROM_LOAD_WORD R4
        BSP_ROM_LOAD_WORD R7
        ; BSP_ROM_LOAD_WORD ends with INC R14, leaving Z set only at $0000.
        bne     FlyBrushDepthVertexAddressReady
        nop
        inc     R13
        move    R0, R13
        romb
        iwt     R0, #BSP_BRUSH_FRAGMENT_VERTICES_ROM_ADDRESS
        GSU_SET_ROM_BUFFER_ADDRESS R0
FlyBrushDepthVertexAddressReady:
.ifdef GSU_PLATFORM_HEIGHTS
        jal     BrushResolvePlatformVertex
        nop
.endif
        ; The shared cache unpacks the words and applies exact Q2 residuals.
        jal     ClipTransformPackedQ2Registers
        nop
        ; Reuse the transform's resident cache for classification and the
        ; identical ten-byte record, preserving R13/R14's stream state.
        jal     FlyBrushDepthClassifyStore
        nop

        dec     R10
        bne     FlyBrushDepthVertexLoop
        nop
        sm      (CONVEX_EDGE_COUNT), R10
        to      R0
        from    R8
        lob
        sm      (TEXTURE_CLIP_OUTCODE), R0
        to      R0
        from    R8
        hib
        sm      (TEXTURE_CLIP_AND_OUTCODE), R0
        sm      (CONVEX_OUTPUT_CURSOR), R9
        lm      R11, (BRUSH_VERTEX_RETURN)
        ret
        nop
        ; Preserve the following tail-overlay PCs and segment size.
        .res $D0 - (* - FlyBrushBuildDepthView)

.assert * - AliasInitializeAxis <= GSU_TEXTURE_TAIL_CODE_CAPACITY, error, "Fly brush depth view exceeds the texture-tail overlay"
