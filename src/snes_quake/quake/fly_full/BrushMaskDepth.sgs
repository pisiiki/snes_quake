; Finish one brush-mask sample in RAM, beside its existing Q12 helpers.
; R0 is the clamped screen numerator; return the exact perspective depth in
; R5. Combining the two helper calls avoids a ROM/RAM round trip per interior
; sample and keeps the final signed interpolation out of the ROM pixel loop.
; Preserve the trampoline's link across the nested calls in persistent mask
; state. The denominator-zero, unity and rounding rules are unchanged.
FlyBrushMaskDepth:
        sm      (FLY_MASK_DEPTH_RETURN), R11
        lm      R2, (BRUSH_ARBITER_SCREEN_DEN)
        moves   R2, R2
        bne     @DenominatorPresent
        nop
        move    R3, #0
        bra     @FactorReady
        nop
@DenominatorPresent:
        move    R4, R0
        with    R4
        sub     R2
        bmi     @Divide
        nop
        iwt     R3, #4096
        bra     @FactorReady
        nop
@Divide:
        ; Anchor the Q12 window in the real jump delay; keep the return NOP.
        link    #4
        GSU_ABSOLUTE_GOTO TextureDivideQ12Prepared, shared_delay
        cache
        nop
@FactorReady:
        ; The factor returns directly to its byte-identical cached finish.
        iwt     R11, #FlyBrushMaskDepthFinishCached
        GSU_ABSOLUTE_GOTO FlyMaskPerspectiveFactorQ12
; The caller has published the exact endpoint depths and denominator.
; Positive endpoints bound every clamped perspective depth. If both are
; strictly behind the alias, no pixel can change a mask bit/count/ceiling.
; R2 and the caller's R11 remain intact for the ordinary prepare tail call.
; The caller's MOVES R2 flags survive its branch/LINK/IWT/NOP call sequence.
; R0/R1/R3/R4 are scratch before the pixel's exact divide overwrites them.
; Zero/sentinel endpoints and unsigned-negative thresholds fall back; the
; caller already bypasses this helper for a zero denominator.
FlyBrushMaskPrepareRowDepth:
        bmi     @Prepare
        nop
        lm      R0, (TEXTURE_BASE_DEPTH)
        lm      R3, (TEXTURE_RIGHT_SHADE)
        to      R4
        from    R0
        or      R3
        bmi     @Prepare
        nop
        lm      R1, (FLY_MASK_DEPTH)
        from    R1
        sub     R0
        bcs     @Prepare
        from    R1
        sub     R3
        bcs     @Prepare
        nop
        ; Match the old rejected-row exit's inclusive cursor exactly.
        lm      R0, (FLY_MASK_LAST_X)
        sm      (FLY_MASK_X), R0
        GSU_ABSOLUTE_GOTO FlyBrushMaskNextRow
@Prepare:
        GSU_ABSOLUTE_GOTO TexturePrepareDivideQ12
FlyBrushMaskPrepareRowDepthEnd:
.assert * - FlyBrushMaskPrepareRowDepth <= $2C, error, "Mask row guard exceeds retired depth padding"
.assert * - FlyBrushMaskDepth <= $58, error, "Mask depth entry exceeds its pinned slot"
.res $58 - (* - FlyBrushMaskDepth), $01
