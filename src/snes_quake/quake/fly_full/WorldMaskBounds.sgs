; Bounds are cached only for the current frame. They reject disjoint polygons;
; the shared clipped Q7 spans remain the authority for every occluding pixel.
.macro FLY_WORLD_BOUNDS_ADDRESS
        lm      R0, (FLY_MASK_LINK)
        iwt     R1, #$7FFF
        with    R0
        and     R1
  .repeat 2
        with    R0
        add     R0
  .endrepeat
        iwt     R10, #FLY_MASK_BOUNDS
        with    R10
        add     R0
.endmacro

FlyWorldMaskCheckBounds:
        ; Cached bounds reject most world links without calling projection.
        ; Keep this complete leaf path resident across those repeated checks.
        cache
        FLY_WORLD_BOUNDS_ADDRESS
        movew   R0, (R10)
        iwt     R1, #$FFFF
        with    R0
        cmp     R1
        bne     FlyWorldBoundsCached
        nop
        GSU_ABSOLUTE_GOTO FlyWorldMaskCoarseBounds
FlyWorldBoundsCached:
        moveb   R0, (R10)
        lm      R1, (FLY_MASK_RECT_LAST_X)
        with    R1
        cmp     R0
        FLY_SIGNED_BRANCH $07, FlyWorldBoundsMiss
        nop
        inc     R10
        moveb   R0, (R10)
        lm      R1, (FLY_MASK_RECT_FIRST_X)
        with    R0
        cmp     R1
        FLY_SIGNED_BRANCH $07, FlyWorldBoundsMiss
        nop
        inc     R10
        moveb   R0, (R10)
        lm      R1, (FLY_MASK_RECT_LAST_Y)
        with    R1
        cmp     R0
        FLY_SIGNED_BRANCH $07, FlyWorldBoundsMiss
        nop
        inc     R10
        moveb   R0, (R10)
        lm      R1, (FLY_MASK_FIRST_Y)
        with    R0
        cmp     R1
        FLY_SIGNED_BRANCH $07, FlyWorldBoundsMiss
        nop
FlyWorldBoundsOverlap:
        move    R0, #1
        ret
        nop
FlyWorldBoundsMiss:
        move    R0, #0
        ret
        nop
        ; LDB zero-extends the full register. Its four former LOBs are dead
        ; before CMP; absorb their size only after the leaf's final return.
.ifdef PLAYABLE_BRUSH_PROJECTED_X_BOUNDS
        ; An empty horizontal polygon cannot mask the alias at any depth.
        ; Both destinations are ordinary continuations of the mask driver.
BrushStoreAliasProjectedBounds:
        jal     BrushArbiterStoreCurrent
        nop
        moves   R8, R8
        beq     BrushMaskPolygonEmpty
        nop
        GSU_ABSOLUTE_GOTO FlyBrushMaskRow
BrushMaskPolygonEmpty:
        GSU_ABSOLUTE_GOTO FlyBrushMaskNextPolygon
.endif
.assert * - FlyWorldMaskCheckBounds <= $75, error, "World bounds leaf exceeds its pinned slot"
        .res $75 - (* - FlyWorldMaskCheckBounds), $01
.assert .loword(*) <= (.loword(FlyWorldMaskCheckBounds + 1) & $FFF0) + GSU_CACHE_BYTES, lderror, "World bounds leaf leaves its entry cache"
.assert .bankbyte(*-1) = .bankbyte(FlyWorldMaskCheckBounds), lderror, "World bounds leaf crosses its code bank"

; Keep the descending scan and rejection backedge in the bounds cache.
; Scan the world's descending links without a ROM round trip per bounds test
; or preparation step. Nested projection/raster calls own their scratch links;
; the persistent ROM callback is restored by the existing bank trampoline.
FlyWorldMaskScan:
        ; Reverse painter ownership is complete; proceed to the brush pass.
        lm      R0, (FLY_MASK_WORLD_REMAINING)
        moves   R0, R0
        beq     FlyWorldMaskScanExhausted
        nop
        lm      R0, (FLY_MASK_LINK)
        iwt     R1, #$7FFF
        with    R0
        cmp     R1
        beq     FlyWorldMaskScanExhausted
        nop
        jal     FlyWorldMaskCheckBounds
        nop
        moves   R0, R0
        beq     FlyWorldMaskScanAdvance
        nop
        jal     FlyWorldBuildDepthView
        nop
        jal     BrushArbiterProjectCurrent
FlyWorldMaskCurrentProjected:
        nop
        ; Store even empty projections: their inverted bounds reject later
        ; aliases without repeating the same projection work.
        jal     FlyWorldMaskRasterize
        nop
        moves   R0, R0
        bne     FlyWorldMaskScanReturn
        nop
FlyWorldMaskScanAdvance:
        lm      R0, (FLY_MASK_LINK)
        dec     R0
        sm      (FLY_MASK_LINK), R0
        GSU_ABSOLUTE_GOTO FlyWorldMaskScan
FlyWorldMaskScanExhausted:
        move    R0, #0
FlyWorldMaskScanReturn:
        GSU_ABSOLUTE_GOTO FlyBrushMaskCallROMReturn

FlyWorldMaskScanEnd:
.assert FlyWorldMaskScanEnd - FlyWorldMaskScan = $4B, error, "World scan footprint changed"
.assert .bankbyte(FlyWorldMaskScan) = .bankbyte(FlyWorldMaskCheckBounds), lderror, "World scan left bounds bank"
.assert .loword(FlyWorldMaskScanEnd) <= (.loword(FlyWorldMaskCheckBounds + 1) & $FFF0) + GSU_CACHE_BYTES, lderror, "World scan left bounds cache"
