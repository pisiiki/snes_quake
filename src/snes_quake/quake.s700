; SPC driver and samples for playable Quake.

.include "libSFX.i"
.include "Data/QuakeBSPSoundtrack.i"
.include "Data/QuakeBSPBrushAssets.i"

.ifdef BSP_QUAKEC_GAMEPLAY
.export ShotgunSoundDriver
.include "quake/GameplayAuxSound.i"
.include "Data/QuakeBSPLiftLoop.i"
.include "Data/QuakeBSPDogAudio.i"
.export ShotgunBrr, QuakeMapAudio
BODY_TOKEN = $00                  ; Scratch after the IPL upload completes.
.segment "SMPCODE"
.align 256
ShotgunDirectory:
        .word   ShotgunBrr, ShotgunBrr
        .word   ShellPickupBrr, ShellPickupBrr
        .repeat 6, I
        .word .ident(.sprintf("GruntBrr%d", I)), .ident(.sprintf("GruntBrr%d", I))
        .endrepeat
        .word   AxeSwingBrr, AxeSwingBrr
        .word   AxeWallBrr, AxeWallBrr
        .word   TalkBrr, TalkBrr
        .word   QuakeMapAudio, QuakeMapAudio
        .word   SecretBrr, SecretBrr
        .word   JumpBrr, JumpBrr
        .word   Swim1Brr, Swim1Brr
        .word   Swim2Brr, Swim2Brr
        .word   LiftButtonBrr, LiftButtonBrr
        .word   LiftMoveBrr, LiftMoveBrr+QC_LIFT_LOOP_BYTE
        .word   LiftStopBrr, LiftStopBrr
        .word   Gasp1Brr, Gasp1Brr
        .word   Gasp2Brr, Gasp2Brr
        .word   HealthSmallBrr, HealthSmallBrr
        .word   HealthLargeBrr, HealthLargeBrr
        .word   LandBrr, LandBrr
        .word   LandHardBrr, LandHardBrr
        .word   LandWaterBrr, LandWaterBrr
.assert (*-ShotgunDirectory)/4 = GAMEPLAY_DOG_SAMPLE_FIRST, error, "Dog sample directory index changed"
        .repeat 5, I
        .word QuakeMapAudio+.ident(.sprintf("QC_DOG_AUDIO_OFFSET_%d", I))
        .word QuakeMapAudio+.ident(.sprintf("QC_DOG_AUDIO_OFFSET_%d", I))
        .endrepeat
.assert (*-ShotgunDirectory)/4 = GAMEPLAY_KNIGHT_SAMPLE_FIRST, error, "Knight sample directory index changed"
        .repeat 6, I
        .word QuakeMapAudio+.ident(.sprintf("QC_KNIGHT_AUDIO_OFFSET_%d", I))
        .word QuakeMapAudio+.ident(.sprintf("QC_KNIGHT_AUDIO_OFFSET_%d", I))
        .endrepeat
.ifdef QC_ARMOR_AUDIO_OFFSET
.assert (*-ShotgunDirectory)/4 = GAMEPLAY_ARMOR_SAMPLE, error, "armor sound index changed"
        .word QuakeMapAudio+QC_ARMOR_AUDIO_OFFSET, QuakeMapAudio+QC_ARMOR_AUDIO_OFFSET
.endif
.ifdef QC_MEGA_AUDIO_OFFSET
.assert (*-ShotgunDirectory)/4 = GAMEPLAY_MEGA_SAMPLE, error, "Megahealth sound index changed"
        .word QuakeMapAudio+QC_MEGA_AUDIO_OFFSET, QuakeMapAudio+QC_MEGA_AUDIO_OFFSET
.endif
.ifdef QC_PLATFORM_AUDIO_0
.assert (*-ShotgunDirectory)/4 = GAMEPLAY_PLAT_MOVE, error, "Platform sample directory index changed"
        .repeat 4, I
        .word QuakeMapAudio+.ident(.sprintf("QC_PLATFORM_AUDIO_%d", I))
        .word QuakeMapAudio+.ident(.sprintf("QC_PLATFORM_LOOP_%d", I))
        .endrepeat
.endif
.ifdef QC_QUAD_ATTACK_AUDIO
.assert (*-ShotgunDirectory)/4 = GAMEPLAY_QUAD_ATTACK_SAMPLE, error, "Quad attack sound index changed"
        .word QuakeMapAudio+QC_QUAD_ATTACK_AUDIO, QuakeMapAudio+QC_QUAD_ATTACK_AUDIO
.endif
.ifdef QC_GIB_AUDIO
.assert (*-ShotgunDirectory)/4 = GAMEPLAY_GIB_SAMPLE, error, "Gib sound directory index changed"
        .word QuakeMapAudio+QC_GIB_AUDIO, QuakeMapAudio+QC_GIB_AUDIO
.endif
.assert (*-ShotgunDirectory)/4 = GAMEPLAY_NAIL_FIRE, error, "Nail sound directory changed"
        .repeat 6, I
        .word ShotgunBrr+.ident(.sprintf("QC_NAIL_AUDIO_OFFSET_%d", I))
        .word ShotgunBrr+.ident(.sprintf("QC_NAIL_AUDIO_OFFSET_%d", I))
        .endrepeat
        .word ShotgunBrr+QC_NAIL_AUDIO_OFFSET_0, ShotgunBrr+QC_NAIL_AUDIO_OFFSET_0
        IndustrialDirectory = (*-ShotgunDirectory)/4
        .assert IndustrialDirectory = GAMEPLAY_INDUSTRIAL_SRCN, error, "Industrial sample IDs changed"
        .word IndustrialCompBrr, IndustrialCompBrr, IndustrialDroneBrr, IndustrialDroneBrr
        .word IndustrialLightBrr, IndustrialLightBrr, IndustrialSparkBrr, IndustrialSparkBrr
        IndustrialCompBrr = ShellPickupBrr + INDUSTRIAL_FOREGROUND_CAPACITY
        IndustrialSparkBrr = IndustrialCompBrr + 6372
        IndustrialLightBrr = JumpBrr
        IndustrialDroneBrr = LandBrr + INDUSTRIAL_FOREGROUND_CAPACITY
        .export IndustrialCompBrr, IndustrialDroneBrr, IndustrialLightBrr, IndustrialSparkBrr
        .export ShotgunDirectory, ShellPickupBrr, LandBrr, JumpBrr, SecretBrr, LiftButtonBrr
        .repeat 6, I
        .export .ident(.sprintf("GruntBrr%d", I))
        .endrepeat
        .export AxeSwingBrr, AxeWallBrr, TalkBrr, Swim1Brr, Swim2Brr, LandHardBrr, LandWaterBrr
        industrial_mode = $04
        transfer_ptr = $05
        transfer_count = $07
        transfer_mask = $09
        industrial_regs = $0a         ; voice, source, pitch lo/hi, left/right
        weapon_ptr = $02
        weapon_data = ShotgunBrr+QC_NAIL_AUDIO_OFFSET_0
ShotgunDspRegisters:
        .byte FLG,KON,KOF,DIR,NON,EON,PMON,MVOLL,MVOLR
ShotgunDspValues:
        .byte $20,0,$ff,>ShotgunDirectory,0,0,0,$7f,$7f
ShotgunVoiceDefaults:
        .byte 0,0,0,4,0,$50,$50       ; Reverse index 6..1: L/R, pitch, SRCN and ADSR1.
ShotgunSoundDriver:
        mov     x,#0
@GlobalDefaults:
        mov     a,!ShotgunDspRegisters+x
        mov     DSPADDR,a
        mov     a,!ShotgunDspValues+x
        mov     DSPDATA,a
        inc     x
        cmp     x,#9
        bne     @GlobalDefaults
        mov     x,#0
@VoiceDefaults:
        mov     y,#6
@VoiceRegister:
        mov     DSPADDR,x
        mov     a,!ShotgunVoiceDefaults+y
        mov     DSPDATA,a
        inc     x
        dbnz    y,@VoiceRegister
        inc     x                      ; ADSR2 is unused in direct gain mode.
        mov     DSPADDR,x
        mov     DSPDATA,#$7f
        mov     a,x
        clrc
        adc     a,#9
        mov     x,a
        bpl     @VoiceDefaults
        DSP_set V1SRCN, #11
        DSP_set V3SRCN, #16
        DSP_set V7PITCHH,#1
        mov     industrial_mode,#0
        DSP_set KOF,    #$00
        mov     y,CPUIO3
        mov     CPUIO3,y
        mov     x,CPUIO1
        mov     CPUIO1,x
        mov     a,CPUIO0
        mov     BODY_TOKEN,a
        mov     CPUIO2,a
        mov     CPUIO0,#$a5
IndustrialGameplayWait:
@Wait:
        cmp     y,CPUIO3
        beq     :+
        jmp     !@Gameplay
:
        cmp     x,CPUIO1
        bne     @Aux
        mov     a,CPUIO0
        cmp     a,BODY_TOKEN
        beq     @Wait
        mov     BODY_TOKEN,a
        mov     CPUIO2,a
        cmp     a,#GAMEPLAY_BODY_LAND
        bcs     @Landing
        DSP_set V2PITCHH,#$04
        .repeat 6
        lsr     a
        .endrepeat
        clrc
        adc     a,#13
        bra     @BodySample
@Landing:
        DSP_set V2PITCHH,#$02
        .repeat 4
        lsr     a
        .endrepeat
        clrc
        adc     a,#11                 ; Body selectors $C–$E map to 23–25.
@BodySample:
        mov     DSPADDR,#V2SRCN
        mov     DSPDATA,a
        mov     a,#$04
        jmp     !@KeyOn
@Aux:
        mov     x,CPUIO1
        mov     CPUIO1,x
        mov     a,x
        and     a,#GAMEPLAY_AUX_SELECTOR
        cmp     a,#GAMEPLAY_AUX_BUTTON
        beq     @Button
        cmp     a,#GAMEPLAY_AUX_LIFT_RUN
        beq     @LiftMove
        cmp     a,#GAMEPLAY_AUX_LIFT_END
        beq     @LiftStop
        cmp     a,#GAMEPLAY_AUX_LIFT_OFF
        beq     @LiftOff
        cmp     a,#GAMEPLAY_AUX_SECRET
        beq     @Secret
        cmp     a,#GAMEPLAY_AUX_GASP_LOW
        beq     @GaspLow
        cmp     a,#GAMEPLAY_AUX_GASP_EMPTY
        beq     @GaspEmpty
        DSP_set V1SRCN, #11
        DSP_set V1PITCHH,#$04           ; Arrival at 8 kHz.
        bra     @StartAux
@Secret:
        DSP_set V1SRCN, #12
        DSP_set V1PITCHH,#$03           ; Secret at 6 kHz.
@StartAux:
        mov     a,#$02
        jmp     !@KeyOn
@Button:
        DSP_set V3SRCN, #16
        DSP_set V3PITCHH,#$04
        mov     a,#$08
        jmp     !@KeyOn
@LiftMove:
        DSP_set V4SRCN, #17
        bra     @StartLift
@LiftStop:
        DSP_set V4SRCN, #18
@StartLift:
        DSP_set V4PITCHH,#$03           ; Both powered lift samples retain their stock timing at 6 kHz.
        mov     a,#$10
        jmp     !@KeyOn
@LiftOff:
        DSP_set KOF, #$18
@KeyOffLatch:
        mov     a,#16
@LiftRelease:
        dec     a
        bne     @LiftRelease
        DSP_set KOF, #$00
        jmp     !@Wait
@GaspLow:
        DSP_set V5SRCN, #19
        bra     @StartGasp
@GaspEmpty:
        DSP_set V5SRCN, #20
@StartGasp:
        DSP_set V5PITCHH,#$02            ; 4 kHz stock gasp samples.
        mov     a,#$20
        bra     @KeyOn
@Gameplay:
        mov     y,CPUIO3
        mov     a,CPUIO2
        cmp     a,#GAMEPLAY_STOP_NAIL
        bne     :+
        jmp     !@StopNail
:
        cmp     a,#GAMEPLAY_TRANSFER_SAMPLE
        bne     :+
        jmp     !@TransferSample
:       cmp     a,#GAMEPLAY_INDUSTRIAL_GAIN
        bne     :+
        jmp     !@IndustrialGain
:
        cmp     a,#GAMEPLAY_STREAM_WEAPON
        bne     :+
        jmp     !@WeaponTransfer
:       cmp     a,#GAMEPLAY_SAMPLE_IPL
        beq     @ReloadSamples
        cmp     a,#GAMEPLAY_DOG_SAMPLE_FIRST
        bcc     :+
        jmp     !@MapSound
:
        cmp     a,#21
        bcc     @Weapon
        ; Item cues use a separate voice so a shot does not cut them off.
        mov     DSPADDR,#V6SRCN
        mov     DSPDATA,a
        cmp     a,#23
        bcs     @FullItemRate
        DSP_set V6PITCHH,#$02           ; Both regular health cues have 4 kHz BRR fallbacks.
        bra     @ItemReady
@FullItemRate:
        DSP_set V6PITCHH,#$04
@ItemReady:
        mov     CPUIO3,y
        mov     a,#$40
        bra     @KeyOn
@Weapon:
        mov     DSPADDR,#V0SRCN
        mov     DSPDATA,a
        cmp     a,#$02
        bcc     @FullRate
        cmp     a,#$08
        bcs     @FullRate
        DSP_set V0PITCHH,#$02           ; Grunt samples are stored at 4 kHz.
        bra     @StartSample
@FullRate:
        DSP_set V0PITCHH,#$04
@StartSample:
        mov     CPUIO3,y
        mov     a,#$01
@KeyOn:
        push    a
        mov     a,industrial_mode
        beq     @DefaultsReady
        pop     a
        push    a
        push    x
        mov     x,#0
@VoiceIndex:
        lsr     a
        bcs     @ForegroundVolume
        push    a
        mov     a,x
        clrc
        adc     a,#$10
        mov     x,a
        pop     a
        bra     @VoiceIndex
@ForegroundVolume:
        mov     DSPADDR,x
        mov     DSPDATA,#$50
        inc     x
        mov     DSPADDR,x
        mov     DSPDATA,#$50
        inc     x
        mov     DSPADDR,x
        mov     DSPDATA,#0
        pop     x
@DefaultsReady:
        pop     a
        DSP_set KON,    a
        ; KON is latched every other DSP sample. Let this request reach
        ; the DSP before a request on the other port can replace it.
        mov     a,#16
@Latch:
        dec     a
        bne     @Latch
        jmp     !@Wait
@ReloadSamples:
        DSP_set KOF,    #$ff
        DSP_set FLG,    #$e0
        mov     CONTROL,#$b0           ; Clear port tokens before IPL polls for $CC.
        SMP_exit
@MapSound:
.ifdef QC_GIB_AUDIO
        cmp     a,#GAMEPLAY_GIB_SAMPLE
        bne     :+
        DSP_set V5SRCN, #GAMEPLAY_GIB_SAMPLE
        DSP_set V5PITCHH,#$01           ; Preserve gory death under subsequent monster calls.
        mov     CPUIO3,y
        mov     a,#$20
        jmp     !@KeyOn
:
.endif
        cmp     a,#GAMEPLAY_NAIL_FIRE
        bcc     @MapActor
        cmp     a,#GAMEPLAY_NAIL_SHOTGUN_FALLBACK
        bne     :+
        mov     a,#0
        bra     @NailWeapon
:       cmp     a,#GAMEPLAY_SSG_FIRE
        beq     @NailWeapon
        cmp     a,#GAMEPLAY_NAIL_FIRE
        beq     @NailWeapon
        cmp     a,#GAMEPLAY_WEAPON_PICKUP
        beq     @LowRateItem
        mov     DSPADDR,#V1SRCN
        mov     DSPDATA,a
        DSP_set V1PITCHH,#$02           ; Impact cues use 4 kHz BRR.
        mov     a,#$02
        bra     @NailStart
@LowRateItem:
        mov     DSPADDR,#V6SRCN
        mov     DSPDATA,a
        DSP_set V6PITCHH,#$01
        mov     a,#$40
        bra     @NailStart
@NailWeapon:
        mov     DSPADDR,#V0SRCN
        mov     DSPDATA,a
        DSP_set V0PITCHH,#$01
        mov     a,#$01
@NailStart:
        mov     CPUIO3,y
        jmp     !@KeyOn
@MapActor:
        cmp     a,#GAMEPLAY_ARMOR_SAMPLE
        beq     @LowRateItem
.ifdef QC_PLATFORM_AUDIO_0
        cmp     a,#GAMEPLAY_SECRET_DOOR_STOP+1
        bcs     @Creature
        cmp     a,#GAMEPLAY_PLAT_MOVE
        bcc     @Creature
        mov     DSPADDR,#V4SRCN
        mov     DSPDATA,a
        DSP_set V4PITCHH,#$01           ; Stock plat motor shares the lift voice.
        mov     CPUIO3,y
        mov     a,#$10
        jmp     !@KeyOn
@Creature:
.endif
        mov     DSPADDR,#V7SRCN
        mov     DSPDATA,a
        mov     CPUIO3,y
        mov     a,#$80
        jmp     !@KeyOn
@StopNail:
        mov     CPUIO3,y
        mov     DSPADDR,#V0SRCN
        mov     a,DSPDATA
        cmp     a,#GAMEPLAY_NAIL_FIRE
        bne     :+
        DSP_set KOF,#$01
        jmp     !@KeyOffLatch
:       jmp     !@Wait
; Port 2 carries one byte per port-3 token. Ports 0 and 1 retain pending
; body and auxiliary events. Only the weapon voice is released during a swap.
@WeaponTransfer:
        mov     weapon_ptr,#<weapon_data
        mov     weapon_ptr+1,#>weapon_data
        push    x
        DSP_set KOF,#$01
        mov     x,CPUIO3
        mov     CPUIO3,x
        mov     y,#0
@NextByte:
        cmp     x,CPUIO3
        beq     @NextByte
        mov     x,CPUIO3
        mov     a,CPUIO2
        mov     [weapon_ptr]+y,a
        inc     y
        bne     :+
        inc     weapon_ptr+1
:       mov     CPUIO3,x
        cmp     y,#<QC_WEAPON_SLOT_BYTES
        bne     @NextByte
        mov     a,weapon_ptr+1
        cmp     a,#(>weapon_data)+(QC_WEAPON_SLOT_BYTES/$100)
        bne     @NextByte
        mov     a,x
        mov     y,a
        pop     x
        DSP_set KOF,#$00
        jmp     !@Wait
        .include "quake/IndustrialSound.s700"
        .res    2,0                    ; Preserve the shared sample addresses and ROM extent.
ShellPickupBrr:
        .incbin "Data/QuakeBSPShellPickup.brr"
        .repeat 6, I
.ident(.sprintf("GruntBrr%d", I)):
        .incbin .sprintf("Data/QuakeBSPGruntSound%d.brr", I)
        .endrepeat
AxeSwingBrr:
        .incbin "Data/QuakeBSPAxeSwing.brr"
AxeWallBrr:
        .incbin "Data/QuakeBSPAxeWall.brr"
TalkBrr:
        .incbin "Data/QuakeBSPTalk.brr"
.macro QUAKE_INITIAL_MAP_AUDIO
ShotgunBrr:
        .incbin "Data/QuakeBSPShotgun.brr"
.assert *-ShotgunBrr = QC_STOCK_SHOT_BYTES, error, "Starting shotgun size changed"
        .res QC_WEAPON_AUDIO_BYTES-QC_STOCK_SHOT_BYTES, 0
QuakeMapAudio:
        .incbin "Data/QuakeBSPTeleportArrival.brr"
.assert *-QuakeMapAudio = QC_ARRIVAL_AUDIO_BYTES, error, "Teleport sample size changed"
.endmacro
SecretBrr:
        .incbin "Data/QuakeBSPSecret.brr"
JumpBrr:
        .incbin "Data/QuakeBSPJump.brr"
Swim1Brr:
        .incbin "Data/QuakeBSPSwim1.brr"
Swim2Brr:
        .incbin "Data/QuakeBSPSwim2.brr"
LiftButtonBrr:
        .incbin "Data/QuakeBSPLiftButton.brr"
LiftMoveBrr:
        .incbin "Data/QuakeBSPLiftMove.brr"
LiftStopBrr:
        .incbin "Data/QuakeBSPLiftStop.brr"
Gasp1Brr:
        .incbin "Data/QuakeBSPGasp1.brr"
Gasp2Brr:
        .incbin "Data/QuakeBSPGasp2.brr"
HealthSmallBrr:
        .incbin "Data/QuakeBSPHealthSmall.brr"
HealthLargeBrr:
        .incbin "Data/QuakeBSPHealthLarge.brr"
LandBrr:
        .incbin "Data/QuakeBSPLand.brr"
LandHardBrr:
        .incbin "Data/QuakeBSPLandHard.brr"
LandWaterBrr:
        .incbin "Data/QuakeBSPLandWater.brr"
        ; Warm map uploads can extend into free ARAM beyond the cold image.
        QUAKE_INITIAL_MAP_AUDIO
        .assert QuakeMapAudio + QC_MAP_AUDIO_BYTES <= $ffc0, lderror, "Map sound overlay overlaps SPC IPL"
.endif
